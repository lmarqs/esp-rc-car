#!/usr/bin/env python3
#MISE description="Build and run the tests of the drivers in lib/ on this machine"
"""Each test/test_*.cpp is one program, linked with the lib/ sources behind the headers it includes."""

import os
import re
import subprocess
import sys
from pathlib import Path

BUILD = Path(".build/test")
LIB = Path("lib")
INCLUDE = re.compile(r'^\s*#include\s+["<]([^">]+)[">]', re.MULTILINE)


def sources(test: Path) -> list[Path]:
    found: dict[Path, None] = {}
    pending = [test]
    seen = set()
    while pending:
        file = pending.pop()
        if file in seen:
            continue
        seen.add(file)
        for name in INCLUDE.findall(file.read_text()):
            header = LIB / name
            if not header.is_file():
                continue
            pending.append(header)
            source = header.with_suffix(".cpp")
            if source.is_file():
                found[source] = None
                pending.append(source)
    return list(found)


def main() -> int:
    cxx = os.environ.get("CXX", "g++")

    failed = 0
    for test in sorted(Path("test").glob("test_*.cpp")):
        binary = BUILD / test.stem
        binary.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(
            [cxx, "-std=gnu++17", "-Wall", "-Itest", f"-I{LIB}", str(test)]
            + [str(s) for s in sources(test)]
            + ["-o", str(binary)],
            check=True,
        )
        print(f"== {test}", flush=True)
        failed += subprocess.run([str(binary)]).returncode != 0
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
