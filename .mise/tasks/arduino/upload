#!/usr/bin/env bash
#MISE description="Upload a compiled sketch to the board"
#USAGE arg "<sketch>" help="Sketch folder"
#USAGE flag "-p --port <port>" env="PORT" help="Serial port of the board"
set -euo pipefail

# A board that uploads over its own USB bootloader, such as the Digispark, has no serial port.
arduino-cli upload "${usage_sketch}" --input-dir ".build/${usage_sketch}" ${usage_port:+--port "${usage_port}"}
