<div class="playground blink">
  <div class="label">Try it</div>
  <div class="row">
    <svg viewBox="0 0 220 150" role="img" aria-label="An LED on GPIO 2">
      <circle cx="110" cy="70" r="56" fill="#d9f0e4"></circle>
      <g class="rays" stroke="#2e9e6b" stroke-width="2.6" stroke-linecap="round">
        <path d="M110 10 v-8 M150 24 l7 -7 M70 24 l-7 -7 M166 62 h9 M54 62 h-9"></path>
      </g>
      <path class="bulb ink" d="M88 66 a22 22 0 0 1 44 0 v22 h-44 Z"></path>
      <path class="thin" stroke="#fff" d="M98 62 a12 12 0 0 1 10 -10"></path>
      <rect x="82" y="88" width="56" height="9" rx="3" fill="#fff" class="ink"></rect>
      <path class="ink" fill="none" d="M100 97 v34 M120 97 v26"></path>
      <text x="138" y="140" font-size="12" font-family="ui-monospace, monospace" fill="#48596a">GPIO 2</text>
    </svg>
    <pre class="serial" aria-live="off" aria-label="Serial monitor at 9600 baud"></pre>
  </div>
  <div class="controls">
    <button class="btn ghost" type="button" data-toggle>Pause</button>
    <label>delay(<output data-out>1000</output>) <input type="range" min="100" max="2000" step="100" value="1000" data-delay /></label>
  </div>
</div>

<style>
  .row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 18px; align-items: center; }
  @media (max-width: 600px) { .row { grid-template-columns: 1fr; } }
  svg { width: 100%; max-height: 180px; }
  .bulb { fill: #cfe7da; transition: fill .08s; }
  .rays { opacity: 0; transition: opacity .08s; }
  .on .bulb { fill: #2e9e6b; }
  .on .rays { opacity: 1; }
  .serial { height: 150px; margin: 0; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.blink')) {
    const svg = root.querySelector('svg')!;
    const serial = root.querySelector('.serial')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const delay = root.querySelector<HTMLInputElement>('[data-delay]')!;
    const out = root.querySelector('[data-out]')!;
    let on = false;
    let timer = 0;
    const lines: string[] = [];

    function tick() {
      on = !on;
      svg.classList.toggle('on', on);
      lines.push(on ? 'HIGH' : 'LOW');
      if (lines.length > 7) lines.shift();
      serial.textContent = lines.join('\n');
      timer = window.setTimeout(tick, Number(delay.value));
    }
    toggle.addEventListener('click', () => {
      if (timer) { clearTimeout(timer); timer = 0; toggle.textContent = 'Run'; }
      else { toggle.textContent = 'Pause'; tick(); }
    });
    delay.addEventListener('input', () => { out.textContent = delay.value; });
    tick();
  }
</script>
