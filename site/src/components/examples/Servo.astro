<div class="playground servo">
  <div class="label">Try it</div>
  <div class="row">
    <svg viewBox="0 0 240 170" role="img" aria-label="A hobby servo with its horn at the chosen angle">
      <circle cx="120" cy="96" r="66" fill="#dbe8f5"></circle>
      <path class="thin" d="M50 96 a70 70 0 0 1 140 0" stroke-dasharray="3 6"></path>
      <text x="40" y="112" font-size="11" fill="#48596a" font-family="ui-monospace, monospace">180°</text>
      <text x="186" y="112" font-size="11" fill="#48596a" font-family="ui-monospace, monospace">0°</text>
      <rect x="72" y="96" width="96" height="58" rx="8" fill="#3b82c4" class="ink"></rect>
      <rect x="60" y="112" width="120" height="10" rx="3" fill="#3b82c4" class="ink"></rect>
      <g class="horn" transform="rotate(0 120 96)">
        <path d="M120 88 L178 92 a4 4 0 0 1 0 8 L120 104 Z" fill="#fff" class="ink"></path>
        <circle cx="120" cy="96" r="13" fill="#fff" class="ink"></circle>
        <circle cx="120" cy="96" r="4" fill="#1f2d3a"></circle>
      </g>
    </svg>
    <div>
      <svg class="wave" viewBox="0 0 260 90" aria-hidden="true">
        <path class="thin" d="M10 74 H250" stroke="#c9d3da"></path>
        <path class="pulse" fill="none" stroke="#e2603a" stroke-width="2.6" stroke-linejoin="round"></path>
      </svg>
      <div class="readout" aria-live="polite"></div>
    </div>
  </div>
  <div class="controls">
    <button class="btn ghost" type="button" data-sweep>Stop sweep</button>
    <label>Angle <input type="range" min="0" max="180" value="0" data-angle /></label>
  </div>
</div>

<style>
  .row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; align-items: center; }
  @media (max-width: 600px) { .row { grid-template-columns: 1fr; } }
  svg { width: 100%; max-height: 200px; }
</style>

<script>
  // The sketch's PositionalServo maps 0°–180° onto 544–2400 µs with Arduino's integer map().
  const MIN_US = 544;
  const MAX_US = 2400;
  const PERIOD_US = 20000;
  const pulseUs = (angle: number) => Math.trunc((angle * (MAX_US - MIN_US)) / 180) + MIN_US;

  for (const root of document.querySelectorAll<HTMLElement>('.servo')) {
    const horn = root.querySelector('.horn')!;
    const pulse = root.querySelector('.pulse')!;
    const readout = root.querySelector('.readout')!;
    const angleInput = root.querySelector<HTMLInputElement>('[data-angle]')!;
    const sweepBtn = root.querySelector<HTMLButtonElement>('[data-sweep]')!;
    let angle = 0;
    let step = 1;
    let timer = 0;

    function draw() {
      // The horn points right at 0° and left at 180°, sweeping over the top.
      horn.setAttribute('transform', `rotate(${-angle} 120 96)`);
      const us = pulseUs(angle);
      const w = (us / PERIOD_US) * 240 * 4;
      let d = 'M10 74';
      for (let x = 10; x < 250; x += 60) d += ` H${x} V20 H${Math.min(x + w / 4, 250)} V74`;
      pulse.setAttribute('d', d + ' H250');
      angleInput.value = String(angle);
      readout.textContent = `servo.write(${angle})  →  ${us} µs pulse every 20 ms`;
    }
    function sweep() {
      angle += step;
      if (angle >= 180 || angle <= 0) step = -step;
      draw();
      timer = window.setTimeout(sweep, 15);
    }
    function stop() { clearTimeout(timer); timer = 0; sweepBtn.textContent = 'Sweep'; }
    sweepBtn.addEventListener('click', () => {
      if (timer) stop();
      else { sweepBtn.textContent = 'Stop sweep'; sweep(); }
    });
    angleInput.addEventListener('input', () => { stop(); angle = Number(angleInput.value); draw(); });
    draw();
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) stop(); else sweep();
  }
</script>
