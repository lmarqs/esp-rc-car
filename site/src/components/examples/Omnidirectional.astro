<div class="playground omni">
  <div class="label">Try it: drag both sticks</div>
  <div class="row">
    <div class="sticks">
      <figure><div class="stick" data-stick="rotation" aria-label="Left stick: rotation"><div class="dz"></div><div class="knob"></div></div><figcaption>Left stick</figcaption></figure>
      <figure><div class="stick" data-stick="translation" aria-label="Right stick: translation"><div class="dz"></div><div class="knob"></div></div><figcaption>Right stick</figcaption></figure>
    </div>
    <div class="bars" aria-live="polite">
      <div class="bar"><span>Motor 1</span><div class="track"><i></i></div><code></code></div>
      <div class="bar"><span>Motor 2</span><div class="track"><i></i></div><code></code></div>
      <div class="bar"><span>Motor 3</span><div class="track"><i></i></div><code></code></div>
      <div class="bar"><span>Motor 4</span><div class="track"><i></i></div><code></code></div>
    </div>
  </div>
  <div class="controls">
    <button type="button" class="btn ghost" data-quiet>Go quiet for 1 s</button>
    <span class="status readout"></span>
  </div>
</div>

<style>
  .row { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 26px; align-items: center; }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; } }
  .sticks { display: flex; gap: 18px; }
  figure { margin: 0; text-align: center; font-size: 13px; font-weight: 700; color: var(--muted); }
  .stick { width: 120px; height: 120px; border-radius: 50%; border: 2.6px solid var(--ink); background: #fff; position: relative; touch-action: none; cursor: grab; margin-bottom: 6px; }
  /* The dead zone: 62 of 512, about 12% of the stick's travel. */
  .dz { position: absolute; left: 50%; top: 50%; width: 24%; height: 24%; transform: translate(-50%, -50%); border-radius: 50%; border: 2px dashed #8a96a0; z-index: 1; pointer-events: none; }
  .knob { position: absolute; left: 50%; top: 50%; width: 40px; height: 40px; margin: -20px; border-radius: 50%; background: var(--coral); border: 2.6px solid var(--ink); pointer-events: none; }
  [data-stick="translation"] .knob { background: var(--blue); }
  .bars { display: grid; gap: 10px; }
  .bar { display: grid; grid-template-columns: 70px minmax(0, 1fr) 64px; gap: 10px; align-items: center; font-size: 14px; font-weight: 700; }
  .track { height: 18px; border-radius: 9px; background: #ebe7dc; position: relative; overflow: hidden; }
  .track::after { content: ""; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; background: var(--ink); }
  .track i { position: absolute; top: 0; bottom: 0; background: var(--green); }
  .bar code { text-align: right; }
</style>

<script>
  import { onEveryPage } from '../../lib/page';

  // A port of sketches/omnidirectional/wheel_mixer.cpp, so the bars show what the firmware computes.
  const STICK_MAX = 512;
  const DEAD_ZONE = 62;
  const TIMEOUT_MS = 500;
  type Stick = { x: number; y: number };

  const clamp = (v: number) => Math.max(-STICK_MAX, Math.min(STICK_MAX, v));
  const shape = (v: number) => (v < DEAD_ZONE && v > -DEAD_ZONE ? 0 : clamp(v));

  function contribution(stick: Stick, a: number, b: number, c: number, d: number) {
    const x = shape(stick.x);
    const y = shape(stick.y);
    const magnitude = clamp(Math.trunc(Math.sqrt(x * x + y * y)));
    const s = [0, 0, 0, 0];
    if (x >= 0 && y <= 0) { s[a] = s[b] = -y - x; s[c] = s[d] = magnitude; }
    if (x >= 0 && y >= 0) { s[a] = s[b] = -magnitude; s[c] = s[d] = -y + x; }
    if (x <= 0 && y >= 0) { s[a] = s[b] = -y - x; s[c] = s[d] = -magnitude; }
    if (x <= 0 && y <= 0) { s[a] = s[b] = magnitude; s[c] = s[d] = -y + x; }
    return { values: s, magnitude };
  }

  function mixWheels(rotation: Stick, translation: Stick) {
    const r = contribution(rotation, 0, 3, 1, 2);
    const t = contribution(translation, 0, 2, 1, 3);
    const total = r.magnitude + t.magnitude;
    if (!total) return [0, 0, 0, 0];
    return r.values.map((rv, i) => Math.trunc((rv * r.magnitude + t.values[i] * t.magnitude) / total));
  }

  onEveryPage((signal) => {
    for (const root of document.querySelectorAll<HTMLElement>('.omni')) {
      const sticks: Record<string, Stick> = { rotation: { x: 0, y: 0 }, translation: { x: 0, y: 0 } };
      const bars = [...root.querySelectorAll<HTMLElement>('.bar')];
      const status = root.querySelector('.status')!;
      let quietUntil = 0;
      let lastCommand = performance.now();
      let held = [0, 0, 0, 0];

      function render() {
        const now = performance.now();
        if (now >= quietUntil) lastCommand = now;
        const stale = now - lastCommand > TIMEOUT_MS;
        // While quiet, the firmware keeps following the last command it received until it goes stale.
        if (now >= quietUntil) held = mixWheels(sticks.rotation, sticks.translation);
        const speeds = stale ? [0, 0, 0, 0] : held;
        bars.forEach((bar, i) => {
          const v = speeds[i];
          const fill = bar.querySelector('i')!;
          const pct = (Math.abs(v) / STICK_MAX) * 50;
          fill.style.left = v >= 0 ? '50%' : `${50 - pct}%`;
          fill.style.width = `${pct}%`;
          fill.style.background = v >= 0 ? 'var(--green)' : 'var(--coral)';
          // The firmware caps a full-speed wheel at 80% duty.
          bar.querySelector('code')!.textContent = `${Math.round((Math.abs(v) / STICK_MAX) * 80)}%`;
        });
        status.textContent = now < quietUntil
          ? stale ? 'No command for over 500 ms: every motor stopped.' : 'Quiet… the robot keeps the last command for 500 ms.'
          : '';
        if (!signal.aborted) requestAnimationFrame(render);
      }

      for (const el of root.querySelectorAll<HTMLElement>('.stick')) {
        const knob = el.querySelector<HTMLElement>('.knob')!;
        const stick = sticks[el.dataset.stick!];
        let drag = false;
        const move = (e: PointerEvent) => {
          const r = el.getBoundingClientRect();
          const R = r.width / 2 - 20;
          let dx = e.clientX - r.left - r.width / 2;
          let dy = e.clientY - r.top - r.height / 2;
          const m = Math.hypot(dx, dy);
          if (m > R) { dx *= R / m; dy *= R / m; }
          knob.style.transform = `translate(${dx}px, ${dy}px)`;
          // Bluepad32 reports y as positive downward, the same as the screen.
          stick.x = Math.round((dx / R) * STICK_MAX);
          stick.y = Math.round((dy / R) * STICK_MAX);
        };
        el.addEventListener('pointerdown', (e) => { drag = true; el.setPointerCapture(e.pointerId); move(e); });
        el.addEventListener('pointermove', (e) => { if (drag) move(e); });
        const up = () => { drag = false; stick.x = stick.y = 0; knob.style.transform = ''; };
        el.addEventListener('pointerup', up);
        el.addEventListener('pointercancel', up);
      }
      root.querySelector('[data-quiet]')!.addEventListener('click', () => { quietUntil = performance.now() + 1000; });
      render();
    }
  });
</script>
