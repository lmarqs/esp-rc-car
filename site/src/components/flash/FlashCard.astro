---
import FlashPicture from '../board/FlashPicture.astro';
import HandHint from '../board/HandHint.astro';
import { sketchKey } from '../../lib/flash/manifest';
import { readManifest } from '../../lib/flash/readManifest';
import { defaultValues, passwordHelp, settingsOf } from '../../lib/flash/settings';
import { stepsFor, type Step } from './view';

interface Props {
  /** The project's `sketch` field, such as `sketches/blink/simple`; the manifest names a sketch by its path under `sketches/`. */
  sketch: string;
  title: string;
  /** Speed the sketch prints at; absent for a sketch that prints nothing, which gets no board output. */
  baud?: number;
  /** What to do once the board runs. */
  next?: string;
  /** The project's page, when the card is not on it: the link to the section `Run it on your board` goes there. */
  detailsHref?: string;
}

const { sketch, title, baud, next, detailsHref } = Astro.props;
const name = sketchKey(sketch);
const entry = readManifest().sketches[name];
const manifest = entry && { sketches: { [name]: entry } };
const fields = manifest ? settingsOf(manifest, name, baud) : [];
const stepNames: Record<Step, string> = { connect: 'Connect', settings: 'Settings', flash: 'Flash', running: 'Running' };
const fieldId = (key: string) => `flash-${name}-${key}`;
const opening = defaultValues(fields);
const helpOf = (field: (typeof fields)[number]) =>
  [field.help, field.type === 'password' && passwordHelp(field)].filter(Boolean).join(' ');
---

<section class="playground flash-card" aria-label="Put it on your board">
  <div class="label">Put it on your board</div>
  {
    manifest ? (
      <div
        data-flash-card
        data-sketch={name}
        data-title={title}
        data-next={next}
        data-baud={baud}
        data-details-href={detailsHref}
        data-manifest={JSON.stringify(manifest)}
      >
        <ol class="steps">
          {stepsFor(fields.length > 0).map((step) => (
            <li data-step={step}>{stepNames[step]}</li>
          ))}
        </ol>
        <p data-message aria-live="polite" tabindex="-1" />
        <div class="progress" data-progress hidden>
          <FlashPicture />
          <HandHint />
        </div>
        <div class="output" data-output hidden>
          <div class="output-label" data-output-label aria-hidden="true" />
          <pre data-lines tabindex="0" role="group" />
        </div>
        {
          fields.length > 0 && (
            <form class="settings" data-settings novalidate hidden>
              {fields.map((field) => (
                <div class="field">
                  <label for={fieldId(field.key)}>{field.label}</label>
                  <div class="input">
                    {/* No name: the values never leave the page in a form submission, only through the port. */}
                    <input
                      id={fieldId(field.key)}
                      type={field.type}
                      value={opening[field.key]}
                      data-key={field.key}
                      data-default={opening[field.key]}
                      min={field.min}
                      max={field.max}
                      step={field.step}
                      minlength={field.minLength}
                      maxlength={field.maxLength}
                      autocomplete={field.type === 'password' ? 'new-password' : 'off'}
                      spellcheck="false"
                      aria-describedby={`${fieldId(field.key)}-error${helpOf(field) ? ` ${fieldId(field.key)}-help` : ''}`}
                    />
                    {field.type === 'password' && (
                      <button
                        class="btn ghost"
                        type="button"
                        data-show={field.key}
                        aria-pressed="false"
                        aria-controls={fieldId(field.key)}
                        aria-label={`Show ${field.label}`}
                      >
                        Show
                      </button>
                    )}
                  </div>
                  <p class="error" id={`${fieldId(field.key)}-error`} data-error={field.key} hidden />
                  {helpOf(field) && (
                    <p class="help" id={`${fieldId(field.key)}-help`}>
                      {helpOf(field)}
                    </p>
                  )}
                </div>
              ))}
              <p class="help" data-form-help hidden />
              <div class="actions">
                <button class="btn" type="submit" data-submit />
                <button class="btn ghost" type="button" data-defaults>
                  Use the defaults
                </button>
              </div>
            </form>
          )
        }
        <div class="actions">
          <button class="btn" type="button" data-action hidden />
          <button class="btn ghost" type="button" data-action hidden />
          <button class="btn ghost" type="button" data-action hidden />
        </div>
        <ul class="links" data-links hidden />
        <noscript><p class="notice">Flashing from the browser needs JavaScript.</p></noscript>
      </div>
    ) : (
      <p>
        This board is flashed from your computer with the tools, not from the browser.{' '}
        <a href={`${detailsHref ?? ''}#run-it-on-your-board`}>Run it on your board</a>
      </p>
    )
  }
</section>

<style>
  .flash-card [hidden] { display: none !important; }
  .steps { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0 0 12px; padding: 0; counter-reset: step; }
  .steps li { counter-increment: step; font-size: 14px; font-weight: 700; color: var(--muted); padding: 2px 12px; border: 2px solid var(--line); border-radius: 999px; }
  .steps li::before { content: counter(step) ". "; }
  .steps li[data-state="done"] { background: var(--tint-green); border-color: var(--green); color: var(--ink); }
  .steps li[aria-current="step"] { background: var(--tint-yellow); border-color: var(--ink); color: var(--ink); }
  [data-message] { margin: 0 0 12px; }
  [data-message].notice { margin: 0 0 12px; }
  .links { margin: 0; padding-left: 20px; }
  .output { margin: 0 0 12px; }
  .output-label { font-size: 14px; font-weight: 700; color: var(--muted); margin: 0 0 6px; }
  .output pre { margin: 0; min-height: calc(6 * 1.55em + 32px); font-family: var(--mono); }
  .output pre:empty::before { content: "Waiting for the board to print."; opacity: .7; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .progress { display: flex; align-items: center; gap: 16px; max-width: 520px; margin: 0 0 12px; }
  .progress > :first-child { flex: 1; min-width: 0; }
  .settings { margin: 0 0 12px; }
  .settings .field { margin: 0 0 12px; }
  .settings label { display: block; font-weight: 700; margin: 0 0 4px; }
  .settings .input { display: flex; gap: 8px; }
  .settings input { flex: 1; min-width: 0; font: inherit; padding: 6px 10px; border: var(--stroke); border-radius: 8px; }
  .settings input[aria-invalid="true"] { border-color: var(--coral); }
  .settings .help { margin: 4px 0 0; font-size: 14px; color: var(--muted); }
  .settings .error { margin: 4px 0 0; padding-left: 8px; border-left: 4px solid var(--coral); font-size: 14px; font-weight: 700; }
</style>

<script>
  import { theBoard } from '../../lib/board/board';
  import { thePick } from '../../lib/board/pick';
  import { flashScene } from '../../lib/board/flashScene';
  import { paintFlashPicture, paintHandHint } from '../board/flashPicture';
  import { runs } from '../../lib/board/record';
  import { href } from '../../lib/href';
  import { onEveryPage } from '../../lib/page';
  import type { Manifest } from '../../lib/flash/manifest';
  import { isBusy, type SessionState } from '../../lib/flash/session';
  import { settingsOf } from '../../lib/flash/settings';
  import { stepsFor, viewFor } from './view';

  /** The states the card draws the picture in: while it reaches and writes the board, and when that failed. */
  const PICTURED: ReadonlySet<SessionState['kind']> = new Set([
    'connecting',
    'flashing',
    'flashMode',
    'noPort',
    'portBusy',
    'noAnswer',
    'noImage',
    'noDownload',
    'dropped',
  ]);

  onEveryPage((signal) => {
    for (const card of document.querySelectorAll<HTMLElement>('[data-flash-card]')) {
      const { sketch, title, next, baud: baudText, detailsHref } = card.dataset;
      const baud = baudText ? Number(baudText) : undefined;
      const manifest = JSON.parse(card.dataset.manifest!) as Manifest;
      // The site's board, which may already be connected from another page. The card shows it only while the card
      // is the board's owner, from the visitor's press or because the board runs the card's sketch.
      const board = theBoard();
      const { session } = board;
      const owner = `card:${sketch}`;
      const use = { manifest, sketch: sketch!, baud };
      const claim = () => board.owner === owner || board.use(owner, use);
      if (runs(board.record) === sketch) claim();
      // A card on the Flash page waits for its project to be picked, which names its sketch the opened one.
      if (card.closest('[hidden]') === null) board.open(sketch!, signal);
      const settings = settingsOf(manifest, sketch!, baud);
      const context = {
        title: title!,
        next,
        baud,
        images: manifest.sketches[sketch!]!.images,
        firmwareUrl: href('/firmware/'),
        detailsHref,
        settings,
      };
      const stepOrder = stepsFor(settings.length > 0);

      const message = card.querySelector<HTMLElement>('[data-message]')!;
      const progress = card.querySelector<HTMLElement>('[data-progress]')!;
      const output = card.querySelector<HTMLElement>('[data-output]')!;
      const outputLabel = output.querySelector<HTMLElement>('[data-output-label]')!;
      const lines = output.querySelector<HTMLElement>('[data-lines]')!;
      const buttons = [...card.querySelectorAll<HTMLButtonElement>('[data-action]')];
      const links = card.querySelector<HTMLElement>('[data-links]')!;
      const steps = [...card.querySelectorAll<HTMLElement>('[data-step]')];
      const form = card.querySelector<HTMLFormElement>('[data-settings]');
      const inputs = [...card.querySelectorAll<HTMLInputElement>('[data-settings] input[data-key]')];
      const formHelp = card.querySelector<HTMLElement>('[data-form-help]');
      const formValues = () => Object.fromEntries(inputs.map((input) => [input.dataset.key!, input.value]));
      let filledWith: Readonly<Record<string, string>> | undefined;

      async function submitSettings(restoreDefaults = false) {
        if (!claim()) return;
        await board.send({ type: 'submitSettings', values: formValues(), restoreDefaults });
        const state = session.state;
        if (state.kind === 'settings' && state.errors) {
          inputs.find((input) => input.dataset.key! in state.errors!)?.focus();
        }
      }

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        void submitSettings();
      });
      form?.querySelector('[data-defaults]')?.addEventListener('click', () => {
        for (const input of inputs) input.value = input.dataset.default!;
        void submitSettings(true);
      });
      for (const toggle of card.querySelectorAll<HTMLButtonElement>('[data-show]')) {
        const input = inputs.find((candidate) => candidate.dataset.key === toggle.dataset.show)!;
        toggle.addEventListener('click', () => {
          const shown = input.type === 'password';
          input.type = shown ? 'text' : 'password';
          toggle.setAttribute('aria-pressed', String(shown));
        });
      }

      for (const button of buttons) {
        button.addEventListener('click', () => {
          const event = button.dataset.event;
          if (
            event === 'connect' ||
            event === 'retry' ||
            event === 'disconnect' ||
            event === 'changeSettings' ||
            event === 'closeSettings'
          ) {
            if (claim()) void board.send({ type: event });
          }
        });
      }

      /** The session's state while the card owns the board; otherwise the card waits to be pressed, as if idle. */
      function shownState(): SessionState {
        if (board.owner === owner || session.state.kind === 'unsupported') return session.state;
        return { kind: 'idle' };
      }

      function render() {
        const state = shownState();
        // The page that lists several cards reads this to keep a visitor from leaving a write half-done.
        card.toggleAttribute('data-busy', isBusy(state));
        const view = viewFor(state, { ...context, board: thePick().model });
        // Only a change of text is announced: the progress bar carries the percentage.
        if (message.textContent !== view.message) message.textContent = view.message;
        message.className = view.notice ? 'notice' : '';

        const current = stepOrder.indexOf(view.step);
        steps.forEach((li, index) => {
          li.dataset.state = index < current ? 'done' : '';
          if (index === current) li.setAttribute('aria-current', 'step');
          else li.removeAttribute('aria-current');
        });

        // From the press to the board running the sketch, and after a failure, the picture shows where things are.
        progress.hidden = !PICTURED.has(state.kind);
        if (!progress.hidden) {
          const scene = flashScene(state, thePick().model);
          paintFlashPicture(progress, scene);
          paintHandHint(progress, scene.hint);
        }

        // The output is not a live region: it changes with every line the board prints, and the status above says what
        // the card is doing.
        output.hidden = !view.output;
        if (view.output) {
          outputLabel.textContent = view.output.label;
          lines.setAttribute('aria-label', view.output.label);
          const text = view.output.lines.join('\n');
          if (lines.textContent !== text) lines.textContent = text;
        }

        if (form) {
          // A hidden form cannot keep the focus either.
          if (!view.form && form.contains(document.activeElement)) message.focus();
          form.hidden = !view.form;
          if (view.form) {
            // Fills the inputs once per opening, so a re-render after an error keeps what the visitor typed.
            if (view.form.values !== filledWith) {
              filledWith = view.form.values;
              for (const input of inputs) input.value = filledWith[input.dataset.key!] ?? '';
            }
            formHelp!.textContent = view.form.help ?? '';
            formHelp!.hidden = !view.form.help;
            form.querySelector('[data-submit]')!.textContent = view.form.submit;
            for (const input of inputs) {
              const key = input.dataset.key!;
              const error = view.form.errors[key];
              const shown = form.querySelector<HTMLElement>(`[data-error="${key}"]`)!;
              shown.textContent = error ?? '';
              shown.hidden = !error;
              if (error) input.setAttribute('aria-invalid', 'true');
              else input.removeAttribute('aria-invalid');
            }
          }
        }

        buttons.forEach((button, index) => {
          const action = view.actions?.[index];
          // A hidden button cannot keep the focus, which would fall to the page; the status is the next thing to read.
          if (!action && document.activeElement === button) message.focus();
          button.hidden = !action;
          if (action) {
            button.textContent = action.label;
            button.dataset.event = action.event;
          }
        });

        links.hidden = !view.links;
        links.replaceChildren(
          ...(view.links ?? []).map((link) => {
            const item = document.createElement('li');
            const anchor = document.createElement('a');
            anchor.textContent = link.label;
            anchor.href = link.href;
            item.append(anchor);
            return item;
          }),
        );
      }

      const unsubscribe = [board.subscribe(render), thePick().subscribe(render)];
      // The router swaps the page out without unloading it; the board stays connected for the next page.
      signal.addEventListener('abort', () => unsubscribe.forEach((stop) => stop()));
      render();
    }
  });
</script>
