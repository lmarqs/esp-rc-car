---
import { sketchKey } from '../../lib/flash/manifest';
import { readManifest } from '../../lib/flash/readManifest';
import { defaultValues, passwordHelp, settingsOf } from '../../lib/flash/settings';

interface Props {
  /** The project's `sketch` field, such as `sketches/blink/simple`; the manifest names a sketch by its path under `sketches/`. */
  sketch: string;
  title: string;
  /** Speed the sketch prints at, which the board is read at; absent for a sketch that prints nothing, which has no settings. */
  baud?: number;
  /** What to do once the board runs the sketch. */
  next?: string;
  /** The project's page, when the card is not on it: the link to the section `Run it on your board` goes there. */
  detailsHref?: string;
}

const { sketch, title, baud, next, detailsHref } = Astro.props;
const name = sketchKey(sketch);
const entry = readManifest().sketches[name];
const manifest = entry && { sketches: { [name]: entry } };
const fields = manifest ? settingsOf(manifest, name, baud) : [];
const fieldId = (key: string) => `flash-${name}-${key}`;
const opening = defaultValues(fields);
const helpOf = (field: (typeof fields)[number]) =>
  [field.help, field.type === 'password' && passwordHelp(field)].filter(Boolean).join(' ');
---

<section class="playground flash-card" aria-label="Put it on your board">
  <div class="label">Put it on your board</div>
  {
    manifest ? (
      <div
        data-flash-card
        data-sketch={name}
        data-title={title}
        data-next={next}
        data-baud={baud}
        data-details-href={detailsHref}
        data-manifest={JSON.stringify(manifest)}
      >
        <p data-message aria-live="polite" tabindex="-1" />
        {
          fields.length > 0 && (
            <form class="settings" data-settings novalidate hidden>
              {fields.map((field) => (
                <div class="field">
                  <label for={fieldId(field.key)}>{field.label}</label>
                  <div class="input">
                    {/* No name: the values never leave the page in a form submission, only through the port. */}
                    <input
                      id={fieldId(field.key)}
                      type={field.type}
                      value={opening[field.key]}
                      data-key={field.key}
                      data-default={opening[field.key]}
                      min={field.min}
                      max={field.max}
                      step={field.step}
                      minlength={field.minLength}
                      maxlength={field.maxLength}
                      autocomplete={field.type === 'password' ? 'new-password' : 'off'}
                      spellcheck="false"
                      aria-describedby={`${fieldId(field.key)}-error${helpOf(field) ? ` ${fieldId(field.key)}-help` : ''}`}
                    />
                    {field.type === 'password' && (
                      <button
                        class="btn ghost"
                        type="button"
                        data-show={field.key}
                        aria-pressed="false"
                        aria-controls={fieldId(field.key)}
                        aria-label={`Show ${field.label}`}
                      >
                        Show
                      </button>
                    )}
                  </div>
                  <p class="error" id={`${fieldId(field.key)}-error`} data-error={field.key} hidden />
                  {helpOf(field) && (
                    <p class="help" id={`${fieldId(field.key)}-help`}>
                      {helpOf(field)}
                    </p>
                  )}
                </div>
              ))}
              <p class="help" data-form-help hidden />
              <div class="actions">
                <button class="btn" type="submit" data-submit />
                <button class="btn ghost" type="button" data-defaults>
                  Use the defaults
                </button>
              </div>
            </form>
          )
        }
        <div class="actions">
          <button class="btn" type="button" data-action hidden />
        </div>
        <ul class="links" data-links hidden />
        <noscript><p class="notice">Flashing from the browser needs JavaScript.</p></noscript>
      </div>
    ) : (
      <p>
        This board is flashed from your computer with the tools, not from the browser.{' '}
        <a href={`${detailsHref ?? ''}#run-it-on-your-board`}>Run it on your board</a>
      </p>
    )
  }
</section>

<style>
  .flash-card [hidden] { display: none !important; }
  [data-message] { margin: 0 0 12px; }
  [data-message].notice { margin: 0 0 12px; }
  .links { margin: 0; padding-left: 20px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .settings { margin: 0 0 12px; }
  .settings .field { margin: 0 0 12px; }
  .settings label { display: block; font-weight: 700; margin: 0 0 4px; }
  .settings .input { display: flex; gap: 8px; }
  .settings input { flex: 1; min-width: 0; font: inherit; padding: 6px 10px; border: var(--stroke); border-radius: 8px; }
  .settings input[aria-invalid="true"] { border-color: var(--coral); }
  .settings .help { margin: 4px 0 0; font-size: 14px; color: var(--muted); }
  .settings .error { margin: 4px 0 0; padding-left: 8px; border-left: 4px solid var(--coral); font-size: 14px; font-weight: 700; }
</style>

<script>
  import { theBoard } from '../../lib/board/board';
  import { href } from '../../lib/href';
  import { onEveryPage } from '../../lib/page';
  import type { Manifest } from '../../lib/flash/manifest';
  import { isBusy } from '../../lib/flash/session';
  import { settingsOf } from '../../lib/flash/settings';
  import { cardUse } from './cardUse';
  import { viewFor, worksOn } from './view';

  onEveryPage((signal) => {
    for (const card of document.querySelectorAll<HTMLElement>('[data-flash-card]')) {
      const { sketch, title, next, baud, detailsHref } = card.dataset;
      const manifest = JSON.parse(card.dataset.manifest!) as Manifest;
      // The site's board, which may already be connected from another page.
      const board = theBoard();
      const { session } = board;
      // A card on the Flash page waits for its project to be picked, which opens its sketch.
      if (card.closest('[hidden]') === null) board.open(cardUse(card), title!, signal);
      const settings = settingsOf(manifest, sketch!, baud ? Number(baud) : undefined);
      const context = {
        title: title!,
        next,
        images: manifest.sketches[sketch!]!.images,
        firmwareUrl: href('/firmware/'),
        detailsHref,
        settings,
      };

      const message = card.querySelector<HTMLElement>('[data-message]')!;
      const action = card.querySelector<HTMLButtonElement>('[data-action]')!;
      const links = card.querySelector<HTMLElement>('[data-links]')!;
      const form = card.querySelector<HTMLFormElement>('[data-settings]');
      const inputs = [...card.querySelectorAll<HTMLInputElement>('[data-settings] input[data-key]')];
      const formHelp = card.querySelector<HTMLElement>('[data-form-help]');
      const formValues = () => Object.fromEntries(inputs.map((input) => [input.dataset.key!, input.value]));
      let filledWith: Readonly<Record<string, string>> | undefined;

      async function submitSettings(restoreDefaults = false) {
        await board.send({ type: 'submitSettings', values: formValues(), restoreDefaults });
        const state = session.state;
        if (state.kind === 'settings' && state.errors) {
          inputs.find((input) => input.dataset.key! in state.errors!)?.focus();
        }
      }

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        void submitSettings();
      });
      form?.querySelector('[data-defaults]')?.addEventListener('click', () => {
        for (const input of inputs) input.value = input.dataset.default!;
        void submitSettings(true);
      });
      for (const toggle of card.querySelectorAll<HTMLButtonElement>('[data-show]')) {
        const input = inputs.find((candidate) => candidate.dataset.key === toggle.dataset.show)!;
        toggle.addEventListener('click', () => {
          const shown = input.type === 'password';
          input.type = shown ? 'text' : 'password';
          toggle.setAttribute('aria-pressed', String(shown));
        });
      }

      action.addEventListener('click', () => {
        const event = action.dataset.event;
        if (event === 'retry' || event === 'changeSettings' || event === 'closeSettings') {
          void board.send({ type: event });
        }
      });

      function render() {
        const state = session.state;
        // The page that lists several cards reads this to keep a visitor from leaving a write half-done.
        card.toggleAttribute('data-busy', isBusy(state));
        const view = viewFor(state, worksOn(board.record, sketch!), context);
        if (message.textContent !== view.message) message.textContent = view.message;
        message.className = view.notice ? 'notice' : '';

        if (form) {
          // A hidden form cannot keep the focus either.
          if (!view.form && form.contains(document.activeElement)) message.focus();
          form.hidden = !view.form;
          if (view.form) {
            // Fills the inputs once per opening, so a re-render after an error keeps what the visitor typed.
            if (view.form.values !== filledWith) {
              filledWith = view.form.values;
              for (const input of inputs) input.value = filledWith[input.dataset.key!] ?? '';
            }
            formHelp!.textContent = view.form.help ?? '';
            formHelp!.hidden = !view.form.help;
            form.querySelector('[data-submit]')!.textContent = view.form.submit;
            for (const input of inputs) {
              const key = input.dataset.key!;
              const error = view.form.errors[key];
              const shown = form.querySelector<HTMLElement>(`[data-error="${key}"]`)!;
              shown.textContent = error ?? '';
              shown.hidden = !error;
              if (error) input.setAttribute('aria-invalid', 'true');
              else input.removeAttribute('aria-invalid');
            }
          }
        }

        // A hidden button cannot keep the focus, which would fall to the page; the status is the next thing to read.
        if (!view.action && document.activeElement === action) message.focus();
        action.hidden = !view.action;
        if (view.action) {
          action.textContent = view.action.label;
          action.dataset.event = view.action.event;
        }

        links.hidden = !view.links;
        links.replaceChildren(
          ...(view.links ?? []).map((link) => {
            const item = document.createElement('li');
            const anchor = document.createElement('a');
            anchor.textContent = link.label;
            anchor.href = link.href;
            item.append(anchor);
            return item;
          }),
        );
      }

      const unsubscribe = board.subscribe(render);
      // The router swaps the page out without unloading it; the board stays connected for the next page.
      signal.addEventListener('abort', unsubscribe);
      render();
    }
  });
</script>
