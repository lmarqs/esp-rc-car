---
import { readManifest } from '../../lib/flash/readManifest';
import { STEPS } from './view';

interface Props {
  /** The project's `sketch` field, such as `sketches/blink`; the manifest names a sketch by its folder. */
  sketch: string;
  title: string;
  /** Speed of the flashing; the flasher's default when absent. */
  baud?: number;
  /** What to do once the board runs. */
  next?: string;
}

const { sketch, title, baud, next } = Astro.props;
const name = sketch.split('/').pop()!;
const entry = readManifest().sketches[name];
const manifest = entry && { sketches: { [name]: entry } };
const stepNames: Record<(typeof STEPS)[number], string> = { connect: 'Connect', flash: 'Flash', running: 'Running' };
---

<section class="playground flash-card" aria-label="Put it on your board">
  <div class="label">Put it on your board</div>
  {
    manifest ? (
      <div
        data-flash-card
        data-sketch={name}
        data-title={title}
        data-next={next}
        data-baud={baud}
        data-manifest={JSON.stringify(manifest)}
      >
        <ol class="steps">
          {STEPS.map((step) => (
            <li data-step={step}>{stepNames[step]}</li>
          ))}
        </ol>
        <p data-message aria-live="polite" tabindex="-1" />
        <div class="progress" data-progress hidden>
          <div class="track" role="progressbar" aria-label="Flashing" aria-valuemin="0" aria-valuemax="100">
            <div class="fill" data-fill />
          </div>
          <span class="readout" data-percent />
        </div>
        <button class="btn" type="button" data-action hidden />
        <noscript><p class="notice">Flashing from the browser needs JavaScript.</p></noscript>
      </div>
    ) : (
      <p>
        This board is flashed from your computer with the tools, not from the browser.{' '}
        <a href="#run-it-on-your-board">Run it on your board</a>
      </p>
    )
  }
</section>

<style>
  .flash-card [hidden] { display: none !important; }
  .steps { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0 0 12px; padding: 0; counter-reset: step; }
  .steps li { counter-increment: step; font-size: 14px; font-weight: 700; color: var(--muted); padding: 2px 12px; border: 2px solid var(--line); border-radius: 999px; }
  .steps li::before { content: counter(step) ". "; }
  .steps li[data-state="done"] { background: var(--tint-green); border-color: var(--green); color: var(--ink); }
  .steps li[aria-current="step"] { background: var(--tint-yellow); border-color: var(--ink); color: var(--ink); }
  [data-message] { margin: 0 0 12px; }
  [data-message].notice { margin: 0 0 12px; }
  .progress { display: flex; align-items: center; gap: 12px; margin: 0 0 12px; }
  .track { flex: 1; height: 14px; border: var(--stroke); border-radius: 999px; background: var(--tint-blue); overflow: hidden; }
  .fill { height: 100%; width: 0; background: var(--blue); transition: width .15s; }
  .progress .readout { min-width: 4ch; text-align: right; }
</style>

<script>
  import { createFlasher } from '../../lib/flash/createFlasher';
  import type { Manifest } from '../../lib/flash/manifest';
  import { createSession } from '../../lib/flash/session';
  import { STEPS, viewFor } from './view';

  for (const card of document.querySelectorAll<HTMLElement>('[data-flash-card]')) {
    const { sketch, title, next, baud, manifest } = card.dataset;
    const session = createSession({
      flasher: createFlasher({ baudRate: baud ? Number(baud) : undefined }),
      manifest: JSON.parse(manifest!) as Manifest,
      sketch: sketch!,
    });
    const context = { title: title!, next };

    const message = card.querySelector<HTMLElement>('[data-message]')!;
    const progress = card.querySelector<HTMLElement>('[data-progress]')!;
    const track = progress.querySelector<HTMLElement>('[role="progressbar"]')!;
    const fill = progress.querySelector<HTMLElement>('[data-fill]')!;
    const percent = progress.querySelector<HTMLElement>('[data-percent]')!;
    const action = card.querySelector<HTMLButtonElement>('[data-action]')!;
    const steps = [...card.querySelectorAll<HTMLElement>('[data-step]')];

    action.addEventListener('click', () => {
      const event = action.dataset.event;
      if (event === 'connect' || event === 'retry') {
        void session.send({ type: event });
      }
    });

    function render() {
      const view = viewFor(session.state, context);
      // Only a change of text is announced: the progress bar carries the percentage.
      if (message.textContent !== view.message) message.textContent = view.message;
      message.className = view.notice ? 'notice' : '';

      const current = STEPS.indexOf(view.step);
      steps.forEach((li, index) => {
        li.dataset.state = index < current ? 'done' : '';
        if (index === current) li.setAttribute('aria-current', 'step');
        else li.removeAttribute('aria-current');
      });

      progress.hidden = view.progress === undefined;
      if (view.progress !== undefined) {
        track.setAttribute('aria-valuenow', String(view.progress));
        fill.style.width = `${view.progress}%`;
        percent.textContent = `${view.progress}%`;
      }

      // A hidden button cannot keep the focus, which would fall to the page; the status is the next thing to read.
      if (!view.action && document.activeElement === action) message.focus();
      action.hidden = !view.action;
      if (view.action) {
        action.textContent = view.action.label;
        action.dataset.event = view.action.event;
      }
    }

    session.subscribe((state) => {
      render();
      // No sketch has settings yet, so the card flashes as soon as the board answers.
      if (state.kind === 'settings') void session.send({ type: 'startFlash' });
    });
    render();
  }
</script>
