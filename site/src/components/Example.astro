---
import HBridge from './examples/HBridge.astro';
import Motor from './examples/Motor.astro';
import Omnidirectional from './examples/Omnidirectional.astro';

interface Props {
  name?: string;
}

const examples: Record<string, any> = {
  omnidirectional: Omnidirectional,
  motor: Motor,
  'h-bridge': HBridge,
};
const Component = Astro.props.name ? examples[Astro.props.name] : undefined;
---

{Component && <Component />}
