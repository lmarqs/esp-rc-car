---
/**
 * The session's work as nodes on a line: a flash in three steps, Find, Write and Restart, or a connection in one,
 * Connect. A node shows its step's icon, a spinner while the step runs, a check once it is done and a cross where it
 * failed, and the line between them fills as the flash goes on. `paintFlashRail` draws a `FlashScene` in it.
 */
const PLUG = 'M6 2v3M10 2v3M4 5h8v2a4 4 0 0 1-8 0zM8 11v3';
const STEPS = [
  { word: 'Find', icon: 'M7 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM10 10l3.5 3.5' },
  { word: 'Write', icon: 'M8 2.5v8M4.5 7.5 8 11l3.5-3.5M3 13.5h10' },
  { word: 'Restart', icon: 'M13 8a5 5 0 1 1-1.5-3.6M13 2.5v3h-3' },
];
---

<div class="flash-rail" aria-label="Connecting" aria-valuemin="0" aria-valuemax="100" data-flash-rail data-work="connect">
  <span class="node" aria-hidden="true" data-connect-step data-mark="todo">
    <i class="dot">
      <svg class="step" viewBox="0 0 16 16"><path d={PLUG}></path></svg>
      <svg class="done" viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7"></path></svg>
      <svg class="failed" viewBox="0 0 16 16"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7"></path></svg>
    </i>
    <span class="word">Connect</span>
  </span>
  {
    STEPS.map(({ word, icon }, index) => (
      <>
        {index > 0 && <span class="seg" data-flash-seg={index - 1}></span>}
        <span class="node" aria-hidden="true" data-flash-step data-mark="todo">
          <i class="dot">
            <svg class="step" viewBox="0 0 16 16"><path d={icon}></path></svg>
            <svg class="done" viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7"></path></svg>
            <svg class="failed" viewBox="0 0 16 16"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7"></path></svg>
          </i>
          <span class="word">{word}</span>
        </span>
      </>
    ))
  }
</div>

<style>
  .flash-rail { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .node { display: inline-flex; align-items: center; gap: 7px; flex: none; font-size: 12px; font-weight: 600; line-height: 1.5; white-space: nowrap; color: var(--quiet); }
  .dot { position: relative; display: grid; place-items: center; width: 22px; height: 22px; flex: none; border-radius: 50%; border: 1px solid var(--on-ink-edge); }
  svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .done, .failed { display: none; }
  [data-work="connect"] :is([data-flash-step], .seg), [data-work="flash"] [data-connect-step] { display: none; }

  /* A line that fills from the left as far as its step has gone. */
  .seg { position: relative; flex: none; width: 24px; height: 1px; overflow: hidden; background: var(--on-ink-line); }
  .seg::before { content: ""; position: absolute; inset: 0; width: var(--p, 0%); background: var(--yellow); transition: width .2s; }
  .seg[data-tone="written"]::before { background: var(--green-on-ink); }
  .seg[data-tone="failed"]::before { background: var(--coral-on-ink); }
  /* Light running along a line whose step is under way, or whose end is not known yet. */
  .seg[data-run]::after { content: ""; position: absolute; top: 0; bottom: 0; width: 28px; background: linear-gradient(90deg, transparent, var(--on-ink), transparent); animation: run 1.1s linear infinite; }
  @keyframes run { from { left: -28px; } to { left: 100%; } }

  [data-mark="now"] { color: var(--card); }
  [data-mark="now"] .dot::after { content: ""; position: absolute; inset: -1px; border-radius: 50%; border: 1.5px solid transparent; border-top-color: var(--yellow); animation: turn .9s linear infinite; }
  @keyframes turn { to { transform: rotate(360deg); } }
  [data-mark="done"] { color: var(--green-on-ink); }
  [data-mark="done"] .dot { border-color: var(--green-on-ink); }
  [data-mark="done"] .step, [data-mark="failed"] .step { display: none; }
  [data-mark="done"] .done, [data-mark="failed"] .failed { display: block; }
  [data-mark="failed"] { color: var(--coral-on-ink); }
  [data-mark="failed"] .dot { border-color: var(--coral-on-ink); animation: alert 1.8s ease-out infinite; }
  @keyframes alert { from { box-shadow: 0 0 0 0 #ec6b4580; } to { box-shadow: 0 0 0 8px #ec6b4500; } }
  @media (prefers-reduced-motion: reduce) { .seg::after, .dot, .dot::after { animation: none !important; } }
</style>
