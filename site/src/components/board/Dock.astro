---
import { BOARD_MODELS } from '../../lib/board/models';
import ActionButton from './ActionButton.astro';
import FlashRail from './FlashRail.astro';
import HandHint from './HandHint.astro';
import { sketchNames } from '../../lib/board/names';
import { readManifest } from '../../lib/flash/readManifest';
import { href } from '../../lib/href';
import { getCollection } from 'astro:content';

// Every page carries every name and image, so the dock can name whatever the board runs, and the session can flash any
// sketch it flashed before, wherever the visitor is.
const names = Object.fromEntries(
  Object.entries(sketchNames(await getCollection('projects'))).map(([key, name]) => [key, { ...name, path: href(name.path) }]),
);
const manifest = readManifest();
---

{/* Persisted, so the dock, the monitor's open state and its listeners stay as the router swaps the page. */}
<aside
  class="dock"
  aria-label="Your board"
  tabindex="-1"
  hidden
  data-board-dock
  data-names={JSON.stringify(names)}
  data-manifest={JSON.stringify(manifest)}
  transition:persist="board-dock"
>
  <div class="monitor" id="board-monitor" data-dock-monitor hidden>
    <div class="wrap">
      <div class="head">
        <span class="title" aria-hidden="true">Board output</span>
        <button type="button" class="clear" data-dock-clear>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 4.5h10M6.5 4.5V3h3v1.5M4.5 4.5l.7 8.5h5.6l.7-8.5"></path></svg>
          Clear
        </button>
        <button type="button" data-dock-close>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"></path></svg>
          Close
        </button>
      </div>
      <pre class="lines" role="log" aria-label="Board output" tabindex="0" data-dock-lines></pre>
      <form class="cmd" data-dock-send>
        <span class="prompt" aria-hidden="true">›</span>
        <input
          type="text"
          autocomplete="off"
          spellcheck="false"
          aria-label="Line to send to the board"
          placeholder="Line to send to the board"
          data-dock-line
        />
        <button class="send" type="submit">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2.2 14.5 8 2 13.8l1.6-5.1L9.5 8 3.6 7.3z"></path></svg>
          Send
        </button>
      </form>
      <p class="problem" role="alert" data-dock-problem hidden></p>
    </div>
  </div>
  {/* What happens between the computer and the board while the session works, waits in flash mode or failed. */}
  <div class="panel" data-dock-panel hidden>
    <div class="row wrap">
      <FlashRail />
      <div class="words">
        <HandHint />
        <p class="message" aria-live="polite" data-dock-message></p>
      </div>
      <ActionButton label="Connect board" data-dock-action="panel" />
    </div>
  </div>
  <div class="bar wrap">
    <select class="pick" aria-label="My board" data-dock-pick>
      <option value="">Which board?</option>
      {BOARD_MODELS.map((model) => <option value={model.id}>{model.name}</option>)}
    </select>
    <span class="dot" aria-hidden="true" data-dock-dot></span>
    <span class="status" aria-live="polite" data-dock-status>
      <span class="said" data-dock-said
        ><b class="chip" data-dock-chip>No board</b>{' '}<span data-dock-doing></span>{' '}<a data-dock-link hidden></a><span
          data-dock-sketch
        ></span></span
      >
    </span>
    {/* Each control keeps its room while it does not show, so none moves as the board's state changes. */}
    <span class="acts">
      {/* The meter takes the button's room while the button is in the panel. */}
      <span class="slot">
        <ActionButton label="Connect board" data-dock-action="bar" data-off />
        <span class="meter" data-dock-meter hidden>
          <span class="track" role="progressbar" aria-label="Flashing" aria-valuemin="0" aria-valuemax="100" data-dock-track>
            <i data-dock-fill></i>
          </span>
          <span class="pct" data-dock-pct></span>
        </span>
      </span>
      {/* Connect board and Disconnect never show together, so they share a room, at the button's width. */}
      <span class="slot ends">
        <ActionButton label="Connect board" data-dock-action="connect" data-off />
        <button type="button" data-dock-disconnect data-off>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v5M4.6 4.2a5 5 0 1 0 6.8 0"></path></svg>
          Disconnect
        </button>
      </span>
      <button
        type="button"
        class="serial"
        aria-label="Serial"
        aria-describedby="board-last"
        aria-expanded="false"
        aria-controls="board-monitor"
        data-dock-serial
      >
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4.5 6 8l-3.5 3.5M8 12h5.5"></path></svg>
        <span aria-hidden="true">Serial</span>
        <span class="last" id="board-last" data-dock-last></span>
        <span class="hide" aria-hidden="true">Hide output</span>
        <span class="caret" aria-hidden="true"></span>
      </button>
    </span>
  </div>
</aside>

<style>
  [hidden] { display: none !important; }
  /* At the foot of the page and stuck to the bottom of the window above it, so it covers none of the page's end. */
  .dock { position: sticky; bottom: 0; z-index: 10; background: var(--ink); color: var(--on-ink); font-size: 13px; line-height: 1.5; border-top: 1px solid var(--on-ink-edge); box-shadow: 0 -8px 20px var(--ink-shadow); }
  .dock:focus { outline: none; }
  .bar { display: flex; align-items: center; gap: 10px; min-height: 44px; padding-top: 6px; padding-bottom: 6px; }
  .pick { flex: none; font: inherit; font-weight: 700; font-size: 12px; color: var(--card); background: var(--ink-raised); border: 1px solid var(--on-ink-edge); border-radius: 999px; padding: 3px 8px; cursor: pointer; }
  .pick:hover { border-color: var(--yellow); }
  .pick:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--faint); flex: none; }
  .dot.on { background: var(--green); box-shadow: 0 0 0 3px var(--green-halo); }
  /* Takes the room the controls leave, two lines high whatever it says, and cut beyond them, so the bar keeps its
     height and one row. */
  .status { flex: 1 1 0; min-width: 0; min-height: 3em; display: flex; align-items: center; }
  .said { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .chip { color: var(--card); white-space: nowrap; }
  .status a { color: var(--on-ink); }
  .slot { display: grid; align-items: center; }
  .slot > * { grid-area: 1 / 1; }
  .ends > * { justify-self: end; }
  .meter { display: flex; align-items: center; gap: 8px; }
  .track { flex: 1; height: 6px; border-radius: 3px; background: var(--on-ink-line); overflow: hidden; }
  .track i { display: block; height: 100%; width: 0; background: var(--yellow); transition: width .15s; }
  .pct { font-family: var(--mono); color: var(--yellow); min-width: 4ch; text-align: right; }
  /* As tall as the board's button whether it shows or not, so Serial stays in place as the button moves between the
     bar and the panel. */
  .acts { display: flex; flex: none; gap: 6px; margin-left: auto; align-items: center; justify-content: flex-end; min-height: 35px; }
  .acts [data-off] { visibility: hidden; }
  .acts button, .head button { display: inline-flex; align-items: center; gap: 5px; font: inherit; font-weight: 700; font-size: 12px; color: var(--on-ink); background: transparent; border: 1px solid var(--on-ink-edge); border-radius: 999px; padding: 3px 11px; cursor: pointer; white-space: nowrap; }
  .acts button:hover, .head button:hover { border-color: var(--yellow); color: var(--yellow); }
  /* Raised like the monitor it opened, and no yellow, which means new or sent. */
  .acts button[aria-expanded="true"] { background: var(--ink-raised); border-color: var(--on-ink); color: var(--card); }
  .acts svg, .head svg { width: 12px; height: 12px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .caret { width: 0; height: 0; border-left: 4px solid transparent; border-right: 4px solid transparent; border-bottom: 5px solid currentColor; }
  [aria-expanded="true"] .caret { border-bottom: 0; border-top: 5px solid currentColor; }
  .dock button:focus-visible, .dock a:focus-visible, .lines:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .cmd:has(input:focus-visible) { box-shadow: inset 0 0 0 2px var(--blue); }
  /* The same width whatever the board last printed, so the bar never shifts as lines arrive. */
  .acts .serial { width: 300px; gap: 8px; padding: 3px 12px; }
  /* Narrower where the bar would not hold every control on one row. */
  @media (max-width: 1000px) { .acts .serial { width: 220px; } }
  .last, .hide { flex: 1 1 0; min-width: 0; padding-left: 8px; border-left: 1px solid var(--on-ink-line); text-align: left; font-size: 13px; font-weight: 400; }
  .last { flex: 1 1 0; min-width: 0; padding-left: 8px; border-left: 1px solid var(--on-ink-line); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--mono); }
  .serial[aria-expanded="false"] .hide, .serial[aria-expanded="true"] .last { display: none; }
  .last:empty::before { content: "Nothing printed yet"; opacity: .7; }
  .serial .caret { flex: none; }
  /* Below 840 px the controls do not fit on the status's row with room for the status: they take a row of their own. */
  @media (max-width: 839px) {
    .bar { flex-wrap: wrap; }
    .acts { flex: 1 1 100%; flex-wrap: wrap; }
  }
  @media (max-width: 560px) {
    .acts .serial { flex: 1 1 100%; width: auto; }
  }

  .panel { border-bottom: 1px solid var(--on-ink-line); }
  /* The steps, the message and the action on one row; each under the one before where the row would squeeze the message. */
  .row { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr) auto; gap: 10px 24px; align-items: center; padding-top: 12px; padding-bottom: 12px; }
  @media (max-width: 999px) { .row { grid-template-columns: minmax(0, 1fr); justify-items: start; } }
  /* The hand hint draws in ink on a card: here, light on the dark dock. */
  .words :global(.hand-hint) { --ink: var(--on-ink); --card: var(--ink-raised); --muted: var(--quiet-light); }
  .words { display: flex; gap: 10px; align-items: flex-start; }
  /* Room for the longest message, four lines, so the dock keeps its height as the message changes. */
  .message { flex: 1; min-width: 0; min-height: calc(4 * 1.5em); margin: 0; font-size: 14px; line-height: 1.5; }
  .message[data-notice] { padding-left: 12px; border-left: 2px solid var(--yellow); }

  .monitor { background: var(--ink-raised); border-bottom: 1px solid var(--on-ink-line); }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 0 6px; border-bottom: 1px solid var(--on-ink-line); }
  .clear { margin-left: auto; }
  .title { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); }
  /* Eight lines of 1.5em; older lines scroll up. */
  .lines { margin: 0; padding: 6px 0; height: calc(8 * 1.5em + 12px); overflow-y: auto; white-space: pre-wrap; overflow-wrap: anywhere; background: none; color: inherit; border-radius: 0; font-family: var(--mono); font-size: 13px; line-height: 1.5; scrollbar-width: thin; scrollbar-color: var(--on-ink-edge) transparent; }
  .lines :global([data-sent]) { color: var(--yellow); }
  .lines:empty::before { content: "Nothing printed yet."; color: var(--faint); }
  .cmd { display: flex; align-items: center; gap: 8px; border-top: 1px solid var(--on-ink-line); padding: 4px 4px 4px 0; font-family: var(--mono); }
  .prompt { color: var(--yellow); }
  .cmd input { flex: 1; min-width: 0; padding: 6px 0; border: 0; background: transparent; color: var(--card); font: inherit; outline: none; }
  .cmd input::placeholder { color: var(--faint); }
  .cmd input:disabled::placeholder { color: var(--quiet); }
  .send { display: inline-flex; align-items: center; gap: 6px; font: inherit; font-family: var(--sans); font-size: 13px; font-weight: 700; color: var(--ink); background: var(--yellow); border: 0; border-radius: 6px; padding: 4px 12px; cursor: pointer; }
  .send:disabled { opacity: .5; cursor: default; }
  .send svg { width: 13px; height: 13px; fill: currentColor; }
  .problem { margin: 0 0 8px; color: var(--yellow); font-family: var(--sans); }
</style>

<script>
  import { theBoard } from '../../lib/board/board';
  import { createConnection, type ConnectionView } from '../../lib/board/connection';
  import { modelAnswering } from '../../lib/board/models';
  import { thePick } from '../../lib/board/pick';
  import type { SketchName } from '../../lib/board/names';
  import type { Manifest } from '../../lib/flash';
  import { paintAction } from './actionButton';
  import { mountDockMonitor } from './dockMonitor';
  import { paintFlashRail, paintHandHint } from './flashRail';

  // The dock persists from page to page, so this runs once, on the first page the visitor opens.
  const dock = document.querySelector<HTMLElement>('[data-board-dock]');
  if (dock !== null && dock.dataset.mounted === undefined) {
    dock.dataset.mounted = '';
    mountDock(dock);
  }

  function mountDock(dock: HTMLElement) {
    const names: Record<string, SketchName> = JSON.parse(dock.dataset.names ?? '{}');
    const manifest: Manifest = JSON.parse(dock.dataset.manifest ?? '{"sketches":{}}');
    const board = theBoard();
    const { session } = board;
    board.know(manifest);

    const find = <E extends Element>(name: string) => dock.querySelector<E>(`[data-dock-${name}]`)!;
    const monitor = mountDockMonitor(dock, board);
    const dot = find<HTMLElement>('dot');
    const chip = find<HTMLElement>('chip');
    const link = find<HTMLAnchorElement>('link');
    const doing = find<HTMLElement>('doing');
    const sketch = find<HTMLElement>('sketch');
    const meter = find<HTMLElement>('meter');
    const track = find<HTMLElement>('track');
    const fill = find<HTMLElement>('fill');
    const pct = find<HTMLElement>('pct');
    const last = find<HTMLElement>('last');
    const disconnect = find<HTMLButtonElement>('disconnect');
    const status = find<HTMLElement>('status');
    const said = find<HTMLElement>('said');
    const panel = find<HTMLElement>('panel');
    const message = find<HTMLElement>('message');
    const panelAction = dock.querySelector<HTMLButtonElement>('[data-dock-action="panel"]')!;
    const barAction = dock.querySelector<HTMLButtonElement>('[data-dock-action="bar"]')!;
    const connectAction = dock.querySelector<HTMLButtonElement>('[data-dock-action="connect"]')!;

    const pick = thePick();
    const connection = createConnection(board, pick, names);
    const select = find<HTMLSelectElement>('pick');
    select.value = pick.model?.id ?? '';
    select.addEventListener('change', () => {
      pick.choose(select.value || undefined);
    });
    // The connection paints the dock on a new pick, since its hints follow the pick.
    pick.subscribe(() => {
      select.value = pick.model?.id ?? '';
    });

    /** Once a board answers, its chip is certain: the pick follows it. */
    function followChip() {
      const state = session.state;
      if (!('chip' in state)) return;
      const answering = modelAnswering(pick.model, state.chip);
      if (answering !== undefined && answering !== pick.model) pick.choose(answering.id);
    }

    for (const action of [panelAction, barAction]) action.addEventListener('click', () => void connection.press());
    connectAction.addEventListener('click', () => void connection.pressConnect());
    disconnect.addEventListener('click', () => void connection.disconnect());

    function render() {
      const view = connection.view;
      const { bar } = view;
      dock.hidden = !bar.shown;
      if (!bar.shown) return;
      dot.classList.toggle('on', bar.connected);
      // Set only on a change, since what the board does is a live region.
      const linked = bar.path !== undefined;
      const name = bar.sketch ?? '';
      if (
        chip.textContent !== bar.chip ||
        doing.textContent !== bar.doing ||
        link.hidden === linked ||
        (linked ? link.textContent : sketch.textContent) !== name
      ) {
        chip.textContent = bar.chip;
        doing.textContent = bar.doing;
        link.hidden = !linked;
        link.textContent = linked ? name : '';
        sketch.textContent = linked ? '' : name;
      }
      if (linked) link.href = bar.path!;
      meter.hidden = bar.progress === undefined;
      if (bar.progress !== undefined) {
        track.setAttribute('aria-valuenow', String(bar.progress));
        fill.style.width = `${bar.progress}%`;
        pct.textContent = `${bar.progress}%`;
      }
      last.textContent = bar.last ?? '';
      paintPanel(view);
      if (!bar.disconnect && document.activeElement === disconnect) dock.focus();
      disconnect.toggleAttribute('data-off', !bar.disconnect);
      // The full status where two lines cut it.
      if (said.scrollHeight > said.clientHeight) status.title = said.textContent ?? '';
      else status.removeAttribute('title');
      monitor.show(bar.canSend);
    }

    /** Paints the panel and the one action, in the panel while it is open, else in the bar. */
    function paintPanel({ action, connect, panel: told, scene }: ConnectionView) {
      const open = told !== undefined;
      const focused = [panelAction, barAction, connectAction].includes(document.activeElement as HTMLButtonElement);
      panel.hidden = !open;
      paintFlashRail(panel, scene);
      paintHandHint(panel, scene.hint);
      // Set only on a change, since the message is a live region.
      if (message.textContent !== (told?.text ?? '')) message.textContent = told?.text ?? '';
      message.toggleAttribute('data-notice', told?.notice ?? false);
      panelAction.hidden = action === undefined || !open;
      // The bar's button keeps its room, so the controls after it stay in place.
      barAction.toggleAttribute('data-off', action === undefined || open);
      if (action !== undefined) for (const button of [panelAction, barAction]) paintAction(button, action);
      connectAction.toggleAttribute('data-off', connect === undefined || open);
      if (connect !== undefined) paintAction(connectAction, connect);
      // The focus follows the action between the bar and the panel; with no action, the dock keeps it.
      if (focused) {
        const shown = open ? panelAction : barAction;
        if (shown.hidden || shown.hasAttribute('data-off')) dock.focus();
        else if (document.activeElement !== shown) shown.focus();
      }
    }

    board.subscribe(followChip);
    connection.subscribe(render);
    render();
  }
</script>
