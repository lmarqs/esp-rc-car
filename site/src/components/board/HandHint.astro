---
/**
 * What the visitor does with their hands to get a board to answer, drawn beside the words that say it: the BOOT button
 * held down, or the adapter's switch sliding to PROG or to UART. `paintHandHint` picks which, or hides it.
 */
---

<span class="hand-hint" data-hand-hint hidden>
<svg viewBox="0 0 64 40" aria-hidden="true">
  <g class="switch">
    <rect class="track" x="9" y="6" width="46" height="18" rx="9"></rect>
    <circle class="knob" cx="20" cy="15" r="6"></circle>
    <text class="prog" x="20" y="36" text-anchor="middle">PROG</text>
    <text class="uart" x="44" y="36" text-anchor="middle">UART</text>
  </g>
  <g class="boot">
    <rect class="track" x="16" y="18" width="32" height="12" rx="3"></rect>
    <rect class="cap" x="24" y="12" width="16" height="8" rx="2"></rect>
    <text class="to" x="32" y="39" text-anchor="middle">BOOT</text>
  </g>
</svg>
</span>

<style>
  .hand-hint { display: block; width: 56px; height: 35px; flex: none; }
  .hand-hint[hidden] { display: none; }
  svg { display: block; width: 100%; height: 100%; }
  .track { fill: var(--card); stroke: var(--ink); stroke-width: 2; }
  .knob, .cap { fill: var(--coral); stroke: var(--ink); stroke-width: 2; }
  text { font: 700 8px var(--mono); fill: var(--muted); }
  .to, [data-hint="prog"] .prog, [data-hint="uart"] .uart { fill: var(--ink); }
  .switch, .boot { display: none; }
  [data-hint="prog"] .switch, [data-hint="uart"] .switch, [data-hint="boot"] .boot { display: inline; }
  /* The knob starts on the side it is not to end on, and slides across. */
  [data-hint="prog"] .knob { animation: to-prog 1.4s ease-in-out infinite; }
  [data-hint="uart"] .knob { transform: translateX(24px); animation: to-uart 1.4s ease-in-out infinite; }
  @keyframes to-prog { 0%, 20% { transform: translateX(24px); } 60%, 100% { transform: translateX(0); } }
  @keyframes to-uart { 0%, 20% { transform: translateX(0); } 60%, 100% { transform: translateX(24px); } }
  [data-hint="boot"] .cap { animation: press 1.2s ease-in-out infinite; }
  @keyframes press { 0%, 100% { transform: translateY(-3px); } 50% { transform: translateY(1px); } }
  @media (prefers-reduced-motion: reduce) { .knob, .cap { animation: none !important; } }
</style>
