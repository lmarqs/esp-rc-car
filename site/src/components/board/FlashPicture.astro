---
/**
 * The visitor's desk during a flash: the computer, the cable and the board's chip, with the steps Find, Write and
 * Restart named under them. `paintFlashPicture` draws a `FlashScene` in it. The default slot hangs above the cable, tied
 * to it: the button that joins the computer to the board.
 */
const hasSlot = Astro.slots.has('default');
---

<div class="flash-picture" data-flash-picture data-cable="loose" data-chip="faint">
  {
    hasSlot && (
      <div class="slot">
        <slot />
        <i class="stem" aria-hidden="true" />
      </div>
    )
  }
  <div class="wire" aria-label="Flashing" aria-valuemin="0" aria-valuemax="100" data-flash-bar>
    <svg class="computer" viewBox="0 0 70 60" aria-hidden="true">
      <rect class="ink" x="12" y="8" width="46" height="30" rx="4"></rect>
      <path class="ink" d="M4 46h62l-5 8H9z"></path>
      <path class="tick" d="M27 23l6 6 11-12"></path>
    </svg>
    <svg class="cable" viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true">
      <path class="line" d="M0 46 C50 56 110 56 150 48 S185 30 200 30"></path>
      <path class="packets" d="M0 46 C50 56 110 56 150 48 S185 30 200 30"></path>
      <path class="ping" pathLength="100" d="M0 46 C50 56 110 56 150 48 S185 30 200 30"></path>
    </svg>
    <svg class="chip" viewBox="0 0 78 60" aria-hidden="true">
      <path class="pins" d="M6 16h8M6 30h8M6 44h8M64 16h8M64 30h8M64 44h8"></path>
      <rect class="body" x="14" y="6" width="50" height="48" rx="5"></rect>
      <rect class="level" x="16" y="52" width="46" height="0" rx="3" data-flash-level></rect>
      <rect class="edge" x="14" y="6" width="50" height="48" rx="5"></rect>
      <text class="unknown" x="39" y="35.5" text-anchor="middle">?</text>
      <text class="percent" x="39" y="35.5" text-anchor="middle" data-flash-percent></text>
    </svg>
    <span class="break" aria-hidden="true">✕</span>
  </div>
  {/* The words beside the picture say the same to a screen reader. */}
  <div class="steps" aria-hidden="true">
    <span data-flash-step data-mark="todo">Find</span>
    <span data-flash-step data-mark="todo">Write</span>
    <span data-flash-step data-mark="todo">Restart</span>
  </div>
</div>

<style>
  .flash-picture { --computer: 56px; --chip: 62px; position: relative; display: grid; gap: 2px; }
  /* Between the computer and the chip, above the cable's dip, with a stem down to the cable. */
  .slot { position: relative; z-index: 1; display: flex; justify-content: center; margin: 0 var(--chip) 4px var(--computer); }
  .stem { position: absolute; top: 100%; left: 50%; width: 2.6px; height: 12px; margin-left: -1.3px; background: var(--ink); pointer-events: none; }
  .stem::after { content: ""; position: absolute; bottom: -6px; left: 50%; width: 10px; height: 10px; margin-left: -5px; border-radius: 50%; background: var(--card); border: 2.6px solid var(--ink); box-sizing: border-box; }
  .wire { position: relative; display: grid; grid-template-columns: var(--computer) 1fr var(--chip); align-items: center; height: 48px; }
  .wire svg { width: 100%; height: 48px; display: block; overflow: visible; }
  .ink, .edge, .pins { stroke: var(--ink); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .ink, .body { fill: var(--card); }
  .edge, .pins { fill: none; }
  .tick { fill: none; stroke: var(--green); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .line { fill: none; stroke: var(--ink); stroke-width: 2.6; vector-effect: non-scaling-stroke; }
  /* Bytes running down the cable while the image is written. */
  .packets { fill: none; stroke: var(--yellow); stroke-width: 6; stroke-linecap: round; stroke-dasharray: 2 26; vector-effect: non-scaling-stroke; animation: flow .7s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -28; } }
  /* One dot down the cable and back while the page waits for the chip to answer. */
  .ping { fill: none; stroke: var(--blue); stroke-width: 7; stroke-linecap: round; stroke-dasharray: .01 200; vector-effect: non-scaling-stroke; animation: ping 1.1s ease-in-out infinite alternate; }
  @keyframes ping { to { stroke-dashoffset: -100; } }
  .level { fill: var(--blue); transition: height .15s, y .15s; }
  /* A light halo keeps the percentage readable over the fill. */
  text { font: 700 15px var(--mono); fill: var(--ink); paint-order: stroke; stroke: var(--card); stroke-width: 3px; stroke-linejoin: round; }
  .break { position: absolute; top: 50%; display: none; place-items: center; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; background: var(--card); border: 2.6px solid var(--coral); box-sizing: border-box; font: 700 12px/1 var(--sans); color: var(--coral-text); }

  .packets, .ping, .tick, .unknown, .percent { display: none; }
  [data-cable="loose"] .line { stroke: var(--faint); stroke-dasharray: 3 7; }
  [data-cable="loose"] .stem { background: var(--faint); }
  [data-cable="loose"] .stem::after { border-color: var(--faint); }
  [data-cable="ping"] .ping, [data-cable="packets"] .packets { display: inline; }
  [data-cable="broken"] .line { stroke: var(--coral); stroke-dasharray: 6 6; }
  [data-cable="broken"] .stem { background: var(--coral); }
  [data-cable="broken"] .stem::after { border-color: var(--coral); }
  [data-chip="faint"] .chip { opacity: .35; }
  [data-chip="unknown"] .edge { stroke-dasharray: 5 5; }
  [data-chip="unknown"] .pins { stroke: var(--faint); }
  [data-chip="unknown"] .unknown { display: inline; }
  [data-cable="ping"] .chip .edge { animation: wonder 1.1s ease-in-out infinite alternate; }
  @keyframes wonder { from { opacity: .35; } to { opacity: 1; } }
  [data-chip="known"] .tick, [data-fill] .percent { display: inline; }
  [data-fill="written"] .level { fill: var(--green); animation: blink .5s steps(2, jump-none) 3; }
  @keyframes blink { from { opacity: 1; } to { opacity: .3; } }
  [data-fill="failed"] .level { fill: var(--coral); }
  [data-fill="waiting"] .level { fill: var(--yellow); }
  [data-broken] .break { display: grid; }
  [data-broken="computer"] .break { left: calc(var(--computer) + 8px); }
  [data-broken="cable"] .break { left: calc(var(--computer) + (100% - var(--computer) - var(--chip)) / 2); }
  [data-broken="chip"] .break { left: calc(100% - var(--chip) - 8px); }
  [data-broken="chip"] .chip .edge { stroke: var(--coral); }
  [data-broken="chip"] .unknown { fill: var(--coral-text); }

  /* The wire's columns, so each step's word sits centred under the part it names, marked or not. */
  .steps { display: grid; grid-template-columns: var(--computer) 1fr var(--chip); justify-items: center; font-size: 12px; font-weight: 700; line-height: 1.5; color: var(--muted); white-space: nowrap; }
  [data-mark="done"] { color: var(--green-text); }
  [data-mark="now"] { color: var(--ink); background: linear-gradient(transparent 60%, var(--yellow) 60%); }
  [data-mark="failed"] { color: var(--coral-text); }
  @media (prefers-reduced-motion: reduce) { .packets, .ping, .edge, .level { animation: none !important; } }
</style>
