---
import type { HTMLAttributes } from 'astro/types';

/**
 * The dock's button for the board: a plug, a bolt, an arrow or a power symbol beside its word, and a spinner in their
 * place while the session works. `paintAction` writes what it says. It is solid yellow where it is the one thing to do,
 * and a ghost outline where it sits among the bar's controls. Its other attributes, such as the `data-` one a script
 * finds it by, go on the button.
 */
interface Props extends HTMLAttributes<'button'> {
  /** The word it opens with, before a script paints it. */
  label: string;
  /** The icon it opens with, before a script paints it. */
  icon?: 'plug' | 'bolt' | 'again' | 'power';
  /** An outline among the bar's controls, not the solid button. */
  ghost?: boolean;
}

const { label, icon = 'plug', ghost = false, ...attributes } = Astro.props;
---

<button class:list={['action', { ghost }]} type="button" data-icon={icon} {...attributes}>
  <svg class="i-plug" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M6 1.6v3M10 1.6v3M4 4.6h8v2.6a4 4 0 0 1-8 0zM8 11.2v3.2"></path>
  </svg>
  <svg class="i-bolt" viewBox="0 0 16 16" aria-hidden="true"><path d="M9.4 1 3.4 9.2h3.9L6.4 15l6.2-8.4H8.6z"></path></svg>
  <svg class="i-again" viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.5-3.6M13 2.5v3h-3"></path></svg>
  <svg class="i-power" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v5M4.6 4.2a5 5 0 1 0 6.8 0"></path></svg>
  <i class="spin" aria-hidden="true"></i>
  <span class="label" data-action-label>{label}</span>
</button>

<style>
  /* As wide as its longest fixed label, such as Connect board, so it keeps its width as its label changes; a sketch's name
     longer than that is cut, and read out whole. */
  .action { display: inline-flex; align-items: center; justify-content: center; gap: 6px; width: 164px; height: 32px; font: inherit; font-size: 13px; font-weight: 700; line-height: 1.5; white-space: nowrap; color: var(--ink); background: var(--yellow); border: 0; border-radius: 6px; cursor: pointer; }
  .action:hover { filter: brightness(1.08); }
  .action[hidden] { display: none; }
  .label { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  /* While the session works, the button says what it does and cannot be pressed: an outline with a spinner. */
  .action[aria-disabled="true"] { color: var(--on-ink); background: transparent; box-shadow: inset 0 0 0 1px var(--on-ink-edge); filter: none; cursor: default; }
  .action[data-off] { visibility: hidden; }
  .action:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .action svg { width: 14px; height: 14px; flex: none; }
  .action .i-plug path, .action .i-again path, .action .i-power path { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .action .i-bolt path { fill: currentColor; }
  .action:not([data-icon="plug"]) .i-plug, .action:not([data-icon="bolt"]) .i-bolt, .action:not([data-icon="again"]) .i-again, .action:not([data-icon="power"]) .i-power { display: none; }
  /* The bar's pill, as its other controls are. */
  .ghost { gap: 5px; font-size: 12px; color: var(--on-ink); background: transparent; border: 1px solid var(--on-ink-edge); border-radius: 999px; padding: 3px 11px; }
  .ghost:hover:not([aria-disabled="true"]) { filter: none; border-color: var(--yellow); color: var(--yellow); }
  .ghost[aria-disabled="true"] { box-shadow: none; }
  .ghost svg { width: 12px; height: 12px; }
  .action[aria-disabled="true"] svg { display: none; }
  .spin { display: none; width: 12px; height: 12px; flex: none; border-radius: 50%; border: 1.5px solid var(--on-ink-line); border-top-color: var(--yellow); box-sizing: border-box; animation: spin .8s linear infinite; }
  .action[aria-disabled="true"] .spin { display: block; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .spin { animation: none; } }
</style>
