---
import type { WorkbenchProject } from '../../lib/workbench/projects';
import type { RailStep } from './rail';
import Scope from './Scope.astro';
import Stage from './Stage.astro';
import Terminal from './Terminal.astro';
import { paneTag } from './view';

interface Props {
  project: WorkbenchProject<unknown, unknown, unknown>;
  steps: readonly Pick<RailStep, 'key' | 'hint' | 'placeholder' | 'shortcuts'>[];
  /** Whether any step has an image to flash, which gives the My board view its button. */
  flashable: boolean;
}

const { project, steps, flashable } = Astro.props;
const simulated = paneTag('simulator', { kind: 'simulated' }, undefined);
---

<div class="board">
  <div class="frame" data-frame data-mode="simulator">
    {/* One live region for the word and the sentence, so a change is read out once. */}
    <p class="tag" aria-live="polite" data-pane-tag>
      <b data-tag-word>{simulated.word}</b> <span data-tag-title>{simulated.title}</span>
    </p>
    <button class="mini" type="button" data-flash-again hidden>Flash again</button>
    <Stage project={project} firstKey={steps[0].key} flashable={flashable} />
    <Scope trace={project.trace} />
  </div>
  <Terminal steps={steps} placeholder={steps[0].placeholder} />
  <div class="say" data-say>
    {
      steps.map((step, index) => (
        <p class="hint" data-for-step={index} data-hint hidden={index !== 0}>
          {step.hint}
        </p>
      ))
    }
    <p class="problem" role="alert" data-problem hidden></p>
  </div>
</div>

<style>
  [hidden] { display: none !important; }
  .board { padding: 14px; display: grid; gap: 10px; align-content: start; min-width: 0; }
  /* Side by side, the board stays in view while the visitor reads down a long sketch; in a short window it would
     cover the window, so it scrolls with the page. */
  @media (min-width: 821px) and (min-height: 600px) { .board { position: sticky; top: 0; align-self: start; } }
  /* Dashed while the pane shows a stand-in for the board, solid green while it shows the board itself. */
  .frame { position: relative; display: grid; gap: 10px; margin-top: 8px; padding: 20px 12px 12px; border: 2px dashed var(--quiet); border-radius: 12px; }
  .frame[data-mode="live"] { border-style: solid; border-color: var(--green); }
  /* On the frame's top border, leaving room on the right for Flash again. */
  .tag { position: absolute; top: 0; left: 10px; max-width: calc(100% - 132px); transform: translateY(-50%); margin: 0; padding: 0 6px; background: var(--card); font-size: 12px; line-height: 1.5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tag b { font-weight: 700; }
  .frame[data-mode="live"] .tag b { color: var(--green-text); }
  .tag span { color: var(--muted); }
  .mini { position: absolute; top: 0; right: 10px; transform: translateY(-50%); font: inherit; font-size: 12px; font-weight: 700; line-height: 1.5; color: var(--ink); background: var(--card); border: 1.5px solid var(--ink); border-radius: 999px; padding: 1px 10px; cursor: pointer; }
  .mini:hover { background: var(--wash-yellow); }
  .mini:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  .hint { font-size: 13px; color: var(--muted); margin: 0; }
  /* A problem takes the hint's place, which says how to send and does not apply then, so nothing moves. */
  .say { display: grid; }
  .say > * { grid-area: 1 / 1; }
  .say[data-trouble] .hint { visibility: hidden; }
  .problem { margin: 0; padding: 8px 12px; border: 1.5px solid var(--ink); border-radius: 10px; font-size: 14px; font-weight: 600; }
</style>
