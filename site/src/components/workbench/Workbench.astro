---
import { OPENING, workbenchFor } from '../../lib/workbench/projects';
// Read here, at build time, only: a browser script that imported it would carry every sketch's source.
import { readStepSource } from '../../lib/workbench/readSource';
import { newLines } from '../../lib/workbench/source';
import { CLOCK_DASH, codeRows, crumbs, fileName, shortcutNames } from './view';

interface Props {
  /** The project's page id, such as `blink`; the project must have step definitions. */
  project: string;
  /** The project's steps from its page, in order. */
  steps: readonly { id: string; sketch: string; idea: string }[];
}

const { project, steps } = Astro.props;
const workbench = workbenchFor(project);
if (workbench === undefined) throw new Error(`The project ${project} has no step definitions for the workbench.`);

const sources = steps.map((step) => readStepSource(step.sketch));
const rail = steps.map((step, index) => {
  const definition = workbench.steps.find((candidate) => candidate.sketch === step.sketch);
  if (definition === undefined) throw new Error(`No step definition runs ${step.sketch} in the ${project} workbench.`);
  return {
    ...step,
    number: index + 1,
    key: definition.key,
    hint: definition.hint,
    shortcuts: shortcutNames(definition.shortcuts),
    file: fileName(step.sketch),
    crumbs: crumbs(step.sketch),
    rows: codeRows(sources[index], newLines(sources[index - 1], sources[index]), definition.live?.name),
  };
});
const first = rail[0];
const openingRows = workbench.board.watch(first.key, workbench.board.initial(), 0);
const valueOf = (name: string) => openingRows.find((row) => row.name === name)?.value;
const stepData = JSON.stringify(rail.map((step, index) => ({ key: step.key, source: sources[index] })));
const id = (part: string) => `workbench-${project}-${part}`;
---

<section class="bench" aria-label="Workbench" data-workbench data-project={project} data-steps={stepData}>
  <div class="rail" role="tablist" aria-label="Steps">
    {
      rail.map((step, index) => (
        <button
          class="tab"
          type="button"
          role="tab"
          id={id(`tab-${step.id}`)}
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={id('panel')}
          tabindex={index === 0 ? 0 : -1}
          data-tab={index}
        >
          <span class="n">
            {step.number} {step.id}
          </span>
          <small>{step.idea}</small>
        </button>
      ))
    }
  </div>
  <div class="panes" role="tabpanel" id={id('panel')} aria-labelledby={id(`tab-${first.id}`)}>
    <div class="code">
      <div class="edhead">
        {
          rail.map((step, index) => (
            <span class="edtab" data-for-step={index} hidden={index !== 0}>
              {step.file}
            </span>
          ))
        }
        <span class="dbg" role="toolbar" aria-label="Debugger">
          <span class="seg">
            <button type="button" class:list={['pause', { 'is-paused': !OPENING.running }]} data-pause>
              <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3h3v10H4zM9 3h3v10H9z" /></svg>
              <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" /></svg>
              <span data-pause-label>{OPENING.running ? 'Pause' : 'Continue'}</span>
            </button>
            <button type="button" data-step title="Run one line">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path class="stroke" d="M2.6 8.2a5.4 5.4 0 0 1 10-3" /><path d="M13.8 1.8v4.2H9.6z" /><circle cx="8" cy="12.2" r="1.9" />
              </svg>
              Step
            </button>
            <button type="button" data-restart title="Start the sketch again from the top">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path class="stroke" d="M12.6 8a4.6 4.6 0 1 1-1.7-3.5" /><path d="M11.6 1.4v3.9H7.7z" />
              </svg>
              Restart
            </button>
          </span>
          <button type="button" class="toggle" data-slow aria-pressed={String(OPENING.slow)} title="Rest half a second on each line">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <circle class="stroke" cx="8" cy="8" r="5.8" /><path class="stroke" d="M8 4.8V8l2.3 1.5" />
            </svg>
            Slow
          </button>
        </span>
      </div>
      {
        rail.map((step, index) => (
          <div class="crumbs" data-for-step={index} hidden={index !== 0}>
            {step.crumbs.map((crumb, at) => (at === 0 ? crumb : [<span class="sep"> › </span>, crumb]))}
          </div>
        ))
      }
      <div class="edbody">
        {
          rail.map((step, index) => (
            <div class="lines" data-for-step={index} data-code hidden={index !== 0}>
              {step.rows.map((row) => (
                <div class:list={['ln', { new: row.isNew }]} data-line={row.number}>
                  <b class="pc" aria-hidden="true" />
                  <i>{row.number}</i>
                  <span>
                    {row.tokens.map((token, at) =>
                      at === row.live ? (
                        <span class="live" data-live>
                          {token.text}
                        </span>
                      ) : token.kind ? (
                        <span class={token.kind}>{token.text}</span>
                      ) : (
                        token.text
                      ),
                    )}
                    {row.waits && (
                      <svg class="pie" viewBox="0 0 16 16" aria-hidden="true" data-pie>
                        <circle class="rim" cx="8" cy="8" r="7" />
                        <circle class="fill" cx="8" cy="8" r="3.5" pathLength={CLOCK_DASH} />
                      </svg>
                    )}
                  </span>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
    <div class="board">
      <div class="led-row">
        <svg class="led" viewBox="40 0 140 150" role="img" aria-label="An LED on GPIO 2" data-picture>
          <circle class="halo" cx="110" cy="70" r="56" />
          <g class="rays"><path d="M110 10 v-8 M150 24 l7 -7 M70 24 l-7 -7 M166 62 h9 M54 62 h-9" /></g>
          <path class="bulb ink" d="M88 66 a22 22 0 0 1 44 0 v22 h-44 Z" />
          <rect class="base ink" x="82" y="88" width="56" height="9" rx="3" />
          <path class="ink" fill="none" d="M100 97 v34 M120 97 v26" />
        </svg>
        <dl class="watch" aria-label="Watch">
          {
            workbench.board.fields.map((name) => (
              <div data-watch-row={name} hidden={valueOf(name) === undefined}>
                <dt>{name}</dt>
                <dd>{valueOf(name)}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="term">
        <pre class="serial" role="log" aria-live="off" aria-label="Serial output" data-serial></pre>
        <div data-shortcuts={first.shortcuts} hidden></div>
      </div>
      <p class="problem" role="alert" data-problem hidden></p>
      {
        rail.map((step, index) => (
          <p class="hint" data-for-step={index} data-hint hidden={index !== 0}>
            {step.hint}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  .bench { background: var(--card); border: var(--stroke); border-radius: var(--radius); margin: 12px 0 24px; overflow: hidden; }
  .bench [hidden] { display: none !important; }

  .rail { display: flex; flex-wrap: wrap; border-bottom: var(--stroke); background: var(--chrome-light); }
  .tab { font: inherit; font-size: 16px; line-height: 1.5; color: var(--ink); border: 0; border-right: 1px solid var(--line); background: transparent; padding: 10px 16px; cursor: pointer; text-align: left; flex: 1 1 150px; }
  .tab .n { font-family: var(--mono); font-weight: 700; display: block; }
  .tab small { color: var(--muted); font-size: 12px; }
  .tab[aria-selected="true"] { background: var(--yellow); }
  /* Inset, since the bench clips what falls outside it. */
  .tab:focus-visible { outline: 3px solid var(--blue); outline-offset: -3px; }

  .panes { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
  @media (max-width: 820px) { .panes { grid-template-columns: minmax(0, 1fr); } }

  .code { display: flex; flex-direction: column; min-width: 0; border-right: 1px solid var(--line); font-family: var(--mono); font-size: 13.5px; line-height: 1.7; }
  @media (max-width: 820px) { .code { border-right: 0; border-bottom: 1px solid var(--line); } }
  .edhead { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; background: var(--chrome); }
  .edtab { display: flex; align-items: center; gap: 8px; background: var(--card); border-right: 1px solid var(--line); box-shadow: inset 0 2px 0 var(--coral); padding: 8px 16px 7px; font-size: 13px; }
  .edtab::before { content: "C"; font-weight: 800; font-size: 11px; color: var(--syntax-function); }
  .dbg { margin-left: auto; display: flex; gap: 8px; align-items: center; padding: 4px 8px; font-family: var(--sans); }
  .dbg button { font: inherit; font-size: 13px; font-weight: 600; line-height: 1.5; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 4px 10px; margin: 0; color: var(--ink); background: var(--card); border: 1px solid var(--edge); border-radius: 0; cursor: pointer; }
  .dbg button:hover:not(:disabled) { background: var(--wash-yellow); }
  .dbg button:disabled { opacity: .45; cursor: default; }
  .dbg button:focus-visible { outline: 2px solid var(--coral); outline-offset: 1px; position: relative; }
  .dbg svg { width: 15px; height: 15px; flex: none; fill: currentColor; }
  .dbg svg .stroke { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; }
  .seg { display: inline-flex; }
  .seg button + button { border-left: 0; }
  .seg button:first-child { border-radius: 7px 0 0 7px; }
  .seg button:last-child { border-radius: 0 7px 7px 0; }
  /* As wide as Continue, so the button keeps its width when its word changes. */
  .pause { width: 108px; }
  .pause .i-play, .pause.is-paused .i-pause { display: none; }
  .pause.is-paused .i-play { display: inline; color: var(--green); }
  .dbg .toggle { border-radius: 7px; }
  .dbg .toggle[aria-pressed="true"] { background: var(--ink); color: var(--card); border-color: var(--ink); }
  @media (max-width: 480px) {
    .dbg { flex-wrap: wrap; gap: 6px; padding: 4px; }
    .dbg button { padding: 4px 7px; }
  }
  .crumbs { font-size: 12px; color: var(--muted); padding: 5px 14px 2px 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .crumbs .sep { color: var(--faint); white-space: pre; }
  .edbody { flex: 1; padding: 4px 0 14px; overflow-x: auto; }
  /* As wide as the longest line, so a tinted row reaches the editor's edge even when the code scrolls. */
  .lines { min-width: 100%; width: max-content; }
  .ln { display: grid; grid-template-columns: 22px 30px 1fr; white-space: pre; padding-right: 14px; border-left: 4px solid transparent; }
  .ln.new { background: var(--wash-yellow); }
  .ln .pc { color: var(--coral); font-size: 12px; text-align: center; }
  .ln i { color: var(--faint); font-style: normal; text-align: right; padding-right: 10px; margin-right: 1px; user-select: none; }
  .ln > span { padding-left: 8px; }
  .ln[data-running] { background: var(--tint-coral); border-left-color: var(--coral); }
  .ln[data-running] i { color: var(--ink); font-weight: 700; }
  .ln[data-running] .pc::before { content: "▶"; }
  .pie { width: 16px; height: 16px; vertical-align: -3px; margin-left: 10px; transform: rotate(-90deg); }
  .pie .rim { fill: var(--card); stroke: var(--faint); stroke-width: 1.5; }
  .pie .fill { fill: none; stroke: var(--coral); stroke-width: 7; stroke-dasharray: 0 100; }
  .pie.waiting .rim { stroke: var(--coral); }
  .keyword { color: var(--syntax-keyword); }
  .string { color: var(--syntax-string); }
  .function { color: var(--syntax-function); }
  .number { color: var(--syntax-number); }
  .comment { color: var(--muted); }
  /* Room for four bold digits, the most the interval has, so the line keeps its width as the value changes. */
  .live { display: inline-block; min-width: calc(4.5ch + 10px); padding: 0 5px; text-align: center; background: var(--yellow); border-radius: 6px; font-weight: 700; }

  .board { padding: 14px; display: grid; gap: 10px; align-content: start; min-width: 0; }
  .led-row { display: grid; grid-template-columns: 96px 1fr 1fr; gap: 12px; align-items: center; }
  @media (max-width: 480px) { .led-row { grid-template-columns: 96px 1fr; } }
  .led { width: 100%; }
  .halo { fill: var(--tint-green); }
  .rays { stroke: var(--green); stroke-width: 2.6; stroke-linecap: round; opacity: 0; transition: opacity .08s; }
  .bulb { fill: var(--led-off); transition: fill .08s; }
  .base { fill: var(--card); }
  .led.on .bulb { fill: var(--green); }
  .led.on .rays { opacity: 1; }
  .watch { margin: 0; border: 1px solid var(--line); border-radius: 10px; font-family: var(--mono); font-size: 13px; overflow: hidden; }
  .watch div { display: flex; justify-content: space-between; gap: 10px; padding: 3px 10px; }
  .watch div + div { border-top: 1px solid var(--line); }
  .watch dt { color: var(--muted); }
  .watch dd { margin: 0; padding: 0 4px; border-radius: 4px; font-weight: 700; }
  .watch dd[data-changed] { background: var(--yellow); }

  .term { background: var(--ink); color: var(--on-ink); border-radius: 12px; font-family: var(--mono); font-size: 13px; overflow: hidden; }
  /* Six lines of 1.5em, as many as serialText keeps, plus the padding. */
  .serial { margin: 0; padding: 10px 14px 6px; height: calc(6 * 1.5em + 16px); overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; white-space: pre; background: none; color: inherit; border-radius: 0; font-size: 13px; line-height: 1.5; }
  .hint { font-size: 13px; color: var(--muted); margin: 0; }
  .problem { margin: 0; padding: 8px 12px; border: 1.5px solid var(--ink); border-radius: 10px; font-size: 14px; font-weight: 600; }
</style>

<script>
  import { OPENING, workbenchFor, openRunner } from '../../lib/workbench/projects';
  import type { Runner, RunnerView } from '../../lib/workbench/simulator';
  import { lineNumber } from '../../lib/workbench/source';
  import { tabAfterKey } from '../../lib/workbench/tabs';
  import type { WatchRow } from '../../lib/workbench/board';
  import type { StepDefinition } from '../../lib/workbench/step';
  import { changedRows, CLOCK_DASH, clockFace, debuggerControls, serialText, shortcutNames } from './view';

  /** How long a watch value stays highlighted after it changes. */
  const HIGHLIGHT_MS = 900;

  interface StepData {
    key: string;
    source: string;
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-workbench]')) mount(root);

  function mount(root: HTMLElement) {
    const project = workbenchFor(root.dataset.project ?? '');
    if (project === undefined) return;
    const steps: StepData[] = JSON.parse(root.dataset.steps ?? '[]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = root.querySelector<HTMLElement>('[role="tabpanel"]')!;
    const perStep = [...root.querySelectorAll<HTMLElement>('[data-for-step]')];
    const picture = root.querySelector<SVGElement>('[data-picture]')!;
    const watchRows = new Map(
      [...root.querySelectorAll<HTMLElement>('[data-watch-row]')].map((row) => [row.dataset.watchRow!, row]),
    );
    const serial = root.querySelector<HTMLElement>('[data-serial]')!;
    const shortcuts = root.querySelector<HTMLElement>('[data-shortcuts]')!;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const pauseButton = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const pauseLabel = root.querySelector<HTMLElement>('[data-pause-label]')!;
    const stepButton = root.querySelector<HTMLButtonElement>('[data-step]')!;
    const restartButton = root.querySelector<HTMLButtonElement>('[data-restart]')!;
    const slowButton = root.querySelector<HTMLButtonElement>('[data-slow]')!;
    const problem = root.querySelector<HTMLElement>('[data-problem]')!;

    let selected = 0;
    let definition: StepDefinition<unknown, unknown> | undefined;
    // The watch panel as last painted; undefined after a reset, so the values it starts with are not highlighted.
    let shownRows: readonly WatchRow[] | undefined;
    const highlightTimers = new Map<string, number>();
    let runner: Runner<unknown> | undefined;
    let view: RunnerView<unknown> | undefined;
    let board: unknown;
    let frame = 0;
    let slow: boolean = OPENING.slow;
    // Whether the visitor wants the sketch running: Pause and Step stop it, Continue and a tab pick start it.
    let keepRunning: boolean = OPENING.running;

    function select(index: number) {
      selected = index;
      const step = steps[index];
      const chosen = project!.steps.find((candidate) => candidate.key === step.key)!;
      definition = chosen;
      tabs.forEach((tab, at) => {
        tab.setAttribute('aria-selected', String(at === index));
        tab.tabIndex = at === index ? 0 : -1;
      });
      panel.setAttribute('aria-labelledby', tabs[index].id);
      for (const element of perStep) element.hidden = element.dataset.forStep !== String(index);
      shortcuts.dataset.shortcuts = shortcutNames(chosen.shortcuts);
      resetWatch();

      runner?.dispose();
      board = project!.board.initial();
      keepRunning = OPENING.running;
      runner = openRunner(
        chosen,
        (next, effects) => {
          board = project!.board.simulate(board, next.state, effects, next.millis);
          view = next;
          draw();
        },
        { slow },
      );
      view = runner.view();
      draw();
    }

    function draw() {
      if (frame === 0) frame = requestAnimationFrame(paint);
    }

    function paint() {
      frame = 0;
      if (view === undefined) return;
      const step = steps[selected];
      picture.classList.toggle('on', project!.board.lit(board));
      const rows = project!.board.watch(step.key, board, view.millis);
      for (const [name, element] of watchRows) {
        const row = rows.find((candidate) => candidate.name === name);
        element.hidden = row === undefined;
        if (row !== undefined) element.querySelector('dd')!.textContent = row.value;
      }
      for (const name of changedRows(shownRows, rows, project!.board.steady)) highlight(name);
      shownRows = rows;
      serial.textContent = serialText(view.output);
      const controls = debuggerControls(view.status, view.error);
      pauseButton.classList.toggle('is-paused', controls.paused);
      pauseLabel.textContent = controls.label;
      pauseButton.disabled = !controls.canContinue;
      stepButton.disabled = !controls.canStep;
      slowButton.setAttribute('aria-pressed', String(view.slow));
      problem.hidden = controls.problem === undefined;
      problem.textContent = controls.problem ?? '';
      const running = view.line === undefined ? undefined : lineNumber(step.source, view.line, view.occurrence);
      const code = root.querySelector<HTMLElement>(`[data-code][data-for-step="${selected}"]`)!;
      const live = code.querySelector('[data-live]');
      if (live !== null && definition?.live !== undefined) live.textContent = definition.live.value(view.state);
      const before = code.querySelector('[data-running]');
      const row = running === undefined ? null : code.querySelector(`[data-line="${running}"]`);
      if (before !== row) {
        before?.removeAttribute('data-running');
        row?.setAttribute('data-running', '');
        if (before !== null) showClock(before.querySelector('[data-pie]'), { waiting: false, fill: 0 });
      }
      const face = clockFace(view, runner?.progress() ?? 0, reducedMotion.matches);
      showClock(row?.querySelector('[data-pie]') ?? null, face);
      // The clock fills between the runner's notifications, so it is painted on every frame while it waits.
      if (face.waiting && !reducedMotion.matches) draw();
    }

    /** Marks a watch value that just changed for a moment. */
    function highlight(name: string) {
      const value = watchRows.get(name)?.querySelector('dd');
      if (value == null) return;
      value.setAttribute('data-changed', '');
      clearTimeout(highlightTimers.get(name));
      highlightTimers.set(name, window.setTimeout(() => value.removeAttribute('data-changed'), HIGHLIGHT_MS));
    }

    function resetWatch() {
      shownRows = undefined;
      for (const timer of highlightTimers.values()) clearTimeout(timer);
      highlightTimers.clear();
      for (const row of watchRows.values()) row.querySelector('dd')?.removeAttribute('data-changed');
    }

    function showClock(pie: Element | null, face: { waiting: boolean; fill: number }) {
      if (pie === null) return;
      pie.classList.toggle('waiting', face.waiting);
      const fill = pie.querySelector<SVGElement>('.fill')!;
      fill.style.strokeDasharray = `${face.fill * CLOCK_DASH} ${CLOCK_DASH}`;
    }

    pauseButton.addEventListener('click', () => {
      if (runner?.view().status === 'running') {
        keepRunning = false;
        runner.pause();
      } else {
        keepRunning = true;
        runner?.run();
      }
    });
    stepButton.addEventListener('click', () => {
      keepRunning = false;
      runner?.step();
    });
    restartButton.addEventListener('click', () => {
      if (runner === undefined) return;
      board = project!.board.initial();
      resetWatch();
      runner.restart();
      // The runner keeps running or paused, and comes back paused from an end or an error.
      if (keepRunning) runner.run();
    });
    slowButton.addEventListener('click', () => {
      slow = !slow;
      runner?.setSlow(slow);
    });

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        if (index !== selected) select(index);
      });
      tab.addEventListener('keydown', (event) => {
        const next = tabAfterKey(event.key, index, tabs.length);
        if (next === undefined) return;
        event.preventDefault();
        tabs[next].focus();
        if (next !== selected) select(next);
      });
    });

    select(0);
  }
</script>
