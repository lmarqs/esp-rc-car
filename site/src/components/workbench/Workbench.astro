---
import { OPENING, workbenchFor } from '../../lib/workbench/projects';
import { TRACE_HEIGHT, TRACE_WINDOW_MS } from '../../lib/workbench/trace';
// Read here, at build time, only: a browser script that imported it would carry every sketch's source.
import { readStepSource } from '../../lib/workbench/readSource';
import { newLines } from '../../lib/workbench/source';
import { readManifest } from '../../lib/flash/readManifest';
import { wording } from '../../lib/flash';
import { boardStatusText, CLOCK_DASH, codeRows, crumbs, fileName, SERIAL_LINES } from './view';

interface Props {
  /** The project's page id, such as `blink`; the project must have step definitions. */
  project: string;
  /** The project's steps from its page, in order. */
  steps: readonly { id: string; sketch: string; idea: string }[];
  /** The speed the steps print at, which the page reads the visitor's board at. */
  baud?: number;
}

const { project, steps, baud } = Astro.props;
const workbench = workbenchFor(project);
if (workbench === undefined) throw new Error(`The project ${project} has no step definitions for the workbench.`);

const sources = steps.map((step) => readStepSource(step.sketch));
const rail = steps.map((step, index) => {
  const definition = workbench.steps.find((candidate) => candidate.sketch === step.sketch);
  if (definition === undefined) throw new Error(`No step definition runs ${step.sketch} in the ${project} workbench.`);
  return {
    ...step,
    number: index + 1,
    key: definition.key,
    hint: definition.hint,
    placeholder: definition.placeholder,
    shortcuts: definition.shortcuts,
    file: fileName(step.sketch),
    crumbs: crumbs(step.sketch),
    rows: codeRows(sources[index], newLines(sources[index - 1], sources[index]), definition.live?.name),
  };
});
const first = rail[0];
const openingRows = workbench.board.watch(first.key, workbench.board.initial(), 0);
const valueOf = (name: string) => openingRows.find((row) => row.name === name)?.value;
const stepData = JSON.stringify(rail.map((step, index) => ({ key: step.key, source: sources[index] })));
const id = (part: string) => `workbench-${project}-${part}`;
const firmware = readManifest().sketches;
// Only the steps' images, so the page does not carry the whole manifest.
const manifest = {
  sketches: Object.fromEntries(rail.flatMap((step) => (firmware[step.key] ? [[step.key, firmware[step.key]]] : []))),
};
const flashable = Object.keys(manifest.sketches).length > 0;
const simulated = boardStatusText({ kind: 'simulated' });
// The notice is drawn with the longest keys while hidden, so it holds its height whichever keys it names.
const longestKey = rail.map((step) => step.key).reduce((longest, key) => (key.length > longest.length ? key : longest));
---

<section
  class="bench"
  aria-label="Workbench"
  data-workbench
  data-project={project}
  data-steps={stepData}
  data-manifest={JSON.stringify(manifest)}
  data-baud={baud}
>
  <div class="rail">
    <div class="tabs" role="tablist" aria-label="Steps">
      {
        rail.map((step, index) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={id(`tab-${step.id}`)}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={id('panel')}
            tabindex={index === 0 ? 0 : -1}
            data-tab={index}
          >
            <span class="n">
              {step.number} {step.id}
            </span>
            <small>{step.idea}</small>
          </button>
        ))
      }
    </div>
    <div class="railend">
      <span class="cell" data-board-cell data-status="simulated">
        <svg class="cpu" viewBox="0 0 24 24" aria-hidden="true">
          <path
            class="pins"
            d="M9 2.5v3M12 2.5v3M15 2.5v3M9 18.5v3M12 18.5v3M15 18.5v3M2.5 9h3M2.5 12h3M2.5 15h3M18.5 9h3M18.5 12h3M18.5 15h3"
          />
          <rect class="body" x="5.5" y="5.5" width="13" height="13" rx="2" />
          <rect class="core" x="9" y="9" width="6" height="6" rx="1" />
        </svg>
        <span class="name">Board</span>
        <small class="status" aria-live="polite" title={simulated.title} data-board-status>
          <span data-board-word>{simulated.word}</span><span class="sr" data-board-sentence>: {simulated.title}</span>
        </small>
      </span>
      {
        flashable && (
          <button class="connbtn" type="button" data-icon="plug" data-board-action>
            <svg class="i-plug" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M6 1.6v3M10 1.6v3M4 4.6h8v2.6a4 4 0 0 1-8 0zM8 11.2v3.2" />
            </svg>
            <svg class="i-bolt" viewBox="0 0 16 16" aria-hidden="true"><path d="M9.4 1 3.4 9.2h3.9L6.4 15l6.2-8.4H8.6z" /></svg>
            <svg class="i-back" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.2 2.6 2.6 6.2l3.6 3.6M3 6.2h6.4a3.6 3.6 0 0 1 0 7.2H7.4" /></svg>
            <span data-board-action-label>Connect</span>
          </button>
        )
      }
      {/* What to do fits the button's slot; why is in the tooltip and read by a screen reader. */}
      <p class="needs" title={wording.NO_WEB_SERIAL} data-needs-browser hidden>
        <span class="sr">{wording.NO_WEB_SERIAL} </span>{wording.USE_CHROME_OR_EDGE}
      </p>
    </div>
  </div>
  <div class="panes" role="tabpanel" id={id('panel')} aria-labelledby={id(`tab-${first.id}`)}>
    <div class="code">
      <div class="edhead">
        {
          rail.map((step, index) => (
            <span class="edtab" data-for-step={index} hidden={index !== 0}>
              {step.file}
            </span>
          ))
        }
        <span class="dbg" role="toolbar" aria-label="Debugger">
          <span class="seg">
            <button type="button" class:list={['pause', { 'is-paused': !OPENING.running }]} data-pause>
              <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3h3v10H4zM9 3h3v10H9z" /></svg>
              <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" /></svg>
              <span data-pause-label>{OPENING.running ? 'Pause' : 'Continue'}</span>
            </button>
            <button type="button" data-step title="Run one line">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path class="stroke" d="M2.6 8.2a5.4 5.4 0 0 1 10-3" /><path d="M13.8 1.8v4.2H9.6z" /><circle cx="8" cy="12.2" r="1.9" />
              </svg>
              Step
            </button>
            <button type="button" data-restart title="Start the sketch again from the top">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path class="stroke" d="M12.6 8a4.6 4.6 0 1 1-1.7-3.5" /><path d="M11.6 1.4v3.9H7.7z" />
              </svg>
              Restart
            </button>
          </span>
          <button type="button" class="toggle" data-slow aria-pressed={String(OPENING.slow)} title="Rest half a second on each line">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <circle class="stroke" cx="8" cy="8" r="5.8" /><path class="stroke" d="M8 4.8V8l2.3 1.5" />
            </svg>
            Slow
          </button>
        </span>
      </div>
      {
        rail.map((step, index) => (
          <div class="crumbs" data-for-step={index} hidden={index !== 0}>
            {step.crumbs.map((crumb, at) => (at === 0 ? crumb : [<span class="sep"> › </span>, crumb]))}
          </div>
        ))
      }
      <div class="edbody">
        {
          rail.map((step, index) => (
            <div class="lines" data-for-step={index} data-code hidden={index !== 0}>
              {step.rows.map((row) => (
                <div class:list={['ln', { new: row.isNew }]} data-line={row.number}>
                  <b class="pc" aria-hidden="true" />
                  <i>{row.number}</i>
                  <span>
                    {row.tokens.map((token, at) =>
                      at === row.live ? (
                        <span class="live" data-live>
                          {token.text}
                        </span>
                      ) : token.kind ? (
                        <span class={token.kind}>{token.text}</span>
                      ) : (
                        token.text
                      ),
                    )}
                    {row.waits && (
                      <svg class="pie" viewBox="0 0 16 16" aria-hidden="true" data-pie>
                        <circle class="rim" cx="8" cy="8" r="7" />
                        <circle class="fill" cx="8" cy="8" r="3.5" pathLength={CLOCK_DASH} />
                      </svg>
                    )}
                  </span>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
    <div class="board">
      <div class="stage" data-stage>
        <div class="led-row">
          <svg class="led" viewBox="40 0 140 150" role="img" aria-label="An LED on GPIO 2" data-picture>
            <circle class="halo" cx="110" cy="70" r="56" />
            <g class="rays"><path d="M110 10 v-8 M150 24 l7 -7 M70 24 l-7 -7 M166 62 h9 M54 62 h-9" /></g>
            <path class="bulb ink" d="M88 66 a22 22 0 0 1 44 0 v22 h-44 Z" />
            <rect class="base ink" x="82" y="88" width="56" height="9" rx="3" />
            <path class="ink" fill="none" d="M100 97 v34 M120 97 v26" />
          </svg>
          <dl class="watch" aria-label="Watch">
            {
              workbench.board.fields.map((name) => (
                <div data-watch-row={name} hidden={valueOf(name) === undefined}>
                  <dt>{name}</dt>
                  <dd>{valueOf(name)}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="link" data-board-link>
          <p aria-live="polite" data-board-message></p>
          <div class="progress" data-board-progress hidden>
            <div class="track" role="progressbar" aria-label="Flashing" aria-valuemin="0" aria-valuemax="100">
              <div class="fill" data-board-fill></div>
            </div>
            <span class="readout" data-board-percent></span>
          </div>
        </div>
      </div>
      <figure class="scope">
        <figcaption>
          <span>GPIO {workbench.tracedPin}, last {TRACE_WINDOW_MS / 1000} s</span>
          <span class="legend">
            <svg viewBox="0 0 10 10" aria-hidden="true"><path class="sent" d="M0 1h10l-5 8z" /></svg>you sent
            <svg viewBox="0 0 10 10" aria-hidden="true"><circle class="applied" cx="5" cy="5" r="4" /></svg>board applied
          </span>
        </figcaption>
        <svg
          class="trace"
          height={TRACE_HEIGHT}
          role="img"
          aria-label={`The level of GPIO ${workbench.tracedPin} over the last ${TRACE_WINDOW_MS / 1000} seconds, with a mark for each line sent and applied`}
          data-trace
        >
          <path class="grid" data-trace-grid />
          <path class="level" data-trace-level />
          <path class="sent" data-trace-sent />
          <path class="applied" data-trace-applied />
        </svg>
      </figure>
      <div class="term">
        <pre class="serial" role="log" aria-live="off" aria-label="Serial output" data-serial><span class="out">{
          Array.from({ length: SERIAL_LINES }, () => <span data-serial-line />)
        }</span></pre>
        <form class="cmd" data-command>
          <span class="prompt" aria-hidden="true">›</span>
          <input
            type="text"
            autocomplete="off"
            spellcheck="false"
            aria-label="Line to send to the board"
            placeholder={first.placeholder}
            data-command-line
          />
          <button class="send" type="submit">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2.2 14.5 8 2 13.8l1.6-5.1L9.5 8 3.6 7.3z" /></svg>
            Send
          </button>
        </form>
        {
          rail.map(
            (step, index) =>
              step.shortcuts.length > 0 && (
                <div class="shortcuts" role="group" aria-label="Shortcuts" data-for-step={index} data-shortcuts hidden={index !== 0}>
                  {step.shortcuts.some((shortcut) => shortcut.kind === 'chip') && (
                    <span class="chips">
                      {step.shortcuts.map(
                        (shortcut, at) =>
                          shortcut.kind === 'chip' && (
                            <button type="button" class="chip" data-shortcut={at}>
                              {shortcut.text}
                            </button>
                          ),
                      )}
                    </span>
                  )}
                  {step.shortcuts.map(
                    (shortcut, at) =>
                      shortcut.kind === 'slider' && (
                        <label class="slider">
                          {shortcut.label}
                          <input
                            type="range"
                            min={shortcut.min}
                            max={shortcut.max}
                            step={shortcut.step}
                            value={shortcut.initial}
                            aria-label={`${shortcut.label} in ${shortcut.unit}`}
                            data-shortcut={at}
                          />
                          <output>{shortcut.initial}</output>
                        </label>
                      ),
                  )}
                </div>
              ),
          )
        }
      </div>
      <p class="problem" role="alert" data-problem hidden></p>
      <div class="say" data-say>
        {
          rail.map((step, index) => (
            <p class="hint" data-for-step={index} data-hint hidden={index !== 0}>
              {step.hint}
            </p>
          ))
        }
        {/* The Board cell's status announces the change; this says what to do about it. */}
        <p class="elsewhere" data-other-step>
          Your board runs <b data-other-running>{longestKey}</b>. Flash <b data-other-wanted>{longestKey}</b> to control it
          from here.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Clip, not hidden: hidden would make the bench a scroll container and hold the sticky board pane in place. */
  .bench { background: var(--card); border: var(--stroke); border-radius: var(--radius); margin: 12px 0 24px; overflow: clip; }
  .bench [hidden] { display: none !important; }

  .rail { display: flex; flex-wrap: wrap; border-bottom: var(--stroke); background: var(--chrome-light); }
  /* As wide as four tabs of 150 px, so the Board cell wraps below the tabs before they wrap among themselves. */
  .tabs { display: flex; flex-wrap: wrap; flex: 1 1 600px; min-width: 0; }
  .tab { font: inherit; font-size: 16px; line-height: 1.5; color: var(--ink); border: 0; border-right: 1px solid var(--line); background: transparent; padding: 10px 16px; cursor: pointer; text-align: left; flex: 1 1 150px; }
  .tab .n { font-family: var(--mono); font-weight: 700; display: block; }
  .tab small { color: var(--muted); font-size: 12px; }
  .tab[aria-selected="true"] { background: var(--yellow); }
  /* Inset, since the bench clips what falls outside it. */
  .tab:focus-visible { outline: 3px solid var(--blue); outline-offset: -3px; }

  /* A fixed width, so no status or button label moves the tabs or the button. */
  .railend { flex: 0 0 310px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 16px; min-width: 0; }
  /* Gaps trimmed from the mockup's so the longest status, Other sketch, fits without an ellipsis. */
  .cell { display: grid; grid-template-columns: 30px minmax(0, 1fr); column-gap: 6px; row-gap: 1px; align-items: center; min-width: 0; flex: 1 1 0; overflow: hidden; }
  .cpu { grid-row: 1 / span 2; width: 30px; height: 30px; }
  .cpu .pins { fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linecap: round; }
  .cpu .body { fill: var(--card); stroke: var(--ink); stroke-width: 1.8; }
  .cpu .core { fill: var(--quiet-light); transition: fill .2s; }
  .cell[data-status="live"] .core { fill: var(--green); }
  .cell:is([data-status="step"], [data-status="sketch"]) .core { fill: var(--coral); }
  .name { display: block; font-family: var(--mono); font-weight: 700; font-size: 15px; line-height: 1.2; }
  .status { position: relative; display: block; padding-left: 2px; font-size: 12px; line-height: 1.3; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .status::before { content: ""; display: inline-block; width: 8px; height: 8px; margin-right: 4px; border-radius: 50%; background: var(--quiet); }
  .cell[data-status="live"] .status { color: var(--green-text); }
  .cell[data-status="live"] .status::before { background: var(--green); box-shadow: 0 0 0 3px var(--green-halo); }
  .cell:is([data-status="step"], [data-status="sketch"]) .status { color: var(--coral-text); }
  .cell:is([data-status="step"], [data-status="sketch"]) .status::before { background: var(--coral); }
  /* Read by a screen reader, not shown: the cell's width has room for the short word only. */
  .sr { position: absolute; top: 0; left: 0; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* As wide as Flash again, its longest word, so the button keeps its width. */
  .connbtn { flex: none; width: 138px; height: 38px; margin: 0 0 2px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; font: inherit; font-size: 14px; font-weight: 700; line-height: 1.5; white-space: nowrap; color: var(--card); background: var(--coral); border: 2px solid var(--ink); border-radius: 999px; box-shadow: 0 3px 0 var(--ink); cursor: pointer; transition: transform .06s, box-shadow .06s; }
  .connbtn:hover:not([aria-disabled="true"]) { background: var(--coral-hover); }
  .connbtn:active:not([aria-disabled="true"]) { transform: translateY(3px); box-shadow: 0 0 0 var(--ink); }
  .connbtn[aria-disabled="true"] { opacity: .6; cursor: default; }
  .connbtn svg { width: 15px; height: 15px; flex: none; }
  .connbtn :is(.i-plug, .i-back) path { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .connbtn .i-bolt path { fill: currentColor; }
  .connbtn:not([data-icon="plug"]) .i-plug, .connbtn:not([data-icon="bolt"]) .i-bolt, .connbtn:not([data-icon="back"]) .i-back { display: none; }
  .needs { position: relative; flex: none; width: 138px; margin: 0; font-size: 12px; line-height: 1.25; color: var(--muted); }

  .panes { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
  @media (max-width: 820px) { .panes { grid-template-columns: minmax(0, 1fr); } }

  .code { display: flex; flex-direction: column; min-width: 0; border-right: 1px solid var(--line); font-family: var(--mono); font-size: 13.5px; line-height: 1.7; }
  @media (max-width: 820px) { .code { border-right: 0; border-bottom: 1px solid var(--line); } }
  .edhead { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; background: var(--chrome); }
  .edtab { display: flex; align-items: center; gap: 8px; background: var(--card); border-right: 1px solid var(--line); box-shadow: inset 0 2px 0 var(--coral); padding: 8px 16px 7px; font-size: 13px; }
  .edtab::before { content: "C"; font-weight: 800; font-size: 11px; color: var(--syntax-function); }
  .dbg { margin-left: auto; display: flex; gap: 8px; align-items: center; padding: 4px 8px; font-family: var(--sans); }
  .dbg button { font: inherit; font-size: 13px; font-weight: 600; line-height: 1.5; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 4px 10px; margin: 0; color: var(--ink); background: var(--card); border: 1px solid var(--edge); border-radius: 0; cursor: pointer; }
  .dbg button:hover:not(:disabled) { background: var(--wash-yellow); }
  .dbg button:disabled { opacity: .45; cursor: default; }
  .dbg button:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; position: relative; }
  .dbg svg { width: 15px; height: 15px; flex: none; fill: currentColor; }
  .dbg svg .stroke { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; }
  .seg { display: inline-flex; }
  .seg button + button { border-left: 0; }
  .seg button:first-child { border-radius: 7px 0 0 7px; }
  .seg button:last-child { border-radius: 0 7px 7px 0; }
  /* As wide as Continue, so the button keeps its width when its word changes. */
  .pause { width: 108px; }
  .pause .i-play, .pause.is-paused .i-pause { display: none; }
  .pause.is-paused .i-play { display: inline; color: var(--green); }
  .dbg .toggle { border-radius: 7px; }
  .dbg .toggle[aria-pressed="true"] { background: var(--ink); color: var(--card); border-color: var(--ink); }
  @media (max-width: 480px) {
    .dbg { flex-wrap: wrap; gap: 6px; padding: 4px; }
    .dbg button { padding: 4px 7px; }
  }
  .crumbs { font-size: 12px; color: var(--muted); padding: 5px 14px 2px 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .crumbs .sep { color: var(--faint); white-space: pre; }
  .edbody { flex: 1; padding: 4px 0 14px; overflow-x: auto; }
  /* As wide as the longest line, so a tinted row reaches the editor's edge even when the code scrolls. */
  .lines { min-width: 100%; width: max-content; }
  .ln { display: grid; grid-template-columns: 22px 30px 1fr; white-space: pre; padding-right: 14px; border-left: 4px solid transparent; }
  .ln.new { background: var(--wash-yellow); }
  .ln .pc { color: var(--coral); font-size: 12px; text-align: center; }
  .ln i { color: var(--faint); font-style: normal; text-align: right; padding-right: 10px; margin-right: 1px; user-select: none; }
  .ln > span { padding-left: 8px; }
  .ln[data-running] { background: var(--tint-coral); border-left-color: var(--coral); }
  .ln[data-running] i { color: var(--ink); font-weight: 700; }
  .ln[data-running] .pc::before { content: "▶"; }
  .pie { width: 16px; height: 16px; vertical-align: -3px; margin-left: 10px; transform: rotate(-90deg); }
  .pie .rim { fill: var(--card); stroke: var(--faint); stroke-width: 1.5; }
  .pie .fill { fill: none; stroke: var(--coral); stroke-width: 7; stroke-dasharray: 0 100; }
  .pie.waiting .rim { stroke: var(--coral); }
  .keyword { color: var(--syntax-keyword); }
  .string { color: var(--syntax-string); }
  .function { color: var(--syntax-function); }
  .number { color: var(--syntax-number); }
  .comment { color: var(--muted); }
  /* Room for four bold digits, the most the interval has, so the line keeps its width as the value changes. */
  .live { display: inline-block; min-width: calc(4.5ch + 10px); padding: 0 5px; text-align: center; background: var(--yellow); border-radius: 6px; font-weight: 700; }

  .board { padding: 14px; display: grid; gap: 10px; align-content: start; min-width: 0; }
  /* Side by side, the board stays in view while the visitor reads down a long sketch. */
  @media (min-width: 821px) { .board { position: sticky; top: 0; align-self: start; } }
  /* The message takes the picture's place and its height, so the reports below do not move. */
  .stage { display: grid; }
  .stage > * { grid-area: 1 / 1; }
  .link { visibility: hidden; align-self: center; display: grid; gap: 8px; font-size: 14px; }
  .stage[data-message] .led-row { visibility: hidden; }
  .stage[data-message] .link { visibility: visible; }
  .link p { margin: 0; }
  .link .progress { display: flex; align-items: center; gap: 12px; }
  .link .track { flex: 1; height: 14px; border: var(--stroke); border-radius: 999px; background: var(--tint-blue); overflow: hidden; }
  .link .fill { height: 100%; width: 0; background: var(--blue); transition: width .15s; }
  .link .readout { min-width: 4ch; text-align: right; font-family: var(--mono); }
  .led-row { display: grid; grid-template-columns: 96px 1fr 1fr; gap: 12px; align-items: center; }
  @media (max-width: 480px) { .led-row { grid-template-columns: 96px 1fr; } }
  .led { width: 100%; }
  .halo { fill: var(--tint-green); }
  .rays { stroke: var(--green); stroke-width: 2.6; stroke-linecap: round; opacity: 0; transition: opacity .08s; }
  .bulb { fill: var(--led-off); transition: fill .08s; }
  .base { fill: var(--card); }
  .led.on .bulb { fill: var(--green); }
  .led.on .rays { opacity: 1; }
  /* Across both columns, so a value such as 1000 ms (fixed) stays on one line. */
  .watch { grid-column: 2 / -1; margin: 0; border: 1px solid var(--line); border-radius: 10px; font-family: var(--mono); font-size: 13px; overflow: hidden; }
  .watch div { display: flex; justify-content: space-between; gap: 10px; padding: 3px 10px; }
  .watch div + div { border-top: 1px solid var(--line); }
  .watch dt { color: var(--muted); }
  .watch dd { margin: 0; padding: 0 4px; border-radius: 4px; font-weight: 700; white-space: nowrap; }
  .watch dd[data-changed] { background: var(--yellow); }

  .scope { margin: 0; padding: 6px 10px 4px; border: 1px solid var(--line); border-radius: 10px; background: var(--chrome-light); }
  .scope figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .legend { display: inline-flex; align-items: center; gap: 4px; }
  .legend svg { width: 9px; height: 9px; margin-left: 6px; }
  /* A mark made just now sits on the right edge; its shape may reach into the padding rather than be cut. */
  .trace { display: block; width: 100%; overflow: visible; }
  .trace .grid { stroke: var(--line); stroke-width: 1; }
  .trace .level { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linejoin: round; }
  .sent { fill: var(--yellow-strong); }
  .applied { fill: var(--green); }
  .term { background: var(--ink); color: var(--on-ink); border-radius: 12px; font-family: var(--mono); font-size: 13px; overflow: hidden; }
  /* Six lines of 1.5em, as many as serialRows keeps, plus the padding. */
  .serial { margin: 0; padding: 10px 14px 6px; height: calc(6 * 1.5em + 16px); overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; white-space: pre; background: none; color: inherit; border-radius: 0; font-size: 13px; line-height: 1.5; }
  .serial [data-sent] { color: var(--yellow); }
  .cmd { display: flex; align-items: center; gap: 8px; padding: 0 12px 0 14px; border-top: 1px solid var(--on-ink-line); }
  .prompt { color: var(--yellow); }
  .cmd input { flex: 1; min-width: 0; padding: 8px 0; border: 0; background: transparent; color: var(--card); font: inherit; outline: none; }
  .cmd input::placeholder { color: var(--faint); }
  .cmd :disabled, .shortcuts :disabled { cursor: default; }
  .send:disabled, .chip:disabled, .slider:has(:disabled) { opacity: .45; }
  .cmd input[data-typing] { color: var(--yellow); }
  .cmd:has(input:focus-visible) { box-shadow: inset 0 0 0 2px var(--blue); }
  .send { display: inline-flex; align-items: center; gap: 6px; font: inherit; font-family: var(--sans); font-size: 13px; font-weight: 700; line-height: 1.5; color: var(--ink); background: var(--yellow); border: 0; border-radius: 6px; padding: 4px 12px; cursor: pointer; }
  .send svg { width: 13px; height: 13px; fill: currentColor; }
  .send:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  /* Room for the longest placeholder, the board runs another step, at phone width. */
  @media (max-width: 480px) { .send { padding: 4px 8px; } }
  .shortcuts { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 8px 12px 8px 14px; border-top: 1px solid var(--on-ink-line); background: var(--ink-raised); color: var(--on-ink); }
  .chips { display: flex; gap: 6px; }
  .chip { font: inherit; font-size: 13px; line-height: 1.5; color: var(--on-ink); background: transparent; border: 1px solid var(--on-ink-edge); border-radius: 6px; padding: 2px 10px; cursor: pointer; }
  .chip:hover:not(:disabled) { border-color: var(--yellow); color: var(--yellow); }
  .chip:focus-visible, .slider input:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .slider { display: flex; flex: 1 1 220px; align-items: center; gap: 8px; min-width: 0; }
  .slider input { flex: 1; min-width: 80px; margin: 0; accent-color: var(--yellow); }
  /* Four digits, the most the value has, so the slider keeps its length as the value changes. */
  .slider output { min-width: 4ch; text-align: right; color: var(--card); }
  .hint { font-size: 13px; color: var(--muted); margin: 0; }
  /* The notice takes the hint's place, which says how to send and does not apply then, so nothing below moves. */
  .say { display: grid; }
  .say > * { grid-area: 1 / 1; }
  .elsewhere { visibility: hidden; margin: 0; padding: 8px 12px; border: 1.5px solid var(--coral); border-radius: 12px; background: var(--wash-coral); font-size: 14px; }
  .say[data-elsewhere] .hint { visibility: hidden; }
  .say[data-elsewhere] .elsewhere { visibility: visible; }
  .problem { margin: 0; padding: 8px 12px; border: 1.5px solid var(--ink); border-radius: 10px; font-size: 14px; font-weight: 600; }
</style>

<script>
  import { OPENING, workbenchFor, openRunner } from '../../lib/workbench/projects';
  import type { Runner, RunnerView } from '../../lib/workbench/simulator';
  import { lineNumber } from '../../lib/workbench/source';
  import { tabAfterKey } from '../../lib/workbench/tabs';
  import type { WatchRow } from '../../lib/workbench/board';
  import type { StepDefinition } from '../../lib/workbench/step';
  import type { BoardStatus } from '../../lib/workbench/link';
  import { createTypist } from '../../lib/workbench/typist';
  import { emptyTrace, recordEffects, traceShape, traceTime, type Trace } from '../../lib/workbench/trace';
  import { createFlasher, createSession, type Manifest } from '../../lib/flash';
  import { boardAction, boardStatus, paneMode, sketchOf, type BoardAction, type PaneMode } from '../../lib/workbench/link';
  import { follow, receive, send as sendFollowed, type Followed } from '../../lib/workbench/live';
  import {
    boardMessage,
    boardStatusText,
    changedRows,
    CLOCK_DASH,
    clockFace,
    OTHER_STEP_PLACEHOLDER,
    otherStepKeys,
    serialRows,
    toolbar,
  } from './view';

  /** How long a watch value stays highlighted after it changes. */
  const HIGHLIGHT_MS = 900;

  interface StepData {
    key: string;
    source: string;
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-workbench]')) mount(root);

  function mount(root: HTMLElement) {
    const project = workbenchFor(root.dataset.project ?? '');
    if (project === undefined) return;
    const steps: StepData[] = JSON.parse(root.dataset.steps ?? '[]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = root.querySelector<HTMLElement>('[role="tabpanel"]')!;
    const perStep = [...root.querySelectorAll<HTMLElement>('[data-for-step]')];
    const picture = root.querySelector<SVGElement>('[data-picture]')!;
    const watchRows = new Map(
      [...root.querySelectorAll<HTMLElement>('[data-watch-row]')].map((row) => [row.dataset.watchRow!, row]),
    );
    const serialLines = [...root.querySelectorAll<HTMLElement>('[data-serial-line]')];
    const command = root.querySelector<HTMLFormElement>('[data-command]')!;
    const commandLine = root.querySelector<HTMLInputElement>('[data-command-line]')!;
    const sendButton = command.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const shortcutControls = [...root.querySelectorAll<HTMLButtonElement | HTMLInputElement>('[data-shortcut]')];
    const say = root.querySelector<HTMLElement>('[data-say]')!;
    const otherRunning = root.querySelector<HTMLElement>('[data-other-running]')!;
    const otherWanted = root.querySelector<HTMLElement>('[data-other-wanted]')!;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const pauseButton = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const pauseLabel = root.querySelector<HTMLElement>('[data-pause-label]')!;
    const stepButton = root.querySelector<HTMLButtonElement>('[data-step]')!;
    const restartButton = root.querySelector<HTMLButtonElement>('[data-restart]')!;
    const slowButton = root.querySelector<HTMLButtonElement>('[data-slow]')!;
    const problem = root.querySelector<HTMLElement>('[data-problem]')!;
    const traceView = root.querySelector<SVGSVGElement>('[data-trace]')!;
    const tracePaths = {
      grid: traceView.querySelector('[data-trace-grid]')!,
      level: traceView.querySelector('[data-trace-level]')!,
      sent: traceView.querySelector('[data-trace-sent]')!,
      applied: traceView.querySelector('[data-trace-applied]')!,
    };
    const cell = root.querySelector<HTMLElement>('[data-board-cell]')!;
    const statusText = root.querySelector<HTMLElement>('[data-board-status]')!;
    const statusWord = root.querySelector<HTMLElement>('[data-board-word]')!;
    const statusSentence = root.querySelector<HTMLElement>('[data-board-sentence]')!;
    const actionButton = root.querySelector<HTMLButtonElement>('[data-board-action]');
    const actionLabel = root.querySelector<HTMLElement>('[data-board-action-label]');
    const needsBrowser = root.querySelector<HTMLElement>('[data-needs-browser]')!;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const message = root.querySelector<HTMLElement>('[data-board-message]')!;
    const progress = root.querySelector<HTMLElement>('[data-board-progress]')!;
    const progressBar = progress.querySelector<HTMLElement>('[role="progressbar"]')!;
    const progressFill = root.querySelector<HTMLElement>('[data-board-fill]')!;
    const progressText = root.querySelector<HTMLElement>('[data-board-percent]')!;
    let traceWidth = 0;
    // With no viewBox the trace is drawn in CSS pixels, so its marks keep their shape at any width.
    new ResizeObserver(([entry]) => {
      traceWidth = entry.contentRect.width;
      draw();
    }).observe(traceView);

    let selected = 0;
    let definition: StepDefinition<unknown, unknown> | undefined;
    // The watch panel as last painted; undefined after a reset, so the values it starts with are not highlighted.
    let shownRows: readonly WatchRow[] | undefined;
    const highlightTimers = new Map<string, number>();
    let runner: Runner<unknown> | undefined;
    let view: RunnerView<unknown> | undefined;
    let board: unknown;
    let trace: Trace = emptyTrace();
    let frame = 0;
    let slow: boolean = OPENING.slow;
    // Whether the visitor wants the sketch running: Pause and Step stop it, Continue and a tab pick start it.
    let keepRunning: boolean = OPENING.running;
    let mode: PaneMode = 'simulator';
    // Set when the visitor paused, stepped or restarted while live: the simulator keeps the pane until Back to live.
    let detached = false;
    // The real board as its lines tell it, while the pane follows it.
    let followed: Followed<unknown> | undefined;

    function select(index: number) {
      selected = index;
      const step = steps[index];
      const chosen = project!.steps.find((candidate) => candidate.key === step.key)!;
      definition = chosen;
      tabs.forEach((tab, at) => {
        tab.setAttribute('aria-selected', String(at === index));
        tab.tabIndex = at === index ? 0 : -1;
      });
      panel.setAttribute('aria-labelledby', tabs[index].id);
      for (const element of perStep) element.hidden = element.dataset.forStep !== String(index);
      commandLine.placeholder = chosen.placeholder;
      if (session.state.kind === 'running') dismissedRefusal = session.state.flashRefused;
      clearCommandLine();
      resetWatch();

      runner?.dispose();
      board = project!.board.initial();
      trace = emptyTrace();
      keepRunning = OPENING.running;
      mode = 'simulator';
      detached = false;
      followed = undefined;
      runner = openRunner(
        chosen,
        (next, effects) => {
          // While the pane follows the board, the simulator waits, paused, and its notices are not the pane's.
          if (mode !== 'simulator') return;
          board = project!.board.simulate(board, next.state, effects, next.millis);
          // A line is sent between two lines of the program, part way through the one under way.
          const sentAt = traceTime(next, runner?.progress() ?? 0, reducedMotion.matches);
          trace = recordEffects(trace, effects, project!.tracedPin, next.millis, sentAt);
          view = next;
          draw();
        },
        { slow },
      );
      view = runner.view();
      // Picking the step the board runs follows the board at once.
      showLink();
      draw();
    }

    /** Hands the pane to the board, from the next line it prints; the simulator waits, paused. */
    function startFollowing() {
      runner?.pause();
      followed = follow(project!.board);
      resetWatch();
    }

    /** Hands the pane to a fresh simulator at the sketch's first line, running if the visitor wants it running. */
    function startSimulator() {
      followed = undefined;
      board = project!.board.initial();
      trace = emptyTrace();
      resetWatch();
      runner?.restart();
      if (keepRunning) runner?.run();
    }

    /** Puts the pane where the board's status and the visitor's last choice say it goes. */
    function syncMode(status: BoardStatus) {
      if (status.kind !== 'live') detached = false;
      const next = paneMode(status, detached);
      if (next === mode) return;
      const was = mode;
      mode = next;
      if (next === 'simulator') startSimulator();
      else if (was === 'simulator') startFollowing();
      draw();
    }

    /** Pause, Step or Restart pressed while live: the simulator takes the pane, and the board keeps its port. */
    function detach() {
      detached = true;
      mode = 'simulator';
      startSimulator();
      showLink();
    }

    /** The step the followed board runs, whose lines the pane reads: the selected one unless the board runs another. */
    function followedStep(): StepDefinition<unknown, unknown> {
      if (mode === 'live') return definition!;
      return project!.steps.find((step) => step.key === heard) ?? definition!;
    }

    function draw() {
      if (frame === 0) frame = requestAnimationFrame(paint);
    }

    function paint() {
      frame = 0;
      if (view === undefined) return;
      const step = steps[selected];
      const shown = mode === 'simulator' ? undefined : followed;
      const shownBoard = shown?.board ?? board;
      picture.classList.toggle('on', project!.board.lit(shownBoard));
      // A real board's clock is unknown: it prints no time.
      const rows = project!.board.watch(step.key, shownBoard, shown === undefined ? view.millis : undefined);
      for (const [name, element] of watchRows) {
        const row = rows.find((candidate) => candidate.name === name);
        element.hidden = row === undefined;
        if (row !== undefined) element.querySelector('dd')!.textContent = row.value;
      }
      for (const name of changedRows(shownRows, rows, project!.board.steady)) highlight(name);
      shownRows = rows;
      const serialText = serialRows(shown?.output ?? view.output);
      serialLines.forEach((element, at) => {
        element.textContent = serialText[at]?.text ?? '';
        element.toggleAttribute('data-sent', serialText[at]?.sent ?? false);
      });
      const controls = toolbar(mode, view.status, view.error, view.slow);
      pauseButton.classList.toggle('is-paused', controls.paused);
      pauseLabel.textContent = controls.label;
      pauseButton.disabled = !controls.canContinue;
      stepButton.disabled = !controls.canStep;
      restartButton.disabled = !controls.canRestart;
      slowButton.disabled = !controls.canSlow;
      slowButton.setAttribute('aria-pressed', String(controls.slow));
      problem.hidden = controls.problem === undefined;
      problem.textContent = controls.problem ?? '';
      const at = shown === undefined ? { text: view.line, occurrence: view.occurrence } : arrowOf(shown);
      const running = at.text === undefined ? undefined : lineNumber(step.source, at.text, at.occurrence);
      const code = root.querySelector<HTMLElement>(`[data-code][data-for-step="${selected}"]`)!;
      const live = code.querySelector('[data-live]');
      if (live !== null && definition?.live !== undefined) {
        const value =
          shown === undefined ? definition.live.value(view.state) : project!.board.variable(shown.board, definition.live.name);
        if (value !== undefined) live.textContent = value;
      }
      const before = code.querySelector('[data-running]');
      const row = running === undefined ? null : code.querySelector(`[data-line="${running}"]`);
      if (before !== row) {
        before?.removeAttribute('data-running');
        row?.setAttribute('data-running', '');
        if (before !== null) showClock(before.querySelector('[data-pie]'), { waiting: false, fill: 0 });
      }
      const progress = runner?.progress() ?? 0;
      // A real board's wait is not timed by the page, so the clock stays empty while the pane follows it.
      const face = shown === undefined ? clockFace(view, progress, reducedMotion.matches) : { waiting: false, fill: 0 };
      showClock(row?.querySelector('[data-pie]') ?? null, face);
      const shape =
        shown === undefined
          ? traceShape(trace, traceTime(view, progress, reducedMotion.matches), traceWidth)
          : traceShape(shown.trace, Date.now(), traceWidth);
      for (const [part, path] of Object.entries(tracePaths)) path.setAttribute('d', shape[part as keyof typeof shape]);
      // The clock fills and the trace scrolls between the runner's notifications, so they are painted on every frame.
      const moving = shown !== undefined || (view.status === 'running' && (face.waiting || view.cost > 0));
      if (moving && !reducedMotion.matches) draw();
    }

    /** Where the arrow sits on the followed board: only live, and only on a step whose lines place it. */
    function arrowOf(shown: Followed<unknown>): { text: string | undefined; occurrence: number } {
      const ref = mode === 'live' ? shown.arrow : undefined;
      if (ref === undefined || typeof ref === 'string') return { text: ref, occurrence: 1 };
      return { text: ref.text, occurrence: ref.occurrence };
    }

    /** Marks a watch value that just changed for a moment. */
    function highlight(name: string) {
      const value = watchRows.get(name)?.querySelector('dd');
      if (value == null) return;
      value.setAttribute('data-changed', '');
      clearTimeout(highlightTimers.get(name));
      highlightTimers.set(name, window.setTimeout(() => value.removeAttribute('data-changed'), HIGHLIGHT_MS));
    }

    function resetWatch() {
      shownRows = undefined;
      for (const timer of highlightTimers.values()) clearTimeout(timer);
      highlightTimers.clear();
      for (const row of watchRows.values()) row.querySelector('dd')?.removeAttribute('data-changed');
    }

    function showClock(pie: Element | null, face: { waiting: boolean; fill: number }) {
      if (pie === null) return;
      pie.classList.toggle('waiting', face.waiting);
      const fill = pie.querySelector<SVGElement>('.fill')!;
      fill.style.strokeDasharray = `${face.fill * CLOCK_DASH} ${CLOCK_DASH}`;
    }

    /**
     * Sends a line the visitor typed or a shortcut typed for them to the sketch's serial input: the simulator's, or the
     * board's while live. A board that runs another sketch takes none.
     */
    function sendToBoard(text: string) {
      if (mode === 'simulator') {
        runner?.send(text);
        return;
      }
      if (mode !== 'live' || followed === undefined) return;
      followed = sendFollowed(followed, definition!, project!.tracedPin, text, Date.now());
      draw();
      // A write the port refuses means the board went away, which the session reports through its state.
      session.sendLine(text).catch(() => {});
    }

    /** Shows `text` in the command line in yellow: typed by a shortcut, or about to be sent by the slider. */
    function showTyped(text: string) {
      commandLine.value = text;
      commandLine.setAttribute('data-typing', '');
    }

    /** Empties the command line and drops the line a shortcut was typing, unsent; resets the sliders. */
    function clearCommandLine() {
      typist.stop();
      commandLine.value = '';
      commandLine.removeAttribute('data-typing');
      for (const slider of sliders) {
        const shortcut = shortcutOf(slider);
        if (shortcut?.kind !== 'slider') continue;
        slider.value = String(shortcut.initial);
        slider.nextElementSibling!.textContent = slider.value;
      }
    }

    const typist = createTypist({
      show: showTyped,
      send(text) {
        commandLine.value = '';
        commandLine.removeAttribute('data-typing');
        sendToBoard(text);
      },
      reduceMotion: () => reducedMotion.matches,
    });

    // Whether the line the typist holds came from a slider, which a further move of a slider replaces.
    let heldBySlider = false;
    const sliders = [...root.querySelectorAll<HTMLInputElement>('input[type="range"][data-shortcut]')];
    function shortcutOf(control: HTMLElement) {
      const stepIndex = Number(control.closest<HTMLElement>('[data-for-step]')!.dataset.forStep);
      const step = project!.steps.find((candidate) => candidate.key === steps[stepIndex].key);
      return step?.shortcuts[Number(control.dataset.shortcut)];
    }

    command.addEventListener('submit', (event) => {
      event.preventDefault();
      // A line a shortcut is typing goes out as it would after its pause.
      if (typist.busy) return typist.finish();
      const text = commandLine.value.trim();
      commandLine.value = '';
      commandLine.removeAttribute('data-typing');
      if (text !== '') sendToBoard(text);
    });
    commandLine.addEventListener('input', () => {
      typist.stop();
      commandLine.removeAttribute('data-typing');
    });
    for (const chip of root.querySelectorAll<HTMLButtonElement>('button[data-shortcut]')) {
      chip.addEventListener('click', () => {
        const shortcut = shortcutOf(chip);
        if (shortcut?.kind !== 'chip') return;
        heldBySlider = false;
        typist.type(shortcut.text);
      });
    }
    for (const slider of sliders) {
      const line = () => {
        const shortcut = shortcutOf(slider);
        return shortcut?.kind === 'slider' ? shortcut.command(Number(slider.value)) : '';
      };
      // Dragging only shows the line; releasing sends it, so the values passed on the way never reach the board.
      slider.addEventListener('input', () => {
        // A value the slider passed on the way, as each arrow key press is, gives way to the next one unsent.
        if (heldBySlider) typist.stop();
        else typist.finish();
        slider.nextElementSibling!.textContent = slider.value;
        showTyped(line());
      });
      slider.addEventListener('change', () => {
        heldBySlider = true;
        typist.type(line(), line().length);
      });
    }

    pauseButton.addEventListener('click', () => {
      if (mode === 'live') {
        keepRunning = false;
        return detach();
      }
      if (runner?.view().status === 'running') {
        keepRunning = false;
        runner.pause();
      } else {
        keepRunning = true;
        runner?.run();
      }
    });
    stepButton.addEventListener('click', () => {
      keepRunning = false;
      if (mode === 'live') return detach();
      runner?.step();
    });
    restartButton.addEventListener('click', () => {
      if (mode === 'live') return detach();
      if (runner === undefined) return;
      board = project!.board.initial();
      trace = emptyTrace();
      resetWatch();
      clearCommandLine();
      runner.restart();
      // The runner keeps running or paused, and comes back paused from an end or an error.
      if (keepRunning) runner.run();
    });
    slowButton.addEventListener('click', () => {
      slow = !slow;
      runner?.setSlow(slow);
    });

    const session = createSession({
      flasher: createFlasher(),
      manifest: JSON.parse(root.dataset.manifest ?? '{"sketches":{}}') as Manifest,
      sketch: steps[0].key,
      baud: root.dataset.baud ? Number(root.dataset.baud) : undefined,
    });
    const stepKeys = steps.map((step) => step.key);
    // The sketch the connected board said it runs; unknown again from each connection or flash until it says.
    let heard: string | undefined;
    let pressed: BoardAction | undefined;
    let flashedKey = steps[0].key;
    // The refusal the visitor moved on from by picking another step.
    let dismissedRefusal: unknown;

    function showLink() {
      const state = session.state;
      const key = steps[selected].key;
      const status = boardStatus(state, heard, key, stepKeys);
      syncMode(status);
      const text = boardStatusText(status);
      cell.dataset.status = status.kind;
      // Set only on a change, since the status is a live region.
      if (statusWord.textContent !== text.word) statusWord.textContent = text.word;
      if (statusSentence.textContent !== `: ${text.title}`) statusSentence.textContent = `: ${text.title}`;
      statusText.title = text.title;

      const action = boardAction(state, heard, key, pressed, detached);
      needsBrowser.hidden = action !== undefined;
      if (actionButton !== null && actionLabel !== null) {
        actionButton.hidden = action === undefined;
        if (action !== undefined) {
          actionLabel.textContent = action.label;
          actionButton.dataset.icon = action.icon;
          // aria-disabled, not disabled, so a button pressed from the keyboard keeps the focus while the session works.
          if (action.disabled) actionButton.setAttribute('aria-disabled', 'true');
          else actionButton.removeAttribute('aria-disabled');
        }
      }

      const shown = boardMessage(state, flashedKey, state.kind === 'running' && state.flashRefused !== dismissedRefusal);
      stage.toggleAttribute('data-message', shown !== undefined);
      const words = shown?.text ?? '';
      // Only a change of text is announced: the progress bar carries the percentage.
      if (message.textContent !== words) message.textContent = words;
      message.classList.toggle('notice', shown?.notice ?? false);
      progress.hidden = shown?.progress === undefined;
      if (shown?.progress !== undefined) {
        progressBar.setAttribute('aria-valuenow', String(shown.progress));
        progressFill.style.width = `${shown.progress}%`;
        progressText.textContent = `${shown.progress}%`;
      }

      // A board that runs another sketch takes no line from the page.
      const usable = mode !== 'other';
      commandLine.disabled = !usable;
      sendButton.disabled = !usable;
      for (const control of shortcutControls) control.disabled = !usable;
      commandLine.placeholder = usable ? definition!.placeholder : OTHER_STEP_PLACEHOLDER;
      const keys = otherStepKeys(status, key);
      say.toggleAttribute('data-elsewhere', keys !== undefined);
      if (keys !== undefined) {
        otherRunning.textContent = keys.running;
        otherWanted.textContent = keys.wanted;
      }
    }

    session.subscribe((state) => {
      if (state.kind === 'connecting') heard = undefined;
      showLink();
    });
    session.subscribeLines(({ text, at }) => {
      const key = sketchOf(text);
      if (key !== undefined && key !== heard) {
        heard = key;
        showLink();
      }
      // Lines the board prints while the simulator has the pane are not shown, nor kept for later.
      if (followed === undefined) return;
      followed = receive(followed, followedStep(), project!.board, project!.tracedPin, text, at);
      draw();
    });
    actionButton?.addEventListener('click', () => {
      const action = boardAction(session.state, heard, steps[selected].key, pressed, detached);
      if (action === undefined || action.disabled) return;
      pressed = action;
      if (action.event === 'live') {
        detached = false;
        showLink();
      } else if (action.event === 'connect') {
        void session.send({ type: 'connect', reset: true });
      } else {
        flashedKey = steps[selected].key;
        void session.send({ type: 'flash', key: flashedKey });
      }
    });

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        if (index !== selected) select(index);
      });
      tab.addEventListener('keydown', (event) => {
        const next = tabAfterKey(event.key, index, tabs.length);
        if (next === undefined) return;
        event.preventDefault();
        tabs[next].focus();
        if (next !== selected) select(next);
      });
    });

    select(0);
  }
</script>
