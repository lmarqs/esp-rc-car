---
import { railOf, workbenchFor } from '../../lib/workbench/projects';
// Read here, at build time, only: a browser script that imported it would carry every sketch's source.
import { readStepSource } from '../../lib/workbench/readSource';
import { newLines } from '../../lib/workbench/source';
import { sketchKey } from '../../lib/flash/manifest';
import { readManifest } from '../../lib/flash/readManifest';
import Board from './Board.astro';
import Editor from './Editor.astro';
import Rail from './Rail.astro';
import { elementId, type RailStep } from './rail';
import { codeRows, crumbs, fileName } from './view';

interface Props {
  /** The project's page id, such as `blink`; the project must have step definitions. */
  project: string;
  /** The project's steps from its page, in order. */
  steps: readonly { id: string; sketch: string; idea: string }[];
  /** The speed the steps print at, which the page reads the visitor's board at. */
  baud?: number;
}

const { project, steps, baud } = Astro.props;
const workbench = workbenchFor(project);
if (workbench === undefined) throw new Error(`The project ${project} has no step definitions for the workbench.`);

const sources = steps.map((step) => readStepSource(step.sketch));
const definitions = railOf(workbench, steps.map((step) => step.sketch));
const rail: RailStep[] = steps.map((step, index) => {
  const definition = definitions[index];
  return {
    ...step,
    number: index + 1,
    key: definition.key,
    hint: definition.hint,
    placeholder: definition.placeholder,
    shortcuts: definition.shortcuts,
    file: fileName(step.sketch),
    crumbs: crumbs(step.sketch),
    rows: codeRows(sources[index], newLines(sources[index - 1], sources[index]), definition.live?.name),
  };
});
const first = rail[0];
const stepData = JSON.stringify(rail.map((step, index) => ({ sketch: step.sketch, source: sources[index] })));
const id = (part: string) => elementId(project, part);
const firmware = readManifest().sketches;
// Only the steps' images, so the page does not carry the whole manifest. The manifest names a sketch by its path, and
// the session flashes a step by the key it prints.
const manifest = {
  sketches: Object.fromEntries(
    rail.flatMap((step) => {
      const images = firmware[sketchKey(step.sketch)];
      return images ? [[step.key, images]] : [];
    }),
  ),
};
const flashable = Object.keys(manifest.sketches).length > 0;
---

<section
  class="bench"
  id="workbench"
  aria-label="Workbench"
  data-workbench
  data-project={project}
  data-steps={stepData}
  data-manifest={JSON.stringify(manifest)}
  data-baud={baud}
>
  <Rail project={project} steps={rail} flashable={flashable} />
  <div class="panes" role="tabpanel" id={id('panel')} aria-labelledby={id(`tab-${first.id}`)}>
    <Editor steps={rail} />
    <Board project={workbench} steps={rail} />
  </div>
</section>

<style>
  /* Clip, not hidden: hidden would make the bench a scroll container and hold the sticky board pane in place. */
  .bench { background: var(--card); border: var(--stroke); border-radius: var(--radius); margin: 12px 0 24px; overflow: clip; }

  .panes { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
  @media (max-width: 820px) { .panes { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  import { railOf, workbenchFor, type WorkbenchProject } from '../../lib/workbench/projects';
  import { createSimulation } from '../../lib/workbench/simulation';
  import { lineNumber } from '../../lib/workbench/source';
  import { tabAfterKey } from '../../lib/workbench/tabs';
  import type { PictureView, WatchRow } from '../../lib/workbench/board';
  import { createTypist } from '../../lib/workbench/typist';
  import { traceShape, traceTime } from '../../lib/workbench/trace';
  import { createFlasher, createSession, type Manifest } from '../../lib/flash';
  import type { BoardAction } from '../../lib/workbench/link';
  import type { Followed } from '../../lib/workbench/live';
  import {
    initialPane,
    paneAction,
    paneStatus,
    showsRefusal,
    reducePane,
    type PaneEvent,
    type PaneProject,
    type PaneState,
  } from '../../lib/workbench/pane';
  import {
    boardMessage,
    boardStatusText,
    changedRows,
    followedSliderValue,
    followSlider,
    CLOCK_DASH,
    clockFace,
    liveClockFace,
    notSent,
    serialRows,
    toolbar,
  } from './view';

  /** How long a watch value stays highlighted after it changes. */
  const HIGHLIGHT_MS = 900;

  interface StepData {
    sketch: string;
    source: string;
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-workbench]')) {
    const project = workbenchFor(root.dataset.project ?? '');
    if (project !== undefined) mount(root, project);
  }

  function mount(root: HTMLElement, project: WorkbenchProject<unknown, unknown, unknown>) {
    const steps: StepData[] = JSON.parse(root.dataset.steps ?? '[]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = root.querySelector<HTMLElement>('[role="tabpanel"]')!;
    const perStep = [...root.querySelectorAll<HTMLElement>('[data-for-step]')];
    const picture = root.querySelector<SVGElement>('[data-picture]')!;
    const watchRows = new Map(
      [...root.querySelectorAll<HTMLElement>('[data-watch-row]')].map((row) => [row.dataset.watchRow!, row]),
    );
    const serialLines = [...root.querySelectorAll<HTMLElement>('[data-serial-line]')];
    const command = root.querySelector<HTMLFormElement>('[data-command]')!;
    const commandLine = root.querySelector<HTMLInputElement>('[data-command-line]')!;
    const say = root.querySelector<HTMLElement>('[data-say]')!;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const pauseButton = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const pauseLabel = root.querySelector<HTMLElement>('[data-pause-label]')!;
    const stepButton = root.querySelector<HTMLButtonElement>('[data-step]')!;
    const restartButton = root.querySelector<HTMLButtonElement>('[data-restart]')!;
    const slowButton = root.querySelector<HTMLButtonElement>('[data-slow]')!;
    const problem = root.querySelector<HTMLElement>('[data-problem]')!;
    const traceView = root.querySelector<SVGSVGElement>('[data-trace]')!;
    const tracePaths = {
      grid: traceView.querySelector('[data-trace-grid]')!,
      level: traceView.querySelector('[data-trace-level]')!,
      sent: traceView.querySelector('[data-trace-sent]')!,
      applied: traceView.querySelector('[data-trace-applied]')!,
    };
    const cell = root.querySelector<HTMLElement>('[data-board-cell]')!;
    const statusText = root.querySelector<HTMLElement>('[data-board-status]')!;
    let statusWord = root.querySelector<HTMLElement>('[data-board-word]')!;
    let statusSentence = root.querySelector<HTMLElement>('[data-board-sentence]')!;
    const actionButton = root.querySelector<HTMLButtonElement>('[data-board-action]');
    const actionLabel = root.querySelector<HTMLElement>('[data-board-action-label]');
    const needsBrowser = root.querySelector<HTMLElement>('[data-needs-browser]')!;
    const simulatorButton = root.querySelector<HTMLButtonElement>('[data-pane-simulator]')!;
    const flashAgain = root.querySelector<HTMLButtonElement>('[data-flash-again]')!;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const message = root.querySelector<HTMLElement>('[data-board-message]')!;
    const progress = root.querySelector<HTMLElement>('[data-board-progress]')!;
    const progressBar = progress.querySelector<HTMLElement>('[role="progressbar"]')!;
    const progressFill = root.querySelector<HTMLElement>('[data-board-fill]')!;
    const progressText = root.querySelector<HTMLElement>('[data-board-percent]')!;
    let traceWidth = 0;
    // With no viewBox the trace is drawn in CSS pixels, so its marks keep their shape at any width.
    new ResizeObserver(([entry]) => {
      traceWidth = entry.contentRect.width;
      draw();
    }).observe(traceView);
    // The clock and the trace move again, or come to rest, as soon as the visitor changes the setting.
    reducedMotion.addEventListener('change', () => draw());

    // The project's steps in rail order, as the pane numbers them.
    const paneProject: PaneProject<unknown> = {
      steps: railOf(project, steps.map((step) => step.sketch)),
      board: project.board,
    };
    // The watch panel as last painted; undefined after a reset, so the values it starts with are not highlighted.
    let shownRows: readonly WatchRow[] | undefined;
    const highlightTimers = new Map<string, number>();
    // While the pane follows the board, the simulator waits, paused, and its notices are not the pane's.
    const simulation = createSimulation(project.board, {
      has: () => pane.mode === 'simulator',
      reduceMotion: () => reducedMotion.matches,
      changed: draw,
    });
    let frame = 0;
    let motionFrame = 0;

    /** The selected step's definition. */
    const definition = () => paneProject.steps[pane.selected];

    /** Applies `event` to the pane, then does what its change asks of the page and paints it. */
    function dispatch(event: PaneEvent) {
      const before = pane;
      pane = reducePane(paneProject, pane, event);
      if (pane.selected !== before.selected) openStep(pane.selected);
      if (pane.mode !== before.mode) dropTyping();
      if (pane.simulation !== before.simulation) {
        resetWatch();
        simulation.restart();
      }
      if (pane.following !== before.following) {
        simulation.hold();
        resetWatch();
      }
      showLink();
      draw();
    }

    /** Shows step `index` with a fresh simulator, started as the page opens a step. */
    function openStep(index: number) {
      const chosen = paneProject.steps[index];
      tabs.forEach((tab, at) => {
        tab.setAttribute('aria-selected', String(at === index));
        tab.tabIndex = at === index ? 0 : -1;
      });
      panel.setAttribute('aria-labelledby', tabs[index].id);
      for (const element of perStep) element.hidden = element.dataset.forStep !== String(index);
      commandLine.placeholder = chosen.placeholder;
      clearCommandLine();
      resetWatch();

      simulation.open(chosen);
    }

    /** Paints the whole pane at the next frame, after something in it changed. */
    function draw() {
      if (frame === 0) frame = requestAnimationFrame(paint);
    }

    function paint() {
      frame = 0;
      cancelAnimationFrame(motionFrame);
      motionFrame = 0;
      const view = simulation.view;
      if (view === undefined) return;
      const step = steps[pane.selected];
      const shown = pane.mode === 'simulator' ? undefined : pane.followed;
      const shownBoard = shown?.board ?? simulation.board;
      paintPicture(project.board.picture(definition().key, shownBoard));
      followSliders(shownBoard);
      // A real board's clock is unknown: it prints no time.
      const rows = project.board.watch(definition().key, shownBoard, shown === undefined ? view.millis : undefined);
      for (const [name, element] of watchRows) {
        const row = rows.find((candidate) => candidate.name === name);
        element.hidden = row === undefined;
        if (row !== undefined) element.querySelector('dd')!.textContent = row.value;
      }
      for (const name of changedRows(shownRows, rows, project.board.steady)) highlight(name);
      shownRows = rows;
      const serialText = serialRows(shown?.output ?? view.output);
      serialLines.forEach((element, at) => {
        element.textContent = serialText[at]?.text ?? '';
        element.toggleAttribute('data-sent', serialText[at]?.sent ?? false);
      });
      const controls = toolbar(pane.mode, view.status, view.error, view.slow);
      pauseButton.classList.toggle('is-paused', controls.paused);
      pauseLabel.textContent = controls.label;
      pauseButton.disabled = !controls.canContinue;
      stepButton.disabled = !controls.canStep;
      restartButton.disabled = !controls.canRestart;
      slowButton.disabled = !controls.canSlow;
      slowButton.setAttribute('aria-pressed', String(controls.slow));
      const refused = shown === undefined || pane.refused === undefined ? undefined : notSent(pane.refused);
      const trouble = controls.problem ?? refused;
      problem.hidden = trouble === undefined;
      say.toggleAttribute('data-trouble', trouble !== undefined);
      // Set only on a change, since the problem is an alert: each write would be read out again.
      if (problem.textContent !== (trouble ?? '')) problem.textContent = trouble ?? '';
      const at = shown === undefined ? { text: view.line, occurrence: view.occurrence } : arrowOf(shown);
      const running = at.text === undefined ? undefined : lineNumber(step.source, at.text, at.occurrence);
      const code = root.querySelector<HTMLElement>(`[data-code][data-for-step="${pane.selected}"]`)!;
      const live = code.querySelector('[data-live]');
      const liveValue = definition().live;
      if (live !== null && liveValue !== undefined) {
        const value =
          shown === undefined ? liveValue.value(view.state) : project.board.variable(shown.board, liveValue.name);
        // A value the board has not told yet shows as unknown rather than as the number in the source.
        live.textContent = value ?? '…';
      }
      const before = code.querySelector('[data-running]');
      const row = running === undefined ? null : code.querySelector(`[data-line="${running}"]`);
      if (before !== row) {
        before?.removeAttribute('data-running');
        row?.setAttribute('data-running', '');
        if (before !== null) showClock(before.querySelector('[data-pie]'), { waiting: false, fill: 0 });
      }
      paintMotion();
    }

    /**
     * Paints what moves between changes, the running line's clock and the trace, and keeps painting them on every
     * frame while they move; the rest of the pane waits for the next change.
     */
    function paintMotion() {
      motionFrame = 0;
      const view = simulation.view;
      if (view === undefined) return;
      const shown = pane.mode === 'simulator' ? undefined : pane.followed;
      const row = root.querySelector(`[data-code][data-for-step="${pane.selected}"] [data-running]`);
      const progress = simulation.progress();
      const face =
        shown === undefined
          ? clockFace(view, progress, reducedMotion.matches)
          : liveClockFace(
              pane.mode === 'live' ? shown.arrowAt : undefined,
              project.board.wait(shown.board),
              Date.now(),
              reducedMotion.matches,
            );
      showClock(row?.querySelector('[data-pie]') ?? null, face);
      const shape =
        shown === undefined
          ? traceShape(simulation.trace, traceTime(view, progress, reducedMotion.matches), traceWidth)
          : traceShape(shown.trace, Date.now(), traceWidth);
      for (const [part, path] of Object.entries(tracePaths)) {
        const d = shape[part as keyof typeof shape];
        if (path.getAttribute('d') !== d) path.setAttribute('d', d);
      }
      // The clock fills and the trace scrolls between the runner's notifications.
      const moving = shown !== undefined || (view.status === 'running' && (face.waiting || view.cost > 0));
      if (moving && !reducedMotion.matches) motionFrame = requestAnimationFrame(paintMotion);
    }

    /** Paints the picture's state: its classes, the custom properties its styles read and its accessible name. */
    function paintPicture(shown: PictureView) {
      for (const [name, on] of Object.entries(shown.flags)) picture.classList.toggle(name, on);
      for (const [name, value] of Object.entries(shown.values)) picture.style.setProperty(`--${name}`, String(value));
      if (shown.label !== undefined && picture.getAttribute('aria-label') !== shown.label) {
        picture.setAttribute('aria-label', shown.label);
      }
    }

    /**
     * Moves each slider of the step that follows a board variable when the variable changes, so it reads the last
     * value sent or reported. A value the visitor released stays until the board reports a change.
     */
    function followSliders(shownBoard: unknown) {
      const typing = commandLine.hasAttribute('data-typing');
      for (const slider of sliders) {
        if (slider.closest<HTMLElement>('[data-for-step]')!.hidden) continue;
        const shortcut = shortcutOf(slider);
        if (shortcut?.kind !== 'slider' || shortcut.follows === undefined) continue;
        const reported = followedSliderValue(shortcut, project.board.variable(shownBoard, shortcut.follows));
        const next = followSlider(seenBySlider.get(slider), reported, typing || slider === pressedSlider);
        seenBySlider.set(slider, next.remembered);
        if (next.move === undefined || slider.value === String(next.move)) continue;
        slider.value = String(next.move);
        slider.nextElementSibling!.textContent = slider.value;
      }
    }

    /** Where the arrow sits on the followed board: only live, and only on a step whose lines place it. */
    function arrowOf(shown: Followed<unknown>): { text: string | undefined; occurrence: number } {
      const ref = pane.mode === 'live' ? shown.arrow : undefined;
      if (ref === undefined || typeof ref === 'string') return { text: ref, occurrence: 1 };
      return { text: ref.text, occurrence: ref.occurrence };
    }

    /** Marks a watch value that just changed for a moment. */
    function highlight(name: string) {
      const value = watchRows.get(name)?.querySelector('dd');
      if (value == null) return;
      value.setAttribute('data-changed', '');
      clearTimeout(highlightTimers.get(name));
      highlightTimers.set(name, window.setTimeout(() => value.removeAttribute('data-changed'), HIGHLIGHT_MS));
    }

    function resetWatch() {
      shownRows = undefined;
      for (const timer of highlightTimers.values()) clearTimeout(timer);
      highlightTimers.clear();
      for (const row of watchRows.values()) row.querySelector('dd')?.removeAttribute('data-changed');
    }

    function showClock(pie: Element | null, face: { waiting: boolean; fill: number }) {
      if (pie === null) return;
      pie.classList.toggle('waiting', face.waiting);
      const fill = pie.querySelector<SVGElement>('.fill')!;
      fill.style.strokeDasharray = `${face.fill * CLOCK_DASH} ${CLOCK_DASH}`;
    }

    /**
     * Sends a line the visitor typed or a shortcut typed for them to the sketch's serial input: the simulator's, or the
     * board's while live.
     */
    function sendToBoard(text: string) {
      if (pane.mode === 'simulator') {
        simulation.send(text);
        return;
      }
      if (pane.followed === undefined) return;
      const id = pane.followed.nextId;
      const following = pane.following;
      dispatch({ kind: 'sent', text, at: Date.now() });
      // The line shows as sent at once; one the port refuses is taken back, so the page shows only what went out.
      session.sendLine(text).catch(() => dispatch({ kind: 'refused', id, pane: following, text }));
    }

    /** Shows `text` in the command line in yellow: typed by a shortcut, or about to be sent by the slider. */
    function showTyped(text: string) {
      commandLine.value = text;
      commandLine.setAttribute('data-typing', '');
    }

    /**
     * Drops the line a shortcut is typing, unsent, when the pane changes hands: it was meant for the board or the
     * simulator the visitor saw, not for the one that takes over.
     */
    function dropTyping() {
      typist.stop();
      if (!commandLine.hasAttribute('data-typing')) return;
      commandLine.value = '';
      commandLine.removeAttribute('data-typing');
    }

    /** Empties the command line and drops the line a shortcut was typing, unsent; resets the sliders. */
    function clearCommandLine() {
      typist.stop();
      commandLine.value = '';
      commandLine.removeAttribute('data-typing');
      for (const slider of sliders) {
        const shortcut = shortcutOf(slider);
        if (shortcut?.kind !== 'slider') continue;
        slider.value = String(shortcut.initial);
        slider.nextElementSibling!.textContent = slider.value;
        seenBySlider.delete(slider);
      }
    }

    const typist = createTypist({
      show: showTyped,
      send(text) {
        commandLine.value = '';
        commandLine.removeAttribute('data-typing');
        sendToBoard(text);
      },
      reduceMotion: () => reducedMotion.matches,
    });

    // Whether the line the typist holds came from a slider, which a further move of a slider replaces.
    let heldBySlider = false;
    const sliders = [...root.querySelectorAll<HTMLInputElement>('input[type="range"][data-shortcut]')];
    // The slider under the visitor's pointer, which no value from the board moves.
    let pressedSlider: HTMLInputElement | undefined;
    // The board's value each following slider last saw, which it moves away from only when the board changes it.
    const seenBySlider = new Map<HTMLInputElement, number | undefined>();
    for (const slider of sliders) slider.addEventListener('pointerdown', () => (pressedSlider = slider));
    for (const done of ['pointerup', 'pointercancel']) window.addEventListener(done, () => (pressedSlider = undefined));
    function shortcutOf(control: HTMLElement) {
      const stepIndex = Number(control.closest<HTMLElement>('[data-for-step]')!.dataset.forStep);
      return paneProject.steps[stepIndex]?.shortcuts[Number(control.dataset.shortcut)];
    }

    command.addEventListener('submit', (event) => {
      event.preventDefault();
      // A line a shortcut is typing goes out as it would after its pause.
      if (typist.busy) return typist.finish();
      const text = commandLine.value.trim();
      commandLine.value = '';
      commandLine.removeAttribute('data-typing');
      if (text !== '') sendToBoard(text);
    });
    commandLine.addEventListener('input', () => {
      typist.stop();
      commandLine.removeAttribute('data-typing');
    });
    for (const chip of root.querySelectorAll<HTMLButtonElement>('button[data-shortcut]')) {
      chip.addEventListener('click', () => {
        const shortcut = shortcutOf(chip);
        if (shortcut?.kind !== 'chip') return;
        heldBySlider = false;
        typist.type(shortcut.text);
      });
    }
    for (const slider of sliders) {
      const line = () => {
        const shortcut = shortcutOf(slider);
        return shortcut?.kind === 'slider' ? shortcut.command(Number(slider.value)) : '';
      };
      // Dragging only shows the line; releasing sends it, so the values passed on the way never reach the board.
      slider.addEventListener('input', () => {
        // A value the slider passed on the way, as each arrow key press is, gives way to the next one unsent.
        if (heldBySlider) typist.stop();
        else typist.finish();
        slider.nextElementSibling!.textContent = slider.value;
        showTyped(line());
      });
      slider.addEventListener('change', () => {
        heldBySlider = true;
        typist.type(line(), line().length);
      });
    }

    /**
     * Hands the pane from the board to a fresh simulator, running if `running`. The simulator starts as the pane changes
     * hands, so the visitor's wish is set first.
     */
    function detach(running: boolean) {
      simulation.want(running);
      dispatch({ kind: 'detach' });
    }

    pauseButton.addEventListener('click', () => {
      if (pane.mode === 'live') return detach(false);
      simulation.toggle();
    });
    stepButton.addEventListener('click', () => {
      if (pane.mode === 'live') return detach(false);
      simulation.step();
    });
    restartButton.addEventListener('click', () => {
      if (pane.mode === 'live') return dispatch({ kind: 'detach' });
      resetWatch();
      clearCommandLine();
      simulation.restart();
    });
    slowButton.addEventListener('click', () => simulation.toggleSlow());

    const session = createSession({
      flasher: createFlasher(),
      manifest: JSON.parse(root.dataset.manifest ?? '{"sketches":{}}') as Manifest,
      sketch: paneProject.steps[0].key,
      baud: root.dataset.baud ? Number(root.dataset.baud) : undefined,
    });
    let pane: PaneState<unknown> = initialPane(paneProject, session.state);

    /** Paints the Board cell, its button and the board pane's message. */
    function showLink() {
      const status = paneStatus(paneProject, pane);
      const text = boardStatusText(status, pane.detached);
      cell.dataset.status = status.kind;
      const onBoard = status.kind === 'live' || status.kind === 'step' ? pane.heard : undefined;
      tabs.forEach((tab, at) => {
        tab.querySelector<HTMLElement>('[data-onboard]')!.hidden = paneProject.steps[at].key !== onBoard;
      });
      // Set only on a change, and in one, since the status is a live region: two would be announced twice.
      if (statusWord.textContent !== text.word || statusSentence.textContent !== `: ${text.title}`) {
        const word = statusWord.cloneNode() as HTMLElement;
        const sentence = statusSentence.cloneNode() as HTMLElement;
        word.textContent = text.word;
        sentence.textContent = `: ${text.title}`;
        statusText.replaceChildren(word, sentence);
        statusWord = word;
        statusSentence = sentence;
      }

      const action = paneAction(paneProject, pane);
      needsBrowser.hidden = action !== undefined;
      simulatorButton.setAttribute('aria-pressed', String(pane.mode === 'simulator'));
      // visibility, not hidden, so the row keeps its height.
      flashAgain.style.visibility = pane.mode === 'live' && action?.disabled === false ? '' : 'hidden';
      if (actionButton !== null && actionLabel !== null) {
        actionButton.hidden = action === undefined;
        actionButton.setAttribute('aria-pressed', String(pane.mode === 'live'));
        if (action !== undefined) {
          actionLabel.textContent = action.label;
          actionButton.dataset.icon = action.icon;
          // aria-disabled, not disabled, so a button pressed from the keyboard keeps the focus while the session works.
          if (action.disabled) actionButton.setAttribute('aria-disabled', 'true');
          else actionButton.removeAttribute('aria-disabled');
        }
      }

      const shown = boardMessage(pane.session, pane.flashed, showsRefusal(pane));
      stage.toggleAttribute('data-message', shown !== undefined);
      const words = shown?.text ?? '';
      // Only a change of text is announced: the progress bar carries the percentage.
      if (message.textContent !== words) message.textContent = words;
      message.classList.toggle('notice', shown?.notice ?? false);
      progress.hidden = shown?.progress === undefined;
      if (shown?.progress !== undefined) {
        progressBar.setAttribute('aria-valuenow', String(shown.progress));
        progressFill.style.width = `${shown.progress}%`;
        progressText.textContent = `${shown.progress}%`;
      }
    }

    session.subscribe((state) => dispatch({ kind: 'session', state }));
    session.subscribeLines(({ text, at }) => dispatch({ kind: 'line', text, at }));
    actionButton?.addEventListener('click', () => {
      const action = paneAction(paneProject, pane);
      if (action === undefined || action.disabled) return;
      press(action.event);
    });
    flashAgain.addEventListener('click', () => press('flash'));
    // The board keeps running its step; the simulator starts it again in the pane.
    simulatorButton.addEventListener('click', () => {
      if (pane.mode !== 'live') return;
      detach(true);
    });

    /** Presses the board half of the Board switch, or Flash again, then asks the session for what the press starts. */
    function press(action: BoardAction['event']) {
      dispatch({ kind: 'press', action });
      if (action === 'connect') void session.send({ type: 'connect', reset: true });
      if (action === 'flash') void session.send({ type: 'flash', key: pane.flashed });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        if (index !== pane.selected) dispatch({ kind: 'tab', index });
      });
      tab.addEventListener('keydown', (event) => {
        const next = tabAfterKey(event.key, index, tabs.length);
        if (next === undefined) return;
        event.preventDefault();
        tabs[next].focus();
        if (next !== pane.selected) dispatch({ kind: 'tab', index: next });
      });
    });

    openStep(0);
    showLink();
    draw();
  }
</script>
