---
import { wording } from '../../lib/flash';
import { elementId, type RailStep } from './rail';

interface Props {
  project: string;
  steps: readonly Pick<RailStep, 'id' | 'number' | 'idea'>[];
  /** Whether any step has an image to flash, which gives the switch its My board half. */
  flashable: boolean;
}

const { project, steps, flashable } = Astro.props;
const id = (part: string) => elementId(project, part);
---

<div class="rail">
  <div class="tabs" role="tablist" aria-label="Steps">
    {
      steps.map((step, index) => (
        <button
          class="tab"
          type="button"
          role="tab"
          id={id(`tab-${step.id}`)}
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={id('panel')}
          tabindex={index === 0 ? 0 : -1}
          data-tab={index}
        >
          <span class="n">
            {step.number} {step.id}
          </span>
          <small>{step.idea}</small>
          <span class="onboard" data-onboard hidden>
            <span aria-hidden="true">●</span> board
          </span>
        </button>
      ))
    }
  </div>
  <div class="railend">
    <div class="switch" role="group" aria-label="What the board pane shows">
      <span class="pill" aria-hidden="true"></span>
      <button class="half" type="button" aria-pressed="true" data-pane-simulator>Simulator</button>
      {
        flashable && (
          <button
            class="half board-half"
            type="button"
            aria-pressed="false"
            title="My board: not connected"
            data-pane-board
          >
            <span class="dot" data-board-dot data-link="off" aria-hidden="true" />
            My board
          </button>
        )
      }
      {/* What to do fits the My board half's slot; why is in the tooltip and read by a screen reader. */}
      <p class="needs" title={wording.NO_WEB_SERIAL} data-needs-browser hidden>
        <span class="sr">{wording.NO_WEB_SERIAL} </span>{wording.USE_CHROME_OR_EDGE}
      </p>
    </div>
  </div>
</div>

<style>
  [hidden] { display: none !important; }
  .rail { display: flex; flex-wrap: wrap; border-bottom: var(--stroke); background: var(--chrome-light); }
  /* As wide as four tabs of 150 px, so the switch wraps below the tabs before they wrap among themselves. */
  .tabs { display: flex; flex-wrap: wrap; flex: 1 1 600px; min-width: 0; }
  /* Positioned, so the on-board mark can leave the flow and appear without moving the tab's text. */
  .tab { position: relative; font: inherit; font-size: 16px; line-height: 1.5; color: var(--ink); border: 0; border-right: 1px solid var(--line); background: transparent; padding: 10px 16px; cursor: pointer; text-align: left; flex: 1 1 150px; }
  .tab .n { font-family: var(--mono); font-weight: 700; display: block; }
  .tab small { color: var(--muted); font-size: 12px; }
  .tab[aria-selected="true"] { background: var(--yellow); }
  .onboard { position: absolute; top: 6px; right: 10px; font-family: var(--mono); font-size: 11px; font-weight: 700; line-height: 1; color: var(--green-text); }
  /* Inset, since the bench clips what falls outside it. */
  .tab:focus-visible { outline: 3px solid var(--blue); outline-offset: -3px; }

  /* A fixed width, so no label moves the tabs or the switch. */
  .railend { flex: 0 0 312px; display: flex; align-items: center; justify-content: flex-end; padding: 10px; min-width: 0; }
  .switch { --half: 104px; position: relative; display: flex; height: 38px; border: 2px solid var(--ink); border-radius: 999px; overflow: hidden; background: var(--card); box-shadow: 0 3px 0 var(--ink); }
  /* Behind the halves, as wide as one, and slid under the pressed half; its ink is the pressed half's background. */
  .pill { position: absolute; top: 0; bottom: 0; left: 0; width: var(--half); background: var(--ink); transition: transform .22s ease; }
  .switch:has([data-pane-board][aria-pressed="true"]) .pill { transform: translateX(100%); }
  .half { position: relative; overflow: hidden; display: inline-flex; align-items: center; justify-content: center; gap: 6px; width: var(--half); font: inherit; font-size: 13px; font-weight: 700; line-height: 1.5; white-space: nowrap; color: var(--ink); background: transparent; border: 0; padding: 0 10px; cursor: pointer; transition: color .22s ease, background-color .22s ease; }
  /* An inset line, not a border, so both halves keep the width of the pill. */
  .board-half { box-shadow: inset 2px 0 0 var(--ink); }
  /* As wide as the note needs at its size, in a browser that has no My board half. */
  .needs { width: 164px; border-left: 2px solid var(--ink); }
  .half[aria-pressed="true"] { color: var(--card); cursor: default; }
  .half:hover:not([aria-pressed="true"]) { background: var(--wash-yellow); }
  /* Inset, since the switch clips what falls outside it. */
  .half:focus-visible { outline: 3px solid var(--blue); outline-offset: -3px; }
  /* The dot's colour is not alone: the half's title names the state, and the frame's tag says what the pane shows.
     Hollow when off, filled green when on, and pulsing while the session works. */
  .dot { width: 8px; height: 8px; flex: none; border-radius: 50%; border: 1.5px solid currentColor; transition: background-color .22s ease; }
  .dot[data-link="busy"] { background: var(--quiet); animation: pulse 1s ease-in-out infinite; }
  .dot[data-link="on"] { background: var(--green); }
  @keyframes pulse { 50% { opacity: .35; } }
  /* At phone width the switch spans the rail, and each half takes half of it. */
  @media (max-width: 480px) {
    .railend { flex-basis: 100%; }
    .switch { flex: 1; }
    .pill { width: 50%; }
    .half, .needs { flex: 1; width: auto; min-width: 0; }
  }
  .needs { position: relative; margin: 0; padding: 0 10px; align-self: center; font-size: 11px; line-height: 1.2; color: var(--muted); }
</style>
