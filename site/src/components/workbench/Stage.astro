---
import type { WorkbenchProject } from '../../lib/workbench/projects';
import FlashPicture from '../board/FlashPicture.astro';
import Led from './pictures/Led.astro';
import Servo from './pictures/Servo.astro';

interface Props {
  project: Pick<WorkbenchProject<unknown, unknown, unknown>, 'board' | 'picture'>;
  /** The key of the first step, whose watch values the stage opens with. */
  firstKey: string;
  /** Whether any step has an image to flash, which gives the My board view its button. */
  flashable: boolean;
}

const { project, firstKey, flashable } = Astro.props;
const { board, picture } = project;
const openingRows = board.watch(firstKey, board.initial(), 0);
const valueOf = (name: string) => openingRows.find((row) => row.name === name)?.value;
const Picture = { led: Led, servo: Servo }[picture];
---

<div class="stage" data-stage>
  <div class:list={['led-row', { wide: picture === 'servo' }]}>
    <Picture />
    <dl class="watch" aria-label="Watch">
      {
        board.fields.map((name) => (
          <div data-watch-row={name} hidden={valueOf(name) === undefined}>
            <dt>{name}</dt>
            <dd>{valueOf(name)}</dd>
          </div>
        ))
      }
    </dl>
  </div>
  <div class="link" data-board-link>
    <div class="words">
      <p aria-live="polite" data-board-message></p>
      <div class="progress" data-board-progress hidden>
        <FlashPicture />
      </div>
    </div>
    {
      flashable && (
        <button class="action" type="button" data-icon="plug" data-board-action>
          <svg class="i-plug" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M6 1.6v3M10 1.6v3M4 4.6h8v2.6a4 4 0 0 1-8 0zM8 11.2v3.2" />
          </svg>
          <svg class="i-bolt" viewBox="0 0 16 16" aria-hidden="true"><path d="M9.4 1 3.4 9.2h3.9L6.4 15l6.2-8.4H8.6z" /></svg>
          <span data-board-action-label>Connect my board</span>
        </button>
      )
    }
  </div>
</div>

<style>
  [hidden] { display: none !important; }
  /* The message takes the picture's place, and the stage is as tall as the taller of the two, so the reports below do
     not move. The words keep room for a notice of four lines, or a line and the progress, so the button stays put. */
  .stage { display: grid; }
  .stage > * { grid-area: 1 / 1; }
  .link { visibility: hidden; align-self: center; display: grid; gap: 8px; font-size: 14px; line-height: 1.5; }
  .words { display: grid; gap: 8px; align-content: end; min-height: calc(4 * 1.5 * 15px + 20px); }
  .stage[data-message] .led-row { visibility: hidden; }
  .stage[data-message] .link { visibility: visible; }
  .link p { margin: 0; }
  /* As wide as its longest label, Flash commands, so it keeps its width as its label changes. */
  .action { justify-self: start; display: inline-flex; align-items: center; justify-content: center; gap: 6px; width: 164px; height: 36px; font: inherit; font-size: 13px; font-weight: 700; line-height: 1.5; white-space: nowrap; color: var(--card); background: var(--coral); border: 2px solid var(--ink); border-radius: 999px; box-shadow: 0 3px 0 var(--ink); cursor: pointer; }
  .action[aria-disabled="true"] { opacity: .6; cursor: default; }
  .action:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  .action svg { width: 14px; height: 14px; flex: none; }
  .action .i-plug path { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .action .i-bolt path { fill: currentColor; }
  .action:not([data-icon="plug"]) .i-plug, .action:not([data-icon="bolt"]) .i-bolt { display: none; }
  .led-row { --picture: 96px; display: grid; grid-template-columns: var(--picture) 1fr 1fr; gap: 12px; align-items: center; }
  /* A horn and its scale need more room than an LED to read its angle and target. */
  .led-row.wide { --picture: 132px; }
  @media (max-width: 480px) { .led-row { grid-template-columns: var(--picture) 1fr; } }
  /* Across both columns, so a value such as 1000 ms (fixed) stays on one line. */
  .watch { grid-column: 2 / -1; margin: 0; border: 1px solid var(--line); border-radius: 10px; font-family: var(--mono); font-size: 13px; overflow: hidden; }
  .watch div { display: flex; justify-content: space-between; gap: 10px; padding: 3px 10px; }
  .watch div + div { border-top: 1px solid var(--line); }
  .watch dt { color: var(--muted); }
  .watch dd { margin: 0; padding: 0 4px; border-radius: 4px; font-weight: 700; white-space: nowrap; }
  .watch dd[data-changed] { background: var(--yellow); }
</style>
