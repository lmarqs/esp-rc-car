---
import type { RailStep } from './rail';
import { SERIAL_LINES } from './view';

interface Props {
  steps: readonly Pick<RailStep, 'shortcuts'>[];
  /** Shown while the command line is empty, for the first step. */
  placeholder: string;
}

const { steps, placeholder } = Astro.props;
---

<div class="term" data-terminal>
  <pre class="serial" role="log" aria-live="off" aria-label="Serial output" data-serial><span class="out">{
    Array.from({ length: SERIAL_LINES }, () => <span data-serial-line />)
  }</span></pre>
  <form class="cmd" data-command>
    <span class="prompt" aria-hidden="true">›</span>
    <input
      type="text"
      autocomplete="off"
      spellcheck="false"
      aria-label="Line to send to the board"
      placeholder={placeholder}
      data-command-line
    />
    <button class="send" type="submit">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2.2 14.5 8 2 13.8l1.6-5.1L9.5 8 3.6 7.3z" /></svg>
      Send
    </button>
  </form>
  {
    steps.map(
      (step, index) =>
        step.shortcuts.length > 0 && (
          <div class="shortcuts" role="group" aria-label="Shortcuts" data-for-step={index} data-shortcuts hidden={index !== 0}>
            {step.shortcuts.some((shortcut) => shortcut.kind === 'chip') && (
              <span class="chips">
                {step.shortcuts.map(
                  (shortcut, at) =>
                    shortcut.kind === 'chip' && (
                      <button type="button" class="chip" data-shortcut={at}>
                        {shortcut.text}
                      </button>
                    ),
                )}
              </span>
            )}
            {step.shortcuts.map(
              (shortcut, at) =>
                shortcut.kind === 'slider' && (
                  <label class="slider">
                    {shortcut.label}
                    <input
                      type="range"
                      min={shortcut.min}
                      max={shortcut.max}
                      step={shortcut.step}
                      value={shortcut.initial}
                      aria-label={`${shortcut.label} in ${shortcut.unit}`}
                      data-shortcut={at}
                    />
                    <output>{shortcut.initial}</output>
                  </label>
                ),
            )}
          </div>
        ),
    )
  }
</div>

<style>
  [hidden] { display: none !important; }
  .term { background: var(--ink); color: var(--on-ink); border-radius: 12px; font-family: var(--mono); font-size: 13px; overflow: hidden; }
  /* Six lines of 1.5em, as many as serialRows keeps, plus the padding. */
  .serial { margin: 0; padding: 10px 14px 6px; height: calc(6 * 1.5em + 16px); overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; white-space: pre; background: none; color: inherit; border-radius: 0; font-size: 13px; line-height: 1.5; }
  .serial [data-sent] { color: var(--yellow); }
  .cmd { display: flex; align-items: center; gap: 8px; padding: 0 12px 0 14px; border-top: 1px solid var(--on-ink-line); }
  .prompt { color: var(--yellow); }
  .cmd input { flex: 1; min-width: 0; padding: 8px 0; border: 0; background: transparent; color: var(--card); font: inherit; outline: none; }
  .cmd input::placeholder { color: var(--faint); }
  .cmd input[data-typing] { color: var(--yellow); }
  .cmd:has(input:focus-visible) { box-shadow: inset 0 0 0 2px var(--blue); }
  .send { display: inline-flex; align-items: center; gap: 6px; font: inherit; font-family: var(--sans); font-size: 13px; font-weight: 700; line-height: 1.5; color: var(--ink); background: var(--yellow); border: 0; border-radius: 6px; padding: 4px 12px; cursor: pointer; }
  .send svg { width: 13px; height: 13px; fill: currentColor; }
  .send:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  /* Room for the longest placeholder at phone width. */
  @media (max-width: 480px) { .send { padding: 4px 8px; } }
  .shortcuts { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 8px 12px 8px 14px; border-top: 1px solid var(--on-ink-line); background: var(--ink-raised); color: var(--on-ink); }
  .chips { display: flex; gap: 6px; }
  .chip { font: inherit; font-size: 13px; line-height: 1.5; color: var(--on-ink); background: transparent; border: 1px solid var(--on-ink-edge); border-radius: 6px; padding: 2px 10px; cursor: pointer; }
  .chip:hover { border-color: var(--yellow); color: var(--yellow); }
  .chip:focus-visible, .slider input:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .slider { display: flex; flex: 1 1 220px; align-items: center; gap: 8px; min-width: 0; }
  .slider input { flex: 1; min-width: 80px; margin: 0; accent-color: var(--yellow); }
  /* Four digits, the most the value has, so the slider keeps its length as the value changes. */
  .slider output { min-width: 4ch; text-align: right; color: var(--card); }
</style>
