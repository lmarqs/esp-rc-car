---
import { getCollection } from 'astro:content';
import Art from '../../components/Art.astro';
import FlashCard from '../../components/flash/FlashCard.astro';
import Meta from '../../components/Meta.astro';
import Base from '../../layouts/Base.astro';
import { href } from '../../lib/href';
import { chipFamilies, sketchKey } from '../../lib/flash/manifest';
import { readManifest } from '../../lib/flash/readManifest';
import { workbenchFor } from '../../lib/workbench/projects';

const manifest = readManifest();
const projects = (await getCollection('projects')).filter((p) => p.data.sketch).sort((a, b) => a.data.order - b.data.order);
// A ladder project has step definitions: its workbench flashes each step, so this page sends the visitor there.
const withImages = projects.map((project) => {
  const ladder = workbenchFor(project.id) !== undefined && project.data.steps !== undefined;
  const sketches = (ladder ? project.data.steps! : [project.data]).map((step) => sketchKey(step.sketch!));
  return { project, ladder, chips: chipFamilies(manifest, sketches) };
});
const flashable = withImages.filter(({ chips }) => chips.length > 0);
const fromComputer = withImages.filter(({ chips }) => chips.length === 0).map(({ project }) => project);
const ownCard = flashable.filter(({ ladder }) => !ladder);
---

<Base title="Flash" description="Pick a Robomania project and flash it onto your ESP board from the browser.">
  <h1>Flash</h1>
  <p class="prose">
    Plug your board in over USB, pick a project and put it on the board from this page. Flashing from the browser
    works in Chrome and Edge on a computer; each project's page has the wiring. A project built in steps opens its
    workbench instead, where each step is flashed and tried beside the code.
  </p>

  <h2>Pick a project</h2>
  {
    flashable.length > 0 ? (
      <>
        <ul class="grid picker" aria-label="Projects you can flash">
          {flashable.map(({ project, ladder, chips }) => (
            <li class="card pick-card">
              <div class="art"><Art name={project.data.art} /></div>
              <Meta level={project.data.level} state={project.data.state} />
              {ladder ? (
                <h3>{project.data.title}</h3>
              ) : (
                <h3>
                  <button class="pick" type="button" data-pick={project.id} aria-pressed="false">
                    {project.data.title}
                  </button>
                </h3>
              )}
              <p>{project.data.summary}</p>
              <ul class="chips" aria-label="Boards">
                {chips.map((chip) => <li>{chip}</li>)}
              </ul>
              {!ladder && (
                // Says what the card does; the title, the button that covers the card, carries its name.
                <span class="pick-hint" aria-hidden="true" data-pick-hint>
                  <span class="to-pick">
                    <svg viewBox="0 0 16 16"><path class="fill" d="M9.4 1 3.4 9.2h3.9L6.4 15l6.2-8.4H8.6z" /></svg>
                    Pick to flash here
                  </span>
                  <span class="picked">
                    <svg viewBox="0 0 16 16"><path d="M8 2.5v10M4 9l4 4 4-4" /></svg>
                    Flash it below
                  </span>
                </span>
              )}
              {ladder && (
                <a class="bench-link" href={href(`/projects/${project.id}/#workbench`)} data-ladder-link>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8h10M9 4l4 4-4 4" /></svg>
                  Open the workbench<span class="sr"> for {project.data.title}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
        <p class="notice" data-locked hidden>Finish or stop the current flash before picking another project.</p>
      </>
    ) : (
      <p class="prose">No project has firmware to flash from the browser in this build.</p>
    )
  }
  <noscript><p class="notice">Picking a project needs JavaScript.</p></noscript>

  {
    ownCard.map(({ project }) => (
      <section data-panel={project.id} aria-labelledby={`panel-${project.id}`} hidden>
        <h2 id={`panel-${project.id}`} tabindex="-1">{project.data.title}</h2>
        <p>
          <a href={href(`/projects/${project.id}/`)}>Wiring and details for {project.data.title}</a>
        </p>
        <FlashCard
          sketch={project.data.sketch!}
          title={project.data.title}
          baud={project.data.flash?.baud}
          next={project.data.flash?.next}
          detailsHref={href(`/projects/${project.id}/`)}
        />
      </section>
    ))
  }

  {
    fromComputer.length > 0 && (
      <section>
        <h2>Flashed from your computer</h2>
        <ul class="prose" data-from-computer>
          {fromComputer.map((p) => (
            <li>
              <a href={href(`/projects/${p.id}/`)}>{p.data.title}</a>: this board is flashed from your computer with the
              tools, not from the browser.
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .picker { list-style: none; margin: 0; padding: 0; }
  .pick-card { position: relative; }
  .pick-card:hover { transform: translateY(-3px); box-shadow: 0 6px 0 rgba(31, 45, 58, .12); }
  .pick-card:has([aria-pressed="true"]) { background: var(--tint-yellow); box-shadow: 0 6px 0 rgba(31, 45, 58, .12); }
  .pick-card:has(:disabled, [aria-disabled="true"]) { opacity: .6; transform: none; box-shadow: none; cursor: not-allowed; }
  .pick-card h3 { font-size: 1.17em; }
  /* The button is the card's title; its ::after stretches the click target over the whole card. */
  .pick { font: inherit; color: var(--ink); background: none; border: 0; padding: 0; text-align: left; cursor: pointer; }
  .pick::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius); }
  .pick:disabled { cursor: not-allowed; }
  .bench-link { align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; font-weight: 700; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .bench-link svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .bench-link::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius); }
  .bench-link[aria-disabled="true"] { cursor: not-allowed; }
  .bench-link:focus-visible { outline: none; }
  .bench-link:focus-visible::after { outline: 3px solid var(--blue); outline-offset: 3px; }
  .pick:focus-visible { outline: none; }
  .pick:focus-visible::after { outline: 3px solid var(--blue); outline-offset: 3px; }
  .pick-hint { align-self: flex-start; margin-top: 8px; font-weight: 700; color: var(--ink); }
  .pick-hint > span { display: inline-flex; align-items: center; gap: 6px; }
  .pick-hint svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .pick-hint svg .fill { fill: currentColor; stroke: none; }
  .pick-card:has([aria-pressed="true"]) .to-pick, .pick-card:not(:has([aria-pressed="true"])) .picked { display: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 6px 0 0; padding: 0; }
  .chips li { font-size: 13px; font-weight: 700; padding: 1px 10px; border: 2px solid var(--line); border-radius: 999px; }
</style>

<script>
  import { theBoard } from '../../lib/board/board';
  import { onEveryPage } from '../../lib/page';

  onEveryPage((signal) => {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
    const ladderLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-ladder-link]')];
    const locked = document.querySelector<HTMLElement>('[data-locked]');
    // The router runs this on every page; only the Flash page has picks.
    if (buttons.length === 0) return;
    let picked: string | undefined;
    let pick = new AbortController();

    function show(id: string | undefined) {
      if (id === picked) return;
      picked = id;
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.pick === id));
      for (const panel of panels) panel.hidden = panel.dataset.panel !== id;
      // The picked project's sketch is the one the visitor has open, until another pick or the page goes.
      pick.abort();
      pick = new AbortController();
      const sketch = panels.find((panel) => panel.dataset.panel === id)?.querySelector<HTMLElement>('[data-flash-card]')
        ?.dataset.sketch;
      if (sketch !== undefined) theBoard().open(sketch, AbortSignal.any([signal, pick.signal]));
    }

    function shownHeading() {
      return panels.find((panel) => panel.dataset.panel === picked)?.querySelector<HTMLElement>('h2');
    }

    function busy() {
      return panels.some((panel) => panel.querySelector('[data-busy]'));
    }

    function hashedId() {
      try {
        return decodeURIComponent(location.hash.slice(1));
      } catch {
        return undefined;
      }
    }

    function writeHash() {
      history.replaceState(null, '', picked ? `#${picked}` : location.pathname + location.search);
    }

    function fromHash() {
      if (busy()) {
        // Back and forward must not switch a card that is writing; the address goes back to the card that is shown.
        writeHash();
        return;
      }
      const id = hashedId();
      if (id !== undefined && buttons.some((button) => button.dataset.pick === id)) {
        show(id);
        shownHeading()?.scrollIntoView();
      }
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        show(button.dataset.pick);
        writeHash();
        // The card is below the whole list, so the focus goes to it: a keyboard visitor would not find it otherwise.
        const heading = shownHeading();
        heading?.focus({ preventScroll: true });
        heading?.scrollIntoView();
      });
    }

    // Following a link away would also leave a write half-done.
    for (const link of ladderLinks) {
      link.addEventListener('click', (event) => {
        if (busy()) event.preventDefault();
      });
    }

    // A visitor must not leave a write half-done by picking another project.
    const lock = new MutationObserver(() => {
      const isBusy = busy();
      for (const button of buttons) button.disabled = isBusy;
      for (const link of ladderLinks) {
        if (isBusy) link.setAttribute('aria-disabled', 'true');
        else link.removeAttribute('aria-disabled');
      }
      if (locked) locked.hidden = !isBusy;
    });
    lock.observe(document.body, { attributes: true, attributeFilter: ['data-busy'], subtree: true });
    signal.addEventListener('abort', () => lock.disconnect());

    window.addEventListener('hashchange', fromHash, { signal });
    fromHash();
  });
</script>
