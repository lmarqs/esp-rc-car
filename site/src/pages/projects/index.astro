---
import { getCollection } from 'astro:content';
import Card from '../../components/Card.astro';
import LevelFilter from '../../components/LevelFilter.astro';
import Base from '../../layouts/Base.astro';
import { href } from '../../lib/href';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projects" description="Working robotics projects, each with an example you can play with in the browser.">
  <h1>Projects</h1>
  <p class="prose">
    Each project is something that runs on a real board. Open one to play with it in the browser, see how to put it on
    your own board, and read how the code works.
  </p>
  <LevelFilter />
  <div class="grid">
    {
      projects.map((p) => (
        <Card
          to={href(`/projects/${p.id}/`)}
          title={p.data.title}
          summary={p.data.summary}
          art={p.data.art}
          level={p.data.level}
          state={p.data.state}
          extra={p.data.example ? 'Playable' : undefined}
        />
      ))
    }
  </div>
</Base>
