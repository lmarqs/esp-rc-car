---
import { getCollection } from 'astro:content';
import Art from '../components/Art.astro';
import Card from '../components/Card.astro';
import HomeCar from '../components/examples/HomeCar.astro';
import Base from '../layouts/Base.astro';
import { href } from '../lib/href';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.example)
  .sort((a, b) => a.data.order - b.data.order);
const topics = await getCollection('topics');
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const families = [
  { name: 'Electronics', art: 'bridge', text: 'Motors, H-bridges, servos, sensors and the signals between chips.' },
  { name: 'Programming', art: 'code', text: 'Sketches, the tools that build them, and talking to a robot over the web.' },
  { name: 'Control', art: 'wave', text: 'PID and kinematics: how a robot turns what it wants into what it does.' },
  { name: 'Inside the ESP32', art: 'chip', text: 'Timers, cores and the operating system under your sketch.' },
  { name: '3D models', art: 'cube', text: 'The printed parts that hold everything together.' },
];
---

<Base title="Robomania" description="A playground for robotics hobbyists: real ESP32 projects you can play with, taken apart piece by piece.">
  <section class="hero">
    <div>
      <h1>Build robots, <span class="highlight">one part at a time.</span></h1>
      <p>
        Real ESP32 projects you can play with right here, then flash onto your own board, taken apart piece by piece
        so you see why every part is there.
      </p>
      <a class="btn" href={href('/projects/blink/')}>Start with a blinking LED →</a>
    </div>
    <HomeCar />
  </section>

  <h2>Projects you can play with</h2>
  <div class="grid">
    {
      projects.map((p) => (
        <Card
          to={href(`/projects/${p.id}/`)}
          title={p.data.title}
          summary={p.data.summary}
          art={p.data.art}
          level={p.data.level}
          state={p.data.state}
        />
      ))
    }
  </div>
  <p><a href={href('/projects/')}>All projects →</a></p>

  <h2>Learn the ideas behind them</h2>
  <div class="grid">
    {
      families.map((f) => (
        <a class="card" href={href(`/learn/#${slug(f.name)}`)}>
          <div class="art">
            <Art name={f.art} />
          </div>
          <h3>{f.name}</h3>
          <p>{f.text}</p>
          <p class="count">{topics.filter((t) => t.data.family === f.name).length} topics</p>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.25fr); gap: 24px; align-items: center; padding: 24px 0 8px; }
  .hero p { font-size: 18px; max-width: 38ch; margin: 0 0 24px; }
  @media (max-width: 820px) { .hero { grid-template-columns: 1fr; } }
  .count { font-size: 13px; font-weight: 700; color: var(--ink); }
</style>
